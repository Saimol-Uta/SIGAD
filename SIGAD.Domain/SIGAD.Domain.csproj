<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain Layer debe ser agnóstico de frameworks de infraestructura -->
    <!-- EF Core y otras dependencias ORM deben estar SOLO en Infrastructure -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    
    <!-- ⚠️ DEUDA TÉCNICA: EF Core referenciado temporalmente para IApplicationDbContext -->
    <!-- TODO: Refactorizar IApplicationDbContext para usar IQueryable<> en lugar de DbSet<> -->
    <!-- Ver: AUDITORIA-MEJORAS-SOLID.md Sección 1.3 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
  </ItemGroup>

</Project> 