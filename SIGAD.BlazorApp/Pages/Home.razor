        new() { Heading = "1. Application Submitted", Status = "APPROVED", Tag = "", DocId = "Usst U3- 2021", Description = "Submitted Documents...", CanUpload = false },
        new() { Heading = "2. Document Review", Status = "IN REVIEW", Tag = "ACTION REQUIRED", DocId = "Usst UP94 2024", Description = "Submitted Documents...", CanUpload = false },
        new() { Heading = "3. Committee Evaluation", Status = "MIMEUS", Tag = "", DocId = "Usst US1 - 2021", Description = "Submitted Documents...", CanUpload = false },
        new() { Heading = "3. Committee Evaluation", Status = "APPROVED", Tag = "", DocId = "Usst US5 - 2022", Description = "Submitted Documents...", CanUpload = true },
        new() { Heading = "4. Committee Evaluation", Status = "IN REVIEW", Tag = "", DocId = "Usst UF-34 - 2012", Description = "Submitted Documents...", CanUpload = false },
        new() { Heading = "4. Committed Documents", Status = "APPROVED", Tag = "", DocId = "Usst UF3 - 2017", Description = "Submitted Documents...", CanUpload = true },
