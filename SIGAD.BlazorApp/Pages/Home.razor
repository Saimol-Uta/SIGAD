@page "/"


<h2>Promotion Progress</h2>
<p>Stage 3 of 5 – 60%</p>

<div class="progress-bar">
    <div class="progress" style="width: 60%;"></div>
</div>

<div class="card-grid">
    @foreach (var step in PromotionSteps)
    {
        <Card Step="step" />
    }
</div>

