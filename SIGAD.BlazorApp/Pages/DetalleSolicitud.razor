    private async Task DescargarDocumento(string tipoDocumento, string id)
    {
        await VisualizarDocumento(tipoDocumento, id);
    }

    private async Task VisualizarDocumento(string tipoDocumento, string id, string? titulo = null)
    {
        try
        {
            cargandoDocumento = true;
            errorDocumento = null;
            
            // Resetear el documento actual
            documentoActual = new DocumentoVisualizacion
            {
                Titulo = titulo ?? $"{ObtenerNombreTipoDocumento(tipoDocumento)} - {id}"
            };

            // Mostrar el modal
            await JSRuntime.InvokeVoidAsync("eval", @"
                var modal = new bootstrap.Modal(document.getElementById('documentModal'));
                modal.show();
            ");
            
            StateHasChanged();

            string endpoint = tipoDocumento.ToLower() switch
            {
                "articulo" => $"api/articulos/{id}/archivo",
                "investigacion" => $"api/investigaciones/{id}/descargar-informe",
                "curso" => $"api/cursos/{id}/certificado",
                "experiencia" => $"api/experienciaslaborales/{id}/archivo",
                "evaluacion" => $"api/evaluaciones/{id}/archivo",
                _ => ""
            };

            if (string.IsNullOrEmpty(endpoint))
            {
                errorDocumento = "Tipo de documento no válido.";
                return;
            }

            // Obtener el token de autenticación
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            
            // Realizar la petición
            var request = new HttpRequestMessage(HttpMethod.Get, endpoint);
            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                var contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";
                
                // Obtener el nombre del archivo
                var fileName = $"{tipoDocumento}_{id}";
                if (response.Content.Headers.ContentDisposition?.FileName != null)
                {
                    fileName = response.Content.Headers.ContentDisposition.FileName.Trim('"');
                }
                else if (contentType.Contains("pdf"))
                {
                    fileName += ".pdf";
                }
                else if (contentType.Contains("word") || contentType.Contains("document"))
                {
                    fileName += ".docx";
                }

                // Actualizar el documento actual
                documentoActual = new DocumentoVisualizacion
                {
                    Titulo = titulo ?? $"{ObtenerNombreTipoDocumento(tipoDocumento)} - {fileName}",
                    ContenidoBase64 = Convert.ToBase64String(fileBytes),
                    TipoMime = contentType,
                    NombreArchivo = fileName,
                    TamanoBytes = fileBytes.Length
                };
            }
            else
            {
                errorDocumento = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.NotFound => "Archivo no encontrado",
                    System.Net.HttpStatusCode.Unauthorized => "No autorizado para acceder a este archivo",
                    _ => $"Error del servidor: {response.StatusCode}"
                };
            }
        }
        catch (Exception ex)
        {
            errorDocumento = ex.Message;
        }
        finally
        {
            cargandoDocumento = false;
            StateHasChanged();
        }
    }

    private async Task DescargarDocumentoActual()
    {
        if (!string.IsNullOrEmpty(documentoActual.ContenidoBase64))
        {
            await JSRuntime.InvokeVoidAsync("eval", $@"
                const byteCharacters = atob('{documentoActual.ContenidoBase64}');
                const byteNumbers = new Array(byteCharacters.length);
                for (let i = 0; i < byteCharacters.length; i++) {{
                    byteNumbers[i] = byteCharacters.charCodeAt(i);
                }}
                const byteArray = new Uint8Array(byteNumbers);
                const blob = new Blob([byteArray], {{ type: '{documentoActual.TipoMime}' }});
                
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = '{documentoActual.NombreArchivo}';
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            ");
        }
    }

    private string ObtenerNombreTipoDocumento(string tipoDocumento)
    {
        return tipoDocumento.ToLower() switch
        {
            "articulo" => "Artículo Científico",
            "investigacion" => "Informe de Investigación",
            "curso" => "Certificado de Curso",
            "experiencia" => "Certificado de Experiencia",
            "evaluacion" => "Evaluación Docente",
            _ => "Documento"
        };
    }

    private string FormatearTamanoArchivo(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    public class FormularioDecision
    {
        public string? Observaciones { get; set; }
    }

    public class DocumentoVisualizacion
    {
        public string Titulo { get; set; } = "";
        public string ContenidoBase64 { get; set; } = "";
        public string TipoMime { get; set; } = "";
        public string NombreArchivo { get; set; } = "";
        public long TamanoBytes { get; set; } = 0;
    }
}

