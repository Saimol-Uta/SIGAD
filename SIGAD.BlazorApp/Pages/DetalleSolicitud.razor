@page "/admin/solicitud/{solicitudId}"
@using SIGAD.BlazorApp.Layout
@attribute [Layout(typeof(EmptyLayout))]
@using SIGAD.BlazorApp.Components
@using SIGAD.BlazorApp.Models
@using SIGAD.BlazorApp.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject ISolicitudesService SolicitudesService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="page-wrapper">
    <Encabezado />

    <div class="detalle-container">
        @if (cargando)
        {
            <div class="text-center" style="padding: 40px;">
                <div style="margin-bottom: 15px;">Cargando detalles de la solicitud...</div>
                <div class="spinner"></div>
            </div>
        }
        else if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">
                <strong>Error:</strong> @mensajeError
                <button @onclick="CargarDetalle" class="btn btn-primary ms-3">Reintentar</button>
            </div>
        }
        else if (solicitud != null)
        {
            <!-- Sección 1: Cabecera de la Solicitud -->
            <div class="cabecera-solicitud">
                <h2>Detalle de Solicitud de Ascenso</h2>
                <h4 class="text-muted">Solicitud ID: @solicitud.Id</h4>
                <div class="estado-badge">
                    Estado: <span class="badge @ObtenerClaseBadge(solicitud.Estado)">@solicitud.Estado</span>
                </div>
            </div>

            <!-- Sección 2: Información del Docente y la Solicitud -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Información del Docente y la Solicitud</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Nombre del Docente:</strong> @solicitud.DocenteNombreCompleto</p>
                            <p><strong>Cédula:</strong> @solicitud.DocenteCedula</p>
                            <p><strong>Rango Actual:</strong> @(solicitud.RangoActualNombre ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Rango Solicitado:</strong> @solicitud.RangoSolicitadoNombre</p>
                            <p><strong>Fecha de Envío:</strong> @(solicitud.FechaEnvio?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                            <p><strong>Fecha de Creación:</strong> @solicitud.FechaCreacion.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección 2.5: Estados de Aprobación según Reglamento UTA -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-clipboard-check"></i> Estados de Aprobación
                        <small class="text-muted">- Reglamento UTA</small>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="aprobacion-step">
                                <div class="step-header">
                                    @if (solicitud.AprobadoPorComision)
                                    {
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                        <span class="badge bg-success">Aprobado por Comisión</span>
                                    }
                                    else
                                    {
                                        <i class="far fa-circle text-muted me-2"></i>
                                        <span class="badge bg-secondary">Pendiente Comisión</span>
                                    }
                                </div>
                                @if (solicitud.FechaAprobacionComision.HasValue)
                                {
                                    <small class="text-muted d-block mt-1">
                                        Fecha: @solicitud.FechaAprobacionComision.Value.ToString("dd/MM/yyyy")
                                    </small>
                                }
                                @if (!string.IsNullOrEmpty(solicitud.ObservacionesComision))
                                {
                                    <div class="observaciones-box mt-2">
                                        <strong>Observaciones Comisión:</strong>
                                        <p class="mb-0">@solicitud.ObservacionesComision</p>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="aprobacion-step">
                                <div class="step-header">
                                    @if (solicitud.AprobadoPorConsejo)
                                    {
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                        <span class="badge bg-success">Aprobado por Consejo Universitario</span>
                                    }
                                    else if (solicitud.AprobadoPorComision)
                                    {
                                        <i class="far fa-clock text-warning me-2"></i>
                                        <span class="badge bg-warning">En revisión Consejo</span>
                                    }
                                    else
                                    {
                                        <i class="far fa-circle text-muted me-2"></i>
                                        <span class="badge bg-secondary">Pendiente Consejo</span>
                                    }
                                </div>
                                @if (solicitud.FechaAprobacionConsejo.HasValue)
                                {
                                    <small class="text-muted d-block mt-1">
                                        Fecha: @solicitud.FechaAprobacionConsejo.Value.ToString("dd/MM/yyyy")
                                    </small>
                                }
                                @if (!string.IsNullOrEmpty(solicitud.ObservacionesConsejo))
                                {
                                    <div class="observaciones-box mt-2">
                                        <strong>Observaciones Consejo:</strong>
                                        <p class="mb-0">@solicitud.ObservacionesConsejo</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <!-- Flujo visual del proceso -->
                    <div class="proceso-flujo mt-4">
                        <div class="flujo-steps">
                            <div class="step @(solicitud.FechaEnvio.HasValue ? "completed" : "pending")">
                                <div class="step-circle">
                                    <i class="fas fa-paper-plane"></i>
                                </div>
                                <span>Enviada</span>
                            </div>
                            
                            <div class="step-connector @(solicitud.AprobadoPorComision ? "completed" : "pending")"></div>
                            
                            <div class="step @(solicitud.AprobadoPorComision ? "completed" : solicitud.FechaEnvio.HasValue ? "current" : "pending")">
                                <div class="step-circle">
                                    <i class="fas fa-users"></i>
                                </div>
                                <span>Comisión</span>
                            </div>
                            
                            <div class="step-connector @(solicitud.AprobadoPorConsejo ? "completed" : "pending")"></div>
                            
                            <div class="step @(solicitud.AprobadoPorConsejo ? "completed" : solicitud.AprobadoPorComision ? "current" : "pending")">
                                <div class="step-circle">
                                    <i class="fas fa-university"></i>
                                </div>
                                <span>Consejo</span>
                            </div>
                            
                            <div class="step-connector @(solicitud.Estado == "Aprobada" ? "completed" : "pending")"></div>
                            
                            <div class="step @(solicitud.Estado == "Aprobada" ? "completed" : solicitud.AprobadoPorConsejo ? "current" : "pending")">
                                <div class="step-circle">
                                    <i class="fas fa-certificate"></i>
                                </div>
                                <span>Finalizada</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección 3: Evidencia Presentada por el Docente -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Evidencia Adjunta a la Solicitud</h5>
                </div>
                <div class="card-body">
                    <div class="accordion" id="evidenciaAccordion">
                          <!-- Sub-sección de Artículos -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="articulosHeader">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#articulosCollapse" aria-expanded="true" aria-controls="articulosCollapse">
                                    Artículos Presentados (@solicitud.ArticulosPresentados.Count)
                                </button>
                            </h2>
                            <div id="articulosCollapse" class="accordion-collapse collapse show" data-bs-parent="#evidenciaAccordion">
                                <div class="accordion-body">
                                    @if (solicitud.ArticulosPresentados.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>DOI</th>
                                                        <th>Título</th>
                                                        <th>Revista</th>
                                                        <th>Año</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var articulo in solicitud.ArticulosPresentados)
                                                    {
                                                        <tr>
                                                            <td>@articulo.DOI</td>
                                                            <td>@articulo.Titulo</td>
                                                            <td>@articulo.Revista</td>
                                                            <td>@articulo.AnioPublicacion</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(articulo.DOI))
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm" @onclick="@(() => VisualizarDocumento("articulo", articulo.DOI, articulo.Titulo))">
                                                                        <i class="fas fa-eye"></i> Ver Documento
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">Sin archivo</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No se presentaron artículos en esta solicitud.</p>
                                    }
                                </div>
                            </div>
                        </div>                        <!-- Sub-sección de Investigaciones -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="investigacionesHeader">                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#investigacionesCollapse" aria-expanded="true" aria-controls="investigacionesCollapse">
                                    Investigaciones Presentadas (@solicitud.InvestigacionesPresentadas.Count)
                                </button>
                            </h2>
                            <div id="investigacionesCollapse" class="accordion-collapse collapse show" data-bs-parent="#evidenciaAccordion">
                                <div class="accordion-body">
                                    @if (solicitud.InvestigacionesPresentadas.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Título</th>
                                                        <th>Rol en la Investigación</th>
                                                        <th>Fecha de Finalización</th>
                                                        <th>Meses Aportados</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var investigacion in solicitud.InvestigacionesPresentadas)
                                                    {
                                                        <tr>
                                                            <td>@investigacion.Titulo</td>
                                                            <td>@investigacion.RolEnInvestigacion</td>
                                                            <td>@investigacion.FechaFinalizacion.ToString("dd/MM/yyyy")</td>
                                                            <td>@investigacion.MesesDeInvestigacion</td>
                                                            <td>
                                                                <button class="btn btn-outline-primary btn-sm" @onclick="@(() => VisualizarDocumento("investigacion", investigacion.Id.ToString(), investigacion.Titulo))">
                                                                    <i class="fas fa-eye"></i> Ver Informe
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No se presentaron investigaciones en esta solicitud.</p>
                                    }
                                </div>
                            </div>
                        </div>                        <!-- Sub-sección de Cursos -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="cursosHeader">                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cursosCollapse" aria-expanded="true" aria-controls="cursosCollapse">
                                    Cursos de Capacitación (@solicitud.CursosPresentados.Count)
                                </button>
                            </h2>
                            <div id="cursosCollapse" class="accordion-collapse collapse show" data-bs-parent="#evidenciaAccordion">
                                <div class="accordion-body">
                                    @if (solicitud.CursosPresentados.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Nombre del Curso</th>
                                                        <th>Institución</th>
                                                        <th>Número de Horas</th>
                                                        <th>Fecha de Finalización</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var curso in solicitud.CursosPresentados)
                                                    {
                                                        <tr>
                                                            <td>@curso.Nombre</td>
                                                            <td>@curso.NombreOrganizacion</td>
                                                            <td>@curso.NumeroHoras</td>
                                                            <td>@curso.FechaFinalizacion.ToString("dd/MM/yyyy")</td>
                                                            <td>
                                                                <button class="btn btn-outline-primary btn-sm" @onclick="@(() => VisualizarDocumento("curso", curso.Id.ToString(), curso.Nombre))">
                                                                    <i class="fas fa-eye"></i> Ver Certificado
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No se presentaron cursos en esta solicitud.</p>
                                    }
                                </div>
                            </div>
                        </div>                        <!-- Sub-sección de Experiencia Laboral -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="experienciasHeader">                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#experienciasCollapse" aria-expanded="true" aria-controls="experienciasCollapse">
                                    Experiencia Laboral (@solicitud.ExperienciasLaborales.Count)
                                </button>
                            </h2>
                            <div id="experienciasCollapse" class="accordion-collapse collapse show" data-bs-parent="#evidenciaAccordion">
                                <div class="accordion-body">
                                    @if (solicitud.ExperienciasLaborales.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Organización</th>
                                                        <th>Tipo de Organización</th>
                                                        <th>Cargo</th>
                                                        <th>Fecha Inicio</th>
                                                        <th>Fecha Fin</th>
                                                        <th>Duración</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var experiencia in solicitud.ExperienciasLaborales)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <strong>@experiencia.OrganizacionNombre</strong>
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-info text-dark">@experiencia.OrganizacionTipo</span>
                                                            </td>
                                                            <td>@experiencia.Cargo</td>
                                                            <td>@experiencia.FechaInicio.ToString("MM/yyyy")</td>
                                                            <td>
                                                                @if (experiencia.FechaFin.HasValue)
                                                                {
                                                                    @experiencia.FechaFin.Value.ToString("MM/yyyy")
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-success">Actual</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @{
                                                                    var fechaFin = experiencia.FechaFin ?? DateTime.Now;
                                                                    var meses = ((fechaFin.Year - experiencia.FechaInicio.Year) * 12) + fechaFin.Month - experiencia.FechaInicio.Month;
                                                                    var años = meses / 12;
                                                                    var mesesRestantes = meses % 12;
                                                                }
                                                                @if (años > 0)
                                                                {
                                                                    <span>@años año@(años > 1 ? "s" : "")</span>
                                                                    @if (mesesRestantes > 0)
                                                                    {
                                                                        <span>, @mesesRestantes mes@(mesesRestantes > 1 ? "es" : "")</span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span>@meses mes@(meses > 1 ? "es" : "")</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (experiencia.TieneCertificado)
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm" @onclick="@(() => VisualizarDocumento("experiencia", experiencia.Id.ToString(), $"Certificado - {experiencia.OrganizacionNombre}"))">
                                                                        <i class="fas fa-eye"></i> Ver Certificado
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">Sin certificado</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No se presentó experiencia laboral en esta solicitud.</p>
                                    }
                                </div>
                            </div>
                        </div>                        <!-- Sub-sección de Evaluaciones Docentes -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="evaluacionesHeader">                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#evaluacionesCollapse" aria-expanded="true" aria-controls="evaluacionesCollapse">
                                    Evaluaciones Docentes (@solicitud.EvaluacionesDocente.Count)
                                </button>
                            </h2>
                            <div id="evaluacionesCollapse" class="accordion-collapse collapse show" data-bs-parent="#evidenciaAccordion">
                                <div class="accordion-body">
                                    @if (solicitud.EvaluacionesDocente.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Período Académico</th>
                                                        <th>Fecha de Evaluación</th>
                                                        <th>Puntaje</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var evaluacion in solicitud.EvaluacionesDocente)
                                                    {
                                                        <tr>
                                                            <td>@evaluacion.PeriodoAcademico</td>
                                                            <td>@evaluacion.FechaEvaluacion.ToString("dd/MM/yyyy")</td>
                                                            <td>
                                                                <span class="badge @(evaluacion.PuntajePorcentual >= 80 ? "bg-success" : evaluacion.PuntajePorcentual >= 60 ? "bg-warning" : "bg-danger")">
                                                                    @evaluacion.PuntajeFormateado
                                                                </span>
                                                            </td>
                                                            <td>
                                                                @if (evaluacion.TieneInforme)
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm" @onclick="@(() => VisualizarDocumento("evaluacion", evaluacion.Id.ToString(), $"Evaluación - {evaluacion.PeriodoAcademico}"))">
                                                                        <i class="fas fa-eye"></i> Ver Informe
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">Sin informe</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No se presentaron evaluaciones docentes en esta solicitud.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección 4: Zona de Acción del Administrador -->
            @if (solicitud.Estado != "Aprobada" && solicitud.Estado != "Rechazada")
            {
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-gavel"></i> 
                            @if (!solicitud.AprobadoPorComision)
                            {
                                <span>Decisión de la Comisión</span>
                            }
                            else if (!solicitud.AprobadoPorConsejo)
                            {
                                <span>Decisión del Consejo Universitario</span>
                            }
                            else
                            {
                                <span>Finalizar Proceso</span>
                            }
                        </h5>
                        @if (!solicitud.AprobadoPorComision)
                        {
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> La solicitud debe ser aprobada primero por la Comisión según el Reglamento UTA
                            </small>
                        }
                        else if (!solicitud.AprobadoPorConsejo)
                        {
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> La solicitud ya fue aprobada por la Comisión, ahora requiere aprobación del Consejo Universitario
                            </small>
                        }
                    </div>
                    <div class="card-body">
                        <EditForm Model="@formularioDecision" OnValidSubmit="@ProcesarDecision">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-3">
                                <label for="observaciones" class="form-label">
                                    Observaciones / Justificación: 
                                    <span class="text-danger">*</span>
                                    <small class="text-muted">(Obligatorio para rechazar)</small>
                                </label>
                                <InputTextArea @bind-Value="formularioDecision.Observaciones" 
                                               class="@($"form-control {GetTextAreaClass()}")" 
                                               id="observaciones" rows="4" 
                                               placeholder="Escriba aquí sus observaciones o justificación para la decisión..." 
                                               @oninput="StateHasChanged" />
                                <ValidationMessage For="@(() => formularioDecision.Observaciones)" />
                                <div class="form-text d-flex justify-content-between">
                                    <span>Mínimo 10 caracteres. Para rechazos, debe explicar claramente los motivos de la decisión.</span>
                                    <span class="@($"{GetCharCountClass()}")">
                                        @(formularioDecision.Observaciones?.Trim().Length ?? 0) caracteres
                                    </span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(formularioDecision.Observaciones) && formularioDecision.Observaciones.Trim().Length < 10)
                            {
                                <div class="alert alert-warning alert-sm">
                                    ⚠️ <strong>Justificación insuficiente:</strong> Se requieren al menos 10 caracteres para rechazar una solicitud.
                                    <small class="d-block">Caracteres actuales: @(formularioDecision.Observaciones?.Trim().Length ?? 0)</small>
                                </div>
                            }

                            <div class="d-flex gap-3 justify-content-center">
                                @if (!solicitud.AprobadoPorComision)
                                {
                                    <button type="button" @onclick="@(() => AprobarPorComision())" class="btn btn-success btn-lg" disabled="@procesando">
                                        @if (procesando && accionSeleccionada == "aprobar_comision")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-check"></i> Aprobar por Comisión
                                    </button>
                                    
                                    <button type="button" @onclick="@(() => RechazarSolicitud())" 
                                            class="btn btn-danger btn-lg" 
                                            disabled="@(procesando || string.IsNullOrWhiteSpace(formularioDecision.Observaciones) || formularioDecision.Observaciones.Trim().Length < 10)">
                                        @if (procesando && accionSeleccionada == "rechazar")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-times"></i> Rechazar en Comisión
                                        @if (string.IsNullOrWhiteSpace(formularioDecision.Observaciones) || (formularioDecision.Observaciones?.Trim().Length ?? 0) < 10)
                                        {
                                            <small class="d-block">*Justificación requerida</small>
                                        }
                                    </button>
                                }
                                else if (!solicitud.AprobadoPorConsejo)
                                {
                                    <button type="button" @onclick="@(() => AprobarPorConsejo())" class="btn btn-success btn-lg" disabled="@procesando">
                                        @if (procesando && accionSeleccionada == "aprobar_consejo")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-university"></i> Aprobar por Consejo Universitario
                                    </button>
                                    
                                    <button type="button" @onclick="@(() => RechazarSolicitud())" 
                                            class="btn btn-danger btn-lg" 
                                            disabled="@(procesando || string.IsNullOrWhiteSpace(formularioDecision.Observaciones) || formularioDecision.Observaciones.Trim().Length < 10)">
                                        @if (procesando && accionSeleccionada == "rechazar")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-times"></i> Rechazar en Consejo
                                        @if (string.IsNullOrWhiteSpace(formularioDecision.Observaciones) || (formularioDecision.Observaciones?.Trim().Length ?? 0) < 10)
                                        {
                                            <small class="d-block">*Justificación requerida</small>
                                        }
                                    </button>
                                }
                                else
                                {
                                    <button type="button" @onclick="@(() => FinalizarProceso())" class="btn btn-primary btn-lg" disabled="@procesando">
                                        @if (procesando && accionSeleccionada == "finalizar")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-certificate"></i> Finalizar Proceso de Ascenso
                                    </button>
                                }
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-flag-checkered"></i> Proceso Completado
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Estado Final:</strong> <span class="badge @ObtenerClaseBadge(solicitud.Estado)">@solicitud.Estado</span></p>
                                @if (solicitud.FechaResolucion.HasValue)
                                {
                                    <p><strong>Fecha de Resolución:</strong> @solicitud.FechaResolucion.Value.ToString("dd/MM/yyyy")</p>
                                }
                            </div>
                            <div class="col-md-6">
                                @if (solicitud.AprobadoPorComision && solicitud.AprobadoPorConsejo)
                                {
                                    <div class="alert alert-success">
                                        <i class="fas fa-trophy"></i> <strong>¡Ascenso Aprobado!</strong>
                                        <br><small>Aprobado por Comisión y Consejo Universitario</small>
                                    </div>
                                }
                                else if (solicitud.Estado == "Rechazada")
                                {
                                    <div class="alert alert-danger">
                                        <i class="fas fa-times-circle"></i> <strong>Solicitud Rechazada</strong>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(solicitud.ObservacionesAdmin))
                        {
                            <div class="mt-3">
                                <p><strong>Observaciones Generales:</strong></p>
                                <div class="alert alert-info">@solicitud.ObservacionesAdmin</div>
                            </div>
                        }
                        
                        @if (solicitud.Estado == "Aprobada")
                        {
                            <div class="mt-3 text-center">
                                <button class="btn btn-outline-primary" @onclick="GenerarConstancia">
                                    <i class="fas fa-certificate"></i> Generar Constancia de Ascenso
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Botón de regreso -->
            <div class="text-center mb-4">
                <button @onclick="VolverAlDashboard" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver al Dashboard
                </button>
            </div>
        }
    </div>
</div>

<!-- Modal para visualización de documentos -->
<div class="modal fade" id="documentModal" tabindex="-1" aria-labelledby="documentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentModalLabel">
                    <i class="fas fa-file-alt"></i> @documentoActual.Titulo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                @if (cargandoDocumento)
                {
                    <div class="text-center p-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando documento...</span>
                        </div>
                        <div class="mt-3">Cargando documento...</div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(errorDocumento))
                {
                    <div class="alert alert-danger m-3">
                        <i class="fas fa-exclamation-triangle"></i> 
                        <strong>Error al cargar el documento:</strong> @errorDocumento
                    </div>
                }
                else if (!string.IsNullOrEmpty(documentoActual.ContenidoBase64))
                {
                    <div class="document-preview">
                        @if (documentoActual.TipoMime.Contains("pdf"))
                        {
                            <!-- Visualización de PDF -->
                            <div style="height: 70vh;">
                                <embed src="data:application/pdf;base64,@documentoActual.ContenidoBase64" 
                                       type="application/pdf" 
                                       width="100%" 
                                       height="100%"
                                       style="border: none;" />
                            </div>
                            <div class="alert alert-info m-3">
                                <i class="fas fa-info-circle"></i> 
                                Si no se muestra el PDF correctamente, puede 
                                <button class="btn btn-link p-0" @onclick="() => DescargarDocumentoActual()">descargarlo aquí</button>.
                            </div>
                        }
                        else if (documentoActual.TipoMime.Contains("image"))
                        {
                            <!-- Visualización de imágenes -->
                            <div class="text-center p-3">
                                <img src="data:@documentoActual.TipoMime;base64,@documentoActual.ContenidoBase64" 
                                     class="img-fluid" 
                                     style="max-height: 70vh;" 
                                     alt="Documento" />
                            </div>
                        }
                        else if (documentoActual.TipoMime.Contains("text"))
                        {
                            <!-- Visualización de texto plano -->
                            <div class="p-3">
                                <pre style="white-space: pre-wrap; font-family: Arial, sans-serif;">@System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(documentoActual.ContenidoBase64))</pre>
                            </div>
                        }
                        else
                        {
                            <!-- Tipo de archivo no compatible para vista previa -->
                            <div class="alert alert-warning m-3">
                                <i class="fas fa-eye-slash"></i> 
                                <strong>Vista previa no disponible</strong> para este tipo de archivo (@documentoActual.TipoMime).
                                <br>
                                <button class="btn btn-primary mt-2" @onclick="() => DescargarDocumentoActual()">
                                    <i class="fas fa-download"></i> Descargar documento
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <div class="me-auto">
                    <small class="text-muted">
                        <i class="fas fa-info-circle"></i> 
                        Tipo: @documentoActual.TipoMime | Tamaño: @(FormatearTamanoArchivo(documentoActual.TamanoBytes))
                    </small>
                </div>
                <button type="button" class="btn btn-outline-primary" @onclick="() => DescargarDocumentoActual()">
                    <i class="fas fa-download"></i> Descargar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

