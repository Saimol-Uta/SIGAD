                    // Debug: Verificar el estado después de recargar
                    await JSRuntime.InvokeVoidAsync("console.log", $"Estado después de recargar: AprobadoPorComision={solicitud?.AprobadoPorComision}");
                    
                    // Limpiar el formulario
                    formularioDecision.Observaciones = "";
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"❌ {resultado.message}");
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"❌ Error inesperado: {ex.Message}");
        }
        finally
        {
            procesando = false;
            accionSeleccionada = "";
            StateHasChanged();
        }
