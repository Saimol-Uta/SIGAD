    private async Task ProcesarDecisionInterna(string accion)
    {
        try
        {
            procesando = true;
            accionSeleccionada = accion;
            StateHasChanged();

            if (Guid.TryParse(SolicitudId, out var guid))
            {
                (bool success, string message) resultado = (false, "");
                
                switch (accion)
                {
                    case "aprobar_comision":
                        resultado = await SolicitudesService.AprobarPorComisionAsync(guid, formularioDecision.Observaciones ?? "");
                        break;
                    case "aprobar_consejo":
                        resultado = await SolicitudesService.AprobarPorConsejoAsync(guid, formularioDecision.Observaciones ?? "");
                        break;
                    case "finalizar":
                        resultado = await SolicitudesService.FinalizarProcesoAsync(guid, formularioDecision.Observaciones ?? "");
                        break;
                    case "aprobar":
                        resultado = await SolicitudesService.AprobarSolicitudAsync(guid, formularioDecision.Observaciones ?? "");
                        break;
                    case "rechazar":
                        resultado = await SolicitudesService.RechazarSolicitudAsync(guid, formularioDecision.Observaciones ?? "");
                        break;
                }

                if (resultado.success)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"✅ {resultado.message}");
                    
                    // Debug: Verificar el estado antes de recargar
                    await JSRuntime.InvokeVoidAsync("console.log", $"Estado antes de recargar: AprobadoPorComision={solicitud?.AprobadoPorComision}");
                    
                    // Dar tiempo a la base de datos para procesar la actualización
