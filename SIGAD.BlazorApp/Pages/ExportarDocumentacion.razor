@page "/exportar-documento/{Seccion}"

@code {
    [Parameter]
    public string Seccion { get; set; } = "";

    private string Titulo => Seccion.Replace("-", " ").ToUpperInvariant();

    private string NombreExportacion { get; set; } = "";
    private DateTime Fecha { get; set; } = DateTime.Today;
}

<h3>Exportar Documento - @Titulo</h3>

<div class="form-group">
    <label>Nombre del documento</label>
    <input class="form-control" @bind="NombreExportacion" placeholder="Ej. Reporte Evaluación 2025" />
</div>

<div class="form-group mt-2">
    <label>Fecha</label>
    <input type="date" class="form-control" @bind="Fecha" />
</div>

<button class="btn btn-success mt-3" @onclick="ExportarPDF">
    Confirmar y Exportar PDF
</button>

@code {
    void ExportarPDF()
    {
        // Aquí colocarías la lógica real de exportación o navegación
        Console.WriteLine($"Exportando PDF '{NombreExportacion}' de la sección '{Seccion}' con fecha {Fecha.ToShortDateString()}");
        // Ej: llamada a backend, generación de PDF, etc.
    }
}
