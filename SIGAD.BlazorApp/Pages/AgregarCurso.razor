@page "/agregar-curso"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "DOCENTE")]
@using SIGAD.BlazorApp.Layout
@using SIGAD.BlazorApp.Services
@attribute [Layout(typeof(EmptyLayout))]
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject ISolicitudService SolicitudService

<PageTitle>Agregar Curso - SIGAD</PageTitle>



<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
        background-color: #fff;
        color: #86011c;
        height: 100%;
        overflow-x: hidden;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 1;
    }

    .branding {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header img.logo {
        height: 80px;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: #444;
    }

        .user-profile img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid #86011c;
            object-fit: cover;
        }

    .main-content {
        display: flex;
        justify-content: center;
        padding: 2rem;
        min-height: calc(100vh - 120px);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 4px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .btn-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }

    .alert {
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 1rem;
    }

    .alert-danger {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #721c24;
    }

    .alert-success {
        background-color: #d1e7dd;
        border: 1px solid #a3cfbb;
        color: #0f5132;
    }

    .triangle-bg {
        position: fixed;
        bottom: 0;
        right: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
        opacity: 0.1;
    }

    .required {
        color: #dc3545;
    }
</style>

<body>
    <header class="header">
        <div class="branding">
            <img src="/images/Sena_Colombia_logo.png" alt="SENA Logo" class="logo" />
        </div>
        <div class="user-profile">
            <img src="/images/IconoUser.png" alt="User Avatar" />
            <span>@nombreUsuario</span>
            <button class="back-btn" @onclick="@(() => Navigation.NavigateTo("/gestion-documentos"))">
                Volver
            </button>
            <button class="logout-btn" @onclick="Logout">
                Cerrar Sesión
            </button>
        </div>
    </header>

    <div class="main-content">
        <div class="form-container">
            <h1>🎓 Agregar Curso</h1>
            <p class="subtitle">Complete la información del curso para incluirlo en su solicitud de ascenso</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            @if (cursoCreado)
            {
                <div class="alert alert-success">
                    ✅ Curso agregado exitosamente. Redirigiendo...
                </div>
            }
            else
            {
                <EditForm Model="@cursoModel" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">¿Tipo de curso? <span class="required">*</span></label>
                        <InputRadioGroup @bind-Value="cursoModel.ImpartidoPorDocente">
                            <InputRadio Value="false" /> Recibido
                            <InputRadio Value="true" /> Impartido (dictado por usted)
                        </InputRadioGroup>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            Nombre del Curso <span class="required">*</span>
                        </label>
                        <InputText @bind-Value="cursoModel.Nombre" class="form-control" 
                                 placeholder="Ej: Desarrollo de Software con .NET" />
                        <ValidationMessage For="@(() => cursoModel.Nombre)" />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                Fecha de Inicio <span class="required">*</span>
                            </label>
                            <InputDate @bind-Value="cursoModel.FechaInicio" class="form-control" />
                            <ValidationMessage For="@(() => cursoModel.FechaInicio)" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Fecha de Finalización <span class="required">*</span>
                            </label>
                            <InputDate @bind-Value="cursoModel.FechaFinalizacion" class="form-control" />
                            <ValidationMessage For="@(() => cursoModel.FechaFinalizacion)" />
                        </div>
                    </div>

                    <div class="form-row">
                        @if (!cursoModel.ImpartidoPorDocente)
                        {
                            <div class="form-group">
                                <label class="form-label">
                                    Horas Académicas <span class="required">*</span>
                                </label>
                                <InputNumber @bind-Value="cursoModel.HorasAcademicas" class="form-control" 
                                           placeholder="Ej: 40" min="1" max="1000" />
                                <ValidationMessage For="@(() => cursoModel.HorasAcademicas)" />
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label class="form-label">
                                    Horas Impartidas por usted <span class="required">*</span>
                                </label>
                                <InputNumber @bind-Value="cursoModel.HorasImpartidas" class="form-control" placeholder="Ej: 20" min="1" max="1000" />
                                <ValidationMessage For="@(() => cursoModel.HorasImpartidas)" />
                            </div>
                        }
                        <div class="form-group">
                            <label class="form-label">
                                Organización <span class="required">*</span>
                            </label>
                            <InputText @bind-Value="cursoModel.OrganizacionNombre" class="form-control" 
                                     placeholder="Ej: SENA, Universidad Nacional" />
                            <ValidationMessage For="@(() => cursoModel.OrganizacionNombre)" />
                        </div>
                    </div>

                    @if (cursoModel.ImpartidoPorDocente)
                    {
                        <div class="form-group">
                            <label class="form-label">Certificado de facilitador <span class="required">*</span></label>
                            <InputFile OnChange="@OnFileSelected" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                            @if (!string.IsNullOrEmpty(archivoSeleccionado))
                            {
                                <p>Archivo: @archivoSeleccionado</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label class="form-label">Certificado de aprobación <span class="required">*</span></label>
                            <InputFile OnChange="@OnFileSelected" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                            @if (!string.IsNullOrEmpty(archivoSeleccionado))
                            {
                                <p>Archivo: @archivoSeleccionado</p>
                            }
                        </div>
                    }

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" 
                                @onclick="@(() => Navigation.NavigateTo("/gestion-documentos"))">
                            Cancelar
                        </button>
                        <button type="submit" class="btn-primary-agr" disabled="@(enviandoFormulario || archivoFormulario == null)">
                            @if (enviandoFormulario)
                            {
                                <span>Guardando curso...</span>
                            }
                            else
                            {
                                <span>💾 Guardar Curso</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>

    <img src="/images/triangulos.jpg" alt="Background Graphic" class="triangle-bg" />
</body>

@code {
    // Variables para información del usuario
    private string nombreUsuario = "";

    // Variables para el formulario
    private CursoModel cursoModel = new();
    private IBrowserFile? archivoFormulario;
    private string archivoSeleccionado = "";

    // Variables de estado
    private bool enviandoFormulario = false;
    private bool cursoCreado = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarInformacionUsuario();
        await VerificarSolicitudActiva();
    }

    private async Task VerificarSolicitudActiva()
    {
        var solicitudId = await SolicitudService.GetSolicitudActualAsync();
        if (string.IsNullOrEmpty(solicitudId))
        {
            errorMessage = "No hay una solicitud de ascenso activa. Debe iniciar un proceso de ascenso primero.";
            await Task.Delay(3000);
            Navigation.NavigateTo("/iniciar-solicitud-ascenso");
        }
    }

    private async Task CargarInformacionUsuario()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var response = await Http.GetAsync("api/auth/verify");
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<VerifyTokenResponse>();
                    if (result?.Success == true && result.Data != null)
                    {
                        nombreUsuario = $"{result.Data.Nombre1} {result.Data.Apellido1}";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar información del usuario: " + ex.Message;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        archivoFormulario = e.File;
        archivoSeleccionado = e.File.Name;
        
        // Validar tamaño del archivo (25MB)
        if (archivoFormulario.Size > 25 * 1024 * 1024)
        {
            errorMessage = "El archivo es demasiado grande. Máximo permitido: 25MB";
            archivoFormulario = null;
            archivoSeleccionado = "";
            return;
        }

        // Validar extensión
        var extension = Path.GetExtension(archivoFormulario.Name).ToLower();
        var extensionesPermitidas = new[] { ".pdf", ".doc", ".docx", ".jpg", ".jpeg", ".png" };
        
        if (!extensionesPermitidas.Contains(extension))
        {
            errorMessage = "Formato de archivo no permitido. Use: PDF, DOC, DOCX, JPG o PNG";
            archivoFormulario = null;
            archivoSeleccionado = "";
            return;
        }

        errorMessage = null;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (enviandoFormulario || archivoFormulario == null) return;

        enviandoFormulario = true;
        errorMessage = null;

        try
        {
            // Obtener cédula del usuario actual
            var cedula = await ObtenerCedulaUsuario();
            if (string.IsNullOrEmpty(cedula))
            {
                errorMessage = "No se pudo obtener la información del usuario";
                return;
            }

            // Obtener el ID real de la solicitud activa
            var solicitudIdString = await SolicitudService.GetSolicitudActualAsync();
            if (string.IsNullOrEmpty(solicitudIdString))
            {
                errorMessage = "No hay una solicitud de ascenso activa. Redirigiendo...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/iniciar-solicitud-ascenso");
                return;
            }

            // Crear el formulario multipart
            using var content = new MultipartFormDataContent();
            
            // Campos requeridos por CrearCursoDto
            content.Add(new StringContent(cursoModel.Nombre), "Nombre");
            content.Add(new StringContent(cursoModel.OrganizacionNombre), "OrganizacionNombre");
            content.Add(new StringContent(cursoModel.HorasAcademicas.ToString()), "NumeroHoras");
            content.Add(new StringContent(cursoModel.FechaFinalizacion.ToString("yyyy-MM-ddTHH:mm:ss")), "FechaFinalizacion");
            content.Add(new StringContent(cedula), "DocenteCedula");
            content.Add(new StringContent(solicitudIdString), "SolicitudId");
            content.Add(new StringContent((cursoModel.HorasImpartidas ?? 0).ToString()), "HorasImpartidas"); // Nuevo campo
            content.Add(new StringContent(cursoModel.ImpartidoPorDocente.ToString()), "ImpartidoPorDocente"); // Nuevo campo

            // Agregar el archivo
            var fileContent = new StreamContent(archivoFormulario.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(archivoFormulario.ContentType);
            content.Add(fileContent, "certificado", archivoFormulario.Name);

            // Enviar la solicitud
            var response = await Http.PostAsync("api/cursos", content);

            if (response.IsSuccessStatusCode)
            {
                cursoCreado = true;
                
                // Redirigir después de 3 segundos
                await Task.Delay(3000);
                Navigation.NavigateTo("/gestion-documentos");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al guardar el curso: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            enviandoFormulario = false;
        }
    }

    private async Task<string?> ObtenerCedulaUsuario()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var response = await Http.GetAsync("api/auth/verify");
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<VerifyTokenResponse>();
                    return result?.Data?.Cedula;
                }
            }
        }
        catch
        {
            // Silenciar errores
        }
        return null;
    }

    private async Task Logout()
    {
        try
        {
            var response = await Http.PostAsync("api/auth/logout", null);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception)
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login", true);
        }
    }

    // Modelos
    public class CursoModel
    {
        public string Nombre { get; set; } = "";
        public DateTime FechaInicio { get; set; } = DateTime.Today;
        public DateTime FechaFinalizacion { get; set; } = DateTime.Today.AddDays(30);
        public int HorasAcademicas { get; set; } = 1;
        public string OrganizacionNombre { get; set; } = "";
        public int? HorasImpartidas { get; set; } // Solo si es impartido
        public bool ImpartidoPorDocente { get; set; } = false;
    }

    public class VerifyTokenResponse
    {
        public bool Success { get; set; }
        public UserData? Data { get; set; }
    }

    public class UserData
    {
        public string? Nombre1 { get; set; }
        public string? Apellido1 { get; set; }
        public string? Cedula { get; set; }
    }
}