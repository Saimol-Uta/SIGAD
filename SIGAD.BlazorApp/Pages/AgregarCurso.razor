@page "/agregar-curso"
@page "/editar-curso/{Id:int?}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Web
@attribute [Authorize(Roles = "DOCENTE")]
@attribute [Layout(typeof(EmptyLayout))]
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject ISolicitudService SolicitudService

<PageTitle>@(Id.HasValue ? "Editar Curso - SIGAD" : "Agregar Curso - SIGAD")</PageTitle>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
        background-color: #fff;
        color: #0a1d44;
        height: 100%;
        overflow-x: hidden;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 1;
    }

    .branding {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header img.logo {
        height: 80px;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .user-profile span {
        font-weight: bold;
        color: #0a1d44;
    }

    .user-profile img {
        height: 40px;
        width: 40px;
        border-radius: 50%;
    }

    .back-btn, .logout-btn {
        background-color: #0a1d44;
        color: white;
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.3s ease;
    }

    .back-btn:hover, .logout-btn:hover {
        background-color: #1e3a5f;
    }

    .main-content {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: calc(100vh - 120px);
        padding: 2rem;
        position: relative;
    }

    .form-container {
        background-color: white;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 800px;
        z-index: 2;
    }

    .form-container h1 {
        text-align: center;
        margin-bottom: 0.5rem;
        color: #0a1d44;
        font-size: 2rem;
    }

    .subtitle {
        text-align: center;
        margin-bottom: 2rem;
        color: #666;
        font-size: 1rem;
        line-height: 1.4;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: bold;
        color: #0a1d44;
    }

    .required {
        color: #d9534f;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #0a1d44;
        box-shadow: 0 0 5px rgba(10, 29, 68, 0.3);
    }

    .form-control.is-invalid {
        border-color: #d9534f;
    }

    .invalid-feedback {
        color: #d9534f;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: normal;
        cursor: pointer;
    }

    .form-check-input {
        width: auto;
        margin: 0;
    }

    .btn-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }

    .btn {
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-primary {
        background-color: #0a1d44;
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background-color: #1e3a5f;
    }

    .btn-primary:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background-color: #545b62;
    }

    .alert {
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 5px;
        font-weight: bold;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .text-muted {
        color: #6c757d;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .text-success {
        color: #28a745;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        font-weight: bold;
    }

    .triangle-bg {
        position: fixed;
        bottom: -50px;
        right: -50px;
        width: 300px;
        height: 300px;
        z-index: 1;
        opacity: 0.1;
    }

    .validation-message {
        color: #d9534f;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .main-content {
            flex-direction: column;
            align-items: stretch;
            padding: 1rem;
        }

        .triangle-bg {
            display: none;
        }
    }
</style>

<script>
    // Función para notificar al modal parent de una operación completada
    window.notifyModalParent = function(success) {
        console.log('Debug - Notificando al parent modal, success:', success);
        try {
            if (window.parent && window.parent !== window) {
                window.parent.postMessage({
                    type: 'operationComplete',
                    success: success
                }, '*');
                console.log('Debug - Mensaje enviado al parent exitosamente');
            } else {
                console.log('Debug - No hay parent window disponible');
            }
        } catch (error) {
            console.error('Debug - Error al enviar mensaje al parent:', error);
        }
    };
</script>

<body>
    <div class="header">
        <div class="branding">
            <img src="/images/logoSIGAD.png" alt="Logo" class="logo" />
            <h1>SIGAD</h1>
        </div>
        <div class="user-profile">
            <a href="/gestion-documentos" class="back-btn">← Volver a Gestión</a>
            <span>@nombreUsuario</span>
            <img src="/images/IconoUser.png" alt="Usuario" />
            <button class="logout-btn" @onclick="Logout">Salir</button>
        </div>
    </div>

    <div class="main-content">
        <div class="form-container">
            <h1>@(Id.HasValue ? "✏️ Editar Curso" : "🎓 Agregar Curso")</h1>
            <p class="subtitle">
                @(Id.HasValue ? "Modifique los datos del curso" : "Complete la información del curso para incluirlo en su solicitud de ascenso")
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }
            @if (cursoGuardado)
            {
                <div class="alert alert-success">
                    ✅ @(Id.HasValue ? "Curso editado exitosamente. Redirigiendo..." : "Curso agregado exitosamente. Redirigiendo...")
                </div>
            }
            else
            {
                <EditForm Model="@cursoModel" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">
                            Nombre del Curso <span class="required">*</span>
                        </label>
                        <InputText @bind-Value="cursoModel.Nombre" class="form-control"
                                   placeholder="Ej: Desarrollo de Software con .NET" />
                        <ValidationMessage For="@(() => cursoModel.Nombre)" />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                Fecha de Inicio <span class="required">*</span>
                            </label>
                            <InputDate @bind-Value="cursoModel.FechaInicio" 
                                       @bind-Value:after="ValidarFechasCurso" 
                                       class="@($"form-control {(fechaInicioValida ? "" : "is-invalid")}")" 
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <ValidationMessage For="@(() => cursoModel.FechaInicio)" />
                            @if (!fechaInicioValida)
                            {
                                <div class="invalid-feedback" style="display: block;">
                                    ⚠️ La fecha de inicio no puede ser futura
                                </div>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Fecha de Finalización <span class="required">*</span>
                            </label>
                            <InputDate @bind-Value="cursoModel.FechaFinalizacion" 
                                       @bind-Value:after="ValidarFechasCurso" 
                                       class="@($"form-control {(fechaFinValida ? "" : "is-invalid")}")" 
                                       min="@cursoModel.FechaInicio.ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <ValidationMessage For="@(() => cursoModel.FechaFinalizacion)" />
                            @if (!fechaFinValida)
                            {
                                <div class="invalid-feedback" style="display: block;">
                                    ⚠️ La fecha de finalización debe ser posterior a la fecha de inicio y no futura
                                </div>
                            }
                            @if (fechaInicioValida && fechaFinValida)
                            {
                                <small class="text-success">
                                    ✅ Duración: @duracionCurso
                                </small>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label checkbox-label">
                                <InputCheckbox @bind-Value="cursoModel.ImpartidoPorDocente" 
                                             class="form-check-input"
                                             @onchange="OnImpartidoPorDocenteChange" />
                                ¿Es un curso impartido por usted? 
                                <small class="text-muted">(Marque si usted dictó este curso)</small>
                            </label>
                        </div>
                    </div>

                    <div class="form-row">
                        @if (cursoModel.ImpartidoPorDocente)
                        {
                            <div class="form-group">
                                <label class="form-label">
                                    Horas Impartidas <span class="required">*</span>
                                </label>
                                <InputNumber @bind-Value="cursoModel.HorasImpartidas" class="form-control"
                                             placeholder="Ej: 20" min="1" max="1000" />
                                <ValidationMessage For="@(() => cursoModel.HorasImpartidas)" />
                                <small class="text-muted">Horas que usted impartió como instructor</small>
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label class="form-label">
                                    Número de Horas <span class="required">*</span>
                                </label>
                                <InputNumber @bind-Value="cursoModel.NumeroHoras" class="form-control"
                                             placeholder="Ej: 40" min="1" max="1000" />
                                <ValidationMessage For="@(() => cursoModel.NumeroHoras)" />
                                <small class="text-muted">Horas de capacitación que usted recibió</small>
                            </div>
                        }
                        <div class="form-group">
                            <label class="form-label">
                                Tipo de Curso <span class="required">*</span>
                            </label>
                            <InputSelect @bind-Value="cursoModel.TipoCurso" class="form-control">
                                <option value="">Seleccione el tipo de curso</option>
                                @foreach (var tipo in TiposCurso)
                                {
                                    <option value="@tipo.Key">@tipo.Value</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => cursoModel.TipoCurso)" />
                            <small class="text-muted">Seleccione el tipo según el reglamento académico</small>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            Organización <span class="required">*</span>
                        </label>
                        <InputSelect @bind-Value="cursoModel.OrganizacionId" class="form-control">
                            <option value="">Seleccione una organización</option>
                            @foreach (var org in organizaciones)
                            {
                                <option value="@org.Id">@org.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => cursoModel.OrganizacionId)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Certificado <span class="required">*</span></label>
                        <InputFile OnChange="@OnCertificadoSelected" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                        @if (!string.IsNullOrEmpty(certificadoSeleccionado))
                        {
                            <p>Archivo: @certificadoSeleccionado</p>
                        }
                        @if (!string.IsNullOrEmpty(cursoModel.CertificadoRuta) && string.IsNullOrEmpty(certificadoSeleccionado))
                        {
                            <p>
                                Archivo actual:
                                <a href="@($"https://localhost:7072/uploads/{cursoModel.CertificadoRuta}")" target="_blank">
                                    @Path.GetFileName(cursoModel.CertificadoRuta)
                                </a>
                            </p>
                        }
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => Navigation.NavigateTo(GetReturnUrl()))">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@(enviandoFormulario)">
                            @if (enviandoFormulario)
                            {
                                <span>Guardando curso...</span>
                            }
                            else
                            {
                                <span>@(Id.HasValue ? "Guardar Cambios" : "Guardar Curso")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>

    <img src="/images/triangulos.jpg" alt="Background Graphic" class="triangle-bg" />
</body>

@code {
    [Parameter] public int? Id { get; set; }

    // Constantes locales para tipos de curso (evitar dependencia directa del enum del dominio)
    private static readonly Dictionary<string, string> TiposCurso = new()
    {
        { "ActualizacionCientifica", "Actualización Científica" },
        { "ActualizacionPedagogica", "Actualización Pedagógica" },
        { "Especializacion", "Especialización" },
        { "Diplomado", "Diplomado" },
        { "Seminario", "Seminario/Taller" },
        { "Conferencia", "Conferencia/Ponencia" },
        { "Certificacion", "Certificación Profesional" },
        { "CapacitacionImpartida", "Capacitación Impartida" },
        { "CapacitacionTecnica", "Capacitación Técnica" }
    };

    private string nombreUsuario = "";
    private CursoModel cursoModel = new();
    private bool enviandoFormulario = false;
    private bool cursoGuardado = false;
    private string? errorMessage;
    private IBrowserFile? certificadoFile;
    private string certificadoSeleccionado = "";
    private string returnTo = "gestion-documentos"; // Por defecto volver a gestión

    // Variables para validación de fechas
    private bool fechaInicioValida = true;
    private bool fechaFinValida = true;
    private string duracionCurso = "";

    // Lista de organizaciones de ejemplos
    private List<OrganizacionModel> organizaciones = new()
    {
        new OrganizacionModel { Id = 1, Nombre = "Ministerio de Educación" },
        new OrganizacionModel { Id = 2, Nombre = "Ministerio de Tecnologías" },
        new OrganizacionModel { Id = 3, Nombre = "Agencia Nacional de Innovación" },
        new OrganizacionModel { Id = 4, Nombre = "UNESCO" },
        new OrganizacionModel { Id = 5, Nombre = "SENA" }
    };

    protected override async Task OnInitializedAsync()
    {
        // Obtener parámetros de query
        var uri = new Uri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        
        if (query["returnTo"] != null)
        {
            returnTo = query["returnTo"];
        }

        try
        {
            var result = await Http.GetFromJsonAsync<UserInfoResponse>("/api/Usuario/info");
            if (result != null && !string.IsNullOrEmpty(result.Username))
            {
                nombreUsuario = result.Username;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener información del usuario: {ex.Message}");
        }

        if (Id.HasValue)
        {
            await CargarCurso();
        }
        else
        {
            // Inicializar fechas en blanco para nuevo curso
            cursoModel.FechaInicio = DateTime.Today;
            cursoModel.FechaFinalizacion = DateTime.Today;
        }
    }

    private async Task CargarCurso()
    {
        try
        {
            var response = await Http.GetAsync($"/api/Cursos/{Id.Value}");
            if (response.IsSuccessStatusCode)
            {
                var curso = await response.Content.ReadFromJsonAsync<CursoDto>();
                if (curso != null)
                {
                    cursoModel = new CursoModel
                    {
                        Id = curso.Id,
                        Nombre = curso.Nombre,
                        FechaInicio = curso.FechaInicio,
                        FechaFinalizacion = curso.FechaFinalizacion,
                        NumeroHoras = curso.NumeroHoras,
                        HorasImpartidas = curso.HorasImpartidas,
                        TipoCurso = curso.TipoCurso,
                        OrganizacionId = curso.OrganizacionId,
                        ImpartidoPorDocente = curso.ImpartidoPorDocente,
                        CertificadoRuta = curso.CertificadoRuta
                    };
                    
                    ValidarFechasCurso();
                }
            }
            else
            {
                errorMessage = "❌ No se pudo cargar el curso. Por favor, intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ Error al cargar el curso: {ex.Message}";
        }
    }

    private void OnCertificadoSelected(InputFileChangeEventArgs e)
    {
        certificadoFile = e.File;
        certificadoSeleccionado = e.File.Name;

        // Validar tamaño (10MB)
        if (certificadoFile.Size > 10 * 1024 * 1024)
        {
            errorMessage = "❌ El archivo es demasiado grande. Máximo permitido: 10MB";
            certificadoFile = null;
            certificadoSeleccionado = "";
            return;
        }

        // Validar extensión
        var extension = Path.GetExtension(certificadoFile.Name).ToLower();
        var extensionesPermitidas = new[] { ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx" };
        if (!extensionesPermitidas.Contains(extension))
        {
            errorMessage = "❌ Formato de archivo no permitido. Use: PDF, JPG, JPEG, PNG, DOC o DOCX";
            certificadoFile = null;
            certificadoSeleccionado = "";
            return;
        }

        errorMessage = null;
        StateHasChanged();
    }

    private void ValidarFechasCurso()
    {
        // Validar fecha de inicio (no puede ser futura)
        fechaInicioValida = cursoModel.FechaInicio <= DateTime.Today;
        
        // Validar fecha de finalización (debe ser posterior al inicio y no futura)
        fechaFinValida = cursoModel.FechaFinalizacion > cursoModel.FechaInicio && 
                         cursoModel.FechaFinalizacion <= DateTime.Today;
        
        // Calcular duración si ambas fechas son válidas
        if (fechaInicioValida && fechaFinValida)
        {
            var dias = (cursoModel.FechaFinalizacion - cursoModel.FechaInicio).Days;
            var meses = dias / 30.0;
            
            if (dias == 0)
            {
                duracionCurso = "1 día";
            }
            else if (dias < 30)
            {
                duracionCurso = $"{dias + 1} días";
            }
            else if (meses < 12)
            {
                duracionCurso = $"{meses:F1} meses ({dias + 1} días)";
            }
            else
            {
                var años = meses / 12.0;
                duracionCurso = $"{años:F1} años ({dias + 1} días)";
            }
        }
        else
        {
            duracionCurso = "";
        }
        
        StateHasChanged();
    }

    private async Task OnImpartidoPorDocenteChange()
    {
        // Limpiar valores cuando cambia el tipo
        if (cursoModel.ImpartidoPorDocente)
        {
            cursoModel.NumeroHoras = 0;
        }
        else
        {
            cursoModel.HorasImpartidas = null;
        }
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (enviandoFormulario) return;

        enviandoFormulario = true;
        errorMessage = null;

        // Validar fechas antes del envío
        ValidarFechasCurso();
        if (!fechaInicioValida || !fechaFinValida)
        {
            errorMessage = "❌ Por favor corrija las fechas antes de continuar.";
            enviandoFormulario = false;
            return;
        }

        // Validar organización seleccionada
        if (cursoModel.OrganizacionId == null || cursoModel.OrganizacionId <= 0)
        {
            errorMessage = "❌ Debe seleccionar una organización válida.";
            enviandoFormulario = false;
            return;
        }

        // Validar tipo de curso seleccionado
        if (string.IsNullOrEmpty(cursoModel.TipoCurso) || !TiposCurso.ContainsKey(cursoModel.TipoCurso))
        {
            errorMessage = "❌ Debe seleccionar un tipo de curso válido.";
            enviandoFormulario = false;
            return;
        }

        // Validar archivo (obligatorio al agregar, opcional al editar)
        if (!Id.HasValue && certificadoFile == null)
        {
            errorMessage = "❌ Debe adjuntar el archivo de certificado.";
            enviandoFormulario = false;
            return;
        }

        try
        {
            var cedula = await ObtenerCedulaUsuario();
            if (string.IsNullOrEmpty(cedula))
            {
                errorMessage = "❌ No se pudo obtener la información del usuario";
                enviandoFormulario = false;
                return;
            }

            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(cursoModel.Nombre), "Nombre");
            
            // Para edición usa OrganizacionId, para creación usa OrganizacionNombre
            if (Id.HasValue)
            {
                content.Add(new StringContent(cursoModel.OrganizacionId.ToString()!), "OrganizacionId");
                content.Add(new StringContent(cursoModel.FechaInicio.ToString("yyyy-MM-ddTHH:mm:ss")), "FechaInicio");
            }
            else
            {
                // Buscar el nombre de la organización seleccionada para crear
                var organizacionSeleccionada = organizaciones.FirstOrDefault(o => o.Id == cursoModel.OrganizacionId);
                var organizacionNombre = organizacionSeleccionada?.Nombre ?? "";
                content.Add(new StringContent(organizacionNombre), "OrganizacionNombre");
                content.Add(new StringContent(cursoModel.FechaInicio.ToString("yyyy-MM-ddTHH:mm:ss")), "FechaInicio");
            }
            
            content.Add(new StringContent(cursoModel.NumeroHoras.ToString()), "NumeroHoras");
            content.Add(new StringContent((cursoModel.HorasImpartidas ?? 0).ToString()), "HorasImpartidas");
            content.Add(new StringContent(cursoModel.ImpartidoPorDocente.ToString()), "ImpartidoPorDocente");
            content.Add(new StringContent(cursoModel.TipoCurso!), "TipoCurso");
            content.Add(new StringContent(cursoModel.FechaFinalizacion.ToString("yyyy-MM-ddTHH:mm:ss")), "FechaFinalizacion");
            content.Add(new StringContent(cedula), "DocenteCedula");

            // Para edición, agregar el ID
            if (Id.HasValue)
            {
                content.Add(new StringContent(Id.Value.ToString()), "Id");
            }

            // Adjuntar archivo solo si el usuario seleccionó uno nuevo
            if (certificadoFile != null)
            {
                var stream = certificadoFile.OpenReadStream(10 * 1024 * 1024);
                content.Add(new StreamContent(stream), "certificado", certificadoFile.Name);
            }

            HttpResponseMessage response;
            if (Id.HasValue)
            {
                response = await Http.PutAsync($"/api/Cursos/{Id.Value}", content);
            }
            else
            {
                response = await Http.PostAsync("/api/Cursos", content);
            }

            if (response.IsSuccessStatusCode)
            {
                cursoGuardado = true;
                
                // Si viene de modal, notificar al parent y no navegar
                if (returnTo == "modal")
                {
                    await JSRuntime.InvokeVoidAsync("notifyModalParent", true);
                    await Task.Delay(500); // Pequeña pausa para asegurar que el mensaje se envíe
                }
                else
                {
                    // Mostrar SweetAlert con cierre automático
                    await JSRuntime.InvokeVoidAsync("Swal.fire", new
                    {
                        position = "center",
                        icon = "success",
                        title = "¡Curso guardado!",
                        text = "La información se ha guardado correctamente",
                        showConfirmButton = false,
                        timer = 2000
                    });
                       
                    // Esperar y redirigir
                    await Task.Delay(2200); // Esperar a que termine el SweetAlert
                    Navigation.NavigateTo(GetReturnUrl());
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"❌ Error al {(Id.HasValue ? "actualizar" : "guardar")} el curso: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            enviandoFormulario = false;
        }
    }

    private string GetReturnUrl()
    {
        return returnTo == "inventario" ? "/inventario" : "/gestion-documentos";
    }

    private async Task<string?> ObtenerCedulaUsuario()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var response = await Http.GetAsync("/api/auth/verify");
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<VerifyTokenResponse>();
                    return result?.Data?.Cedula;
                }
            }
        }
        catch
        {
            // En caso de error, devolver null
        }
        return null;
    }

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        Navigation.NavigateTo("/login");
    }

