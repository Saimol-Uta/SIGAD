        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
        border-radius: 12px;
        margin-left: auto;
    }

    .submission-section {
        margin-top: 3rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .submission-card {
        background: white;
        border: 2px solid #0a1d44;
        border-radius: 12px;
        padding: 2.5rem;
        text-align: center;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .submission-card h2 {
        color: #0a1d44;
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .submission-description {
        color: #666;
        font-size: 1.1rem;
        margin-bottom: 2rem;
        line-height: 1.5;
    }

    .submission-actions {
        margin-top: 2rem;
    }

    .btn-large {
        padding: 1rem 2.5rem;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 8px;
    }

    .btn-success {
        background-color: #165125;
        color: white;
        border: none;
        border-radius: 0.2rem;
                font-size: 0.9rem;
                        font-weight: 500;


    }

    .btn-success:hover:not(:disabled) {
        background-color: rgba(23, 68, 35, 0.4);
        color: #165125;
                font-size: 0.9rem;
                        font-weight: 500;
    }

    .help-text {
        margin-top: 1rem;
        color: #666;
        font-size: 0.9rem;
        font-style: italic;
    }

    .missing-docs-list {
        text-align: left;
        margin: 1rem 0;
        padding-left: 2rem;
    }

    .missing-docs-list li {
        margin: 0.5rem 0;
        color: #856404;
    }

    .alert {
        padding: 1rem;
        border-radius: 6px;
        margin: 1rem 0;
        z-index:2;
    }

    .alert-success {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
    }

    .alert-warning {
        background-color: #fff3cd;
        border: 1px solid #ffeaa7;
        color: #856404;
    }

    .alert-info {
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
        color: #0c5460;
    }

    .alert-danger {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #721c24;
    }

    /* Estilos para verificación de requisitos */
    .requirements-verification {
        margin: 1rem 0;
        text-align: center;
    }

    .requirements-details {
        margin-top: 1.5rem;
        padding: 1.5rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background-color: #f8f9fa;
    }

    .requirements-details h4 {
        color: #0a1d44;
        margin-bottom: 1rem;
        text-align: center;
    }

    .requirements-summary {
        display: grid;
        gap: 0.8rem;
        margin: 1rem 0;
    }

    .requirement-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem;
        border-radius: 6px;
        background-color: white;
        border: 1px solid #dee2e6;
        z-index:2;
    }

    .requirement-item .label {
        font-weight: 600;
        color: #0a1d44;
    }

    .requirement-item .value {
        font-weight: 500;
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
    }

    .requirement-item .value.success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .requirement-item .value.error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .missing-requirements {
        margin-top: 1rem;
        padding: 1rem;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 6px;
    }

    .missing-requirements h5 {
        color: #721c24;
        margin-bottom: 0.5rem;
    }

    .missing-requirements ul {
        margin: 0;
        padding-left: 1.5rem;
        color: #721c24;
    }

    .missing-requirements li {
        margin-bottom: 0.3rem;
    }
        /* --- Media Query para el tamaño intermedio (Tablets) --- */
   @@media (max-width: 1199px) and (min-width: 769px) {
    
    /* 1. Aseguramos que el layout principal sea horizontal */
    .main-content {
        flex-direction: row;
        align-items: center; /* Centra los elementos verticalmente */
        justify-content: space-between; /* Mantiene el espacio entre ellos */
        padding: 2rem; /* Un padding adecuado para este tamaño */
    }

    /* 2. Reducimos el tamaño del título para que ocupe menos espacio */
    .left h1 {
        font-size: 4.5rem; 
    }

    /* 3. Nos aseguramos que la tarjeta no tenga márgenes extraños */
    .promotion-card {
        margin-right: 0; /* Quitamos cualquier margen grande */
        flex-shrink: 0;  /* Evita que la tarjeta se encoja y se deforme */
        width: 45%;      /* Le damos un ancho fijo o porcentual */
        max-width: 450px;
    }

    /* 4. La clave: Ocultamos los triángulos en este tamaño */
    .triangle-bg {
        display: none;
    }
}

    @@media (max-width: 768px) {
    .main-content {
        flex-direction: column;
        align-items: stretch;
        padding: 1rem;
    }

    .left {
        padding-left: 1rem;
        margin-top: 20px;
        width: 100%;
    }

    .promotion-card {
        margin-right: 0 !important;
        margin-top: 20px;
        width: 100%;
        max-width: none;
    }

    .triangle-bg {
        display: none;
    }
}

    /* Nuevo layout de dos columnas */
    .content-container {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .documents-section {
        min-height: 600px;
    }

    .status-sidebar {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 1.5rem;
        height: fit-content;
        position: sticky;
        top: 2rem;
    }

    .status-sidebar h3 {
        color: #0a1d44;
        margin-bottom: 1rem;
        font-size: 1.3rem;
        text-align: center;
    }

    .solicitud-status {
        background: white;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        border-left: 4px solid #28a745;
    }

    .solicitud-status.inactive {
        border-left-color: #dc3545;
    }

    .solicitud-status.draft {
        border-left-color: #ffc107;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .status-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #28a745;
    }

    .status-dot.inactive {
        background-color: #dc3545;
    }

    .status-dot.draft {
        background-color: #ffc107;
    }

    .requirements-preview {
        background: white;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .requirements-preview h5 {
        margin-bottom: 0.8rem;
        color: #0a1d44;
    }

    .requirement-mini {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
        border-bottom: 1px solid #eee;
        font-size: 0.9rem;
    }

    .requirement-mini:last-child {
        border-bottom: none;
    }

    .progress-indicator {
        font-weight: bold;
    }

    .progress-indicator.success {
        color: #28a745;
    }

    .progress-indicator.warning {
        color: #ffc107;
    }

    .progress-indicator.danger {
        color: #dc3545;
    }

    /* Indicadores para documentos utilizados */
    .document-card.has-used-docs {
        position: relative;
        background: linear-gradient(135deg, #fff 95%, #ffebee 95%);
    }

    .used-indicator {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #ff9800;
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .document-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        font-size: 0.85rem;
    }

    .status-badge {
        padding: 0.2rem 0.5rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    .status-badge.available {
        background: #d4edda;
        color: #155724;
    }

    .status-badge.partial {
        background: #fff3cd;
        color: #856404;
    }

    .status-badge.used {
        background: #f8d7da;
        color: #721c24;
    }

    /* Estilos para el modal de agregar documento */
    .add-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1002;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.3s ease-out;
    }

    .add-modal-content {
        background: white;
        border-radius: 12px;
        width: 90%;
        max-width: 800px;
        max-height: 90vh;
        overflow: hidden;
        position: relative;
        animation: slideIn 0.3s ease-out;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .add-modal-header {
        background: linear-gradient(135deg, #0a1d44 0%, #1e3a8a 100%);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 12px 12px 0 0;
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .add-modal-header h3 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
    }

    .add-modal-close-btn {
        position: absolute;
        top: 1rem;
        right: 1.5rem;
        background: transparent;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 50%;
        transition: background-color 0.2s ease;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .add-modal-close-btn:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .add-modal-body {
        padding: 0;
        max-height: calc(90vh - 200px);
        overflow-y: auto;
        overflow-x: hidden;
    }

    .add-modal-footer {
        padding: 1.5rem 2rem;
        border-top: 1px solid #e9ecef;
        background: #f8f9fa;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        border-radius: 0 0 12px 12px;
    }

    .iframe-container {
        width: 100%;
        height: calc(90vh - 200px);
        border: none;
        background: white;
    }

    .loading-iframe {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 300px;
        background: #f8f9fa;
        color: #666;
        font-size: 1.1rem;
    }

    .loading-iframe i {
        margin-right: 0.5rem;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-30px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Estilos para documentos utilizados en tablas */
    .document-row-used {
        background: linear-gradient(90deg, #fff3cd 0%, #fff 15%);
        border-left: 4px solid #ffc107;
        position: relative;
    }

    .document-row-used::before {
        content: "­ƒöÆ USADO";
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: #ffc107;
        color: #856404;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: bold;
        z-index: 2;
    }

    .document-row-used .document-title {
        opacity: 0.8;
        text-decoration: line-through;
    }

    .document-card.has-documents-used {
        border-left: 4px solid #ffc107;
        background: linear-gradient(135deg, #fff 85%, #fff3cd 85%);
    }

    .documents-used-indicator {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 4px;
        padding: 0.5rem;
        margin: 0.5rem 0;
        font-size: 0.85rem;
        color: #856404;
    }

    .documents-used-indicator strong {
        color: #856404;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .content-container {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
        
        .status-sidebar {
            position: static;
            order: -1;
        }
    }

    /* Estilos del Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        box-sizing: border-box;
    }

    .modal-content {
        background: white;
        border-radius: 12px;
        width: 95%;
        max-width: 1200px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        animation: modalSlideIn 0.3s ease-out;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-50px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #0a1d44;
        background: linear-gradient(135deg, #0a1d44 0%, #1a365d 100%);
        color: white;
        border-radius: 12px 12px 0 0;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: white;
    }

    .modal-close-btn {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        font-size: 1.5rem;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .modal-close-btn:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: scale(1.1);
    }

    .modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 0;
        max-height: calc(90vh - 160px);
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
        border-radius: 0 0 12px 12px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-secondary:hover {
        background-color: #5a6268;
        transform: translateY(-1px);
    }

    /* Responsive para el modal */
    @@media (max-width: 768px) {
        .modal-content {
            width: 98%;
            max-height: 95vh;
            margin: 10px;
        }

        .modal-header {
            padding: 1rem;
        }

        .modal-header h3 {
            font-size: 1.2rem;
        }

        .modal-footer {
            padding: 1rem;
            flex-direction: column;
            gap: 1rem;
        }

        .modal-footer .btn {
            width: 100%;
            justify-content: center;
