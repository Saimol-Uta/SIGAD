  private async Task ImportarDocumentos(string tipoDocumento)
{
    if (operacionEnProceso || string.IsNullOrEmpty(cedula)) return;

    operacionEnProceso = true;
    mensajeProceso = $"Importando {tipoDocumento} desde sistemas externos...";
    mensajeOperacion = null;

    try
    {
        string? endpoint = tipoDocumento switch
{
    "investigaciones" => $"api/investigaciones/externa/importar/{cedula}",
    "articulos" => $"api/articulos/externos/importar/{cedula}",
    "experiencias" => $"api/experiencias/externas/importar/{cedula}",
    "evaluaciones" => $"api/evaluaciones/externas/importar/{cedula}",
    "cursos" => $"api/cursos/externos/importar/{cedula}",
    "tesis" => $"api/tesis/externas/importar/{cedula}",
    _ => null
};


        if (string.IsNullOrEmpty(endpoint))
        {
            mensajeOperacion = "❌ Tipo de documento no reconocido.";
            operacionExitosa = false;
            return;
        }

        var response = await Http.PostAsync(endpoint, null);
        if (response.IsSuccessStatusCode)
        {
            var resultado = await response.Content.ReadAsStringAsync();
            mensajeOperacion = $"✅ Importación exitosa: {resultado}";
            operacionExitosa = true;

            // Actualizar el contador especáfico de manera eficiente
            await ActualizarContadorEspecifico(tipoDocumento);
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensajeOperacion = $"❌ Falló la importación: {error}";
            operacionExitosa = false;
        }
    }
    catch (Exception ex)
    {
        mensajeOperacion = $"❌ Error: {ex.Message}";
        operacionExitosa = false;
    }
    finally
    {
        operacionEnProceso = false;
        mensajeProceso = "";
    }
}
    private async Task ExportarDocumentos(string tipoDocumento)
    {
        if (operacionEnProceso) return;

        operacionEnProceso = true;
        mensajeProceso = $"Exportando {tipoDocumento}...";
        mensajeOperacion = null;

        try
        {
            string endpoint = tipoDocumento switch
            {
                "investigaciones" => $"api/investigaciones/docente/{cedula}",
                "articulos" => $"api/articulos/docente/{cedula}",
                "experiencias" => $"api/experienciaslaborales/docente/{cedula}",
                "evaluaciones" => $"api/evaluaciones/docente/{cedula}",
                "cursos" => $"api/cursos/docente/{cedula}",
                "tesis" => $"api/TesisDirigidas/docente/{cedula}",
                _ => ""
            };

            if (!string.IsNullOrEmpty(endpoint))
            {
                var response = await Http.GetAsync(endpoint);
                if (response.IsSuccessStatusCode)
                {
                    var jsonContent = await response.Content.ReadAsStringAsync();
                    
                    // Descargar como archivo JSON
                    var fileName = $"{tipoDocumento}_{cedula}_{DateTime.Now:yyyyMMdd_HHmmss}.json";
                    await JSRuntime.InvokeVoidAsync("downloadFile", fileName, "application/json", jsonContent);
                    
                    mensajeOperacion = $"✅ {tipoDocumento} exportados exitosamente como {fileName}";
                    operacionExitosa = true;
                }
                else
                {
                    mensajeOperacion = $"Error al exportar {tipoDocumento}: No se pudieron obtener los datos";
                    operacionExitosa = false;
                }
            }
        }
        catch (Exception ex)
        {
            mensajeOperacion = $"Error al exportar {tipoDocumento}: " + ex.Message;
            operacionExitosa = false;
        }
        finally
        {
            operacionEnProceso = false;
            mensajeProceso = "";
            
            // Limpiar mensaje después de 5 segundos
            _ = Task.Delay(5000).ContinueWith(_ => 
            {
                mensajeOperacion = null;
                InvokeAsync(StateHasChanged);
            });
        }
    }
    private async Task Logout()
    {
        try
        {
            var response = await Http.PostAsync("api/auth/logout", null);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception)
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login", true);
        }
