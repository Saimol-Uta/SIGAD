    private void VerTabla(string tipoDocumento)
    {
        tablaVisible = tipoDocumento;
        tipoDocumentoSeleccionado = tipoDocumento; // Establecer el tipo seleccionado para mostrar la guáa
        StateHasChanged();
    }

    private async void CerrarTabla()
    {
        tablaVisible = null;
        tipoDocumentoSeleccionado = null; // Limpiar la selección de tipo de documento
        
        // Actualizar contadores dinámicamente cuando se cierra la tabla
        await CargarConteoDocumentos();
        StateHasChanged();
    }

    private void AgregarDocumento(string tipoDocumento)
    {
        string ruta = tipoDocumento switch
        {
            "investigaciones" => "/agregar-investigacion",
            "articulos" => "/agregar-articulo",
            "experiencias" => "/agregar-experiencia-laboral",
            "evaluaciones" => "/agregar-evaluacion",
            "cursos" => "/agregar-curso",
            "tesis" => "/agregar-tesis",
            _ => "/gestion-documentos"
        };
        Navigation.NavigateTo(ruta);
    }

    // Métodos para actualizar contadores específicos (más eficiente)
    private async Task ActualizarContadorEspecifico(string tipoDocumento)
    {
        if (string.IsNullOrEmpty(cedula)) return;

        try
        {
            switch (tipoDocumento.ToLower())
            {
                case "investigaciones":
                    await CargarConteoInvestigaciones();
                    break;
                case "articulos":
                    await CargarConteoArticulos();
                    break;
                case "experiencias":
                    await CargarConteoExperiencias();
                    break;
                case "evaluaciones":
                    await CargarConteoEvaluaciones();
                    break;
                case "cursos":
                    await CargarConteoCursos();
                    break;
                case "tesis":
                    await CargarConteoTesis();
                    break;
            }
            
            // Verificar documentos completos después de actualizar
            VerificarDocumentosCompletos();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Log del error pero no mostrar al usuario para no interrumpir la experiencia
            Console.WriteLine($"Error actualizando contador de {tipoDocumento}: {ex.Message}");
        }
    }

