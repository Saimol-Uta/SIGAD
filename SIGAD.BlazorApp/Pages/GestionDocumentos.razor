@using System.Text.Json.Serialization;
@page "/gestion-documentos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "DOCENTE")]
@using SIGAD.BlazorApp.Layout
@using SIGAD.BlazorApp.Services
@using SIGAD.BlazorApp.Components
@using System.Text.Json
@attribute [Layout(typeof(EmptyLayout))]
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject ISolicitudService SolicitudService

<PageTitle>Gestión de Documentos - SIGAD</PageTitle>

<style>
    * {
