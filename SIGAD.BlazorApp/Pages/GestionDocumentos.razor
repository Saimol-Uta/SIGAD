    // Métodos para actualizar contadores específicos (más eficiente)
    private async Task ActualizarContadorEspecifico(string tipoDocumento)
    {
        if (string.IsNullOrEmpty(cedula)) return;

        try
        {
            switch (tipoDocumento.ToLower())
            {
                case "investigaciones":
                    await CargarConteoInvestigaciones();
                    break;
                case "articulos":
                    await CargarConteoArticulos();
                    break;
                case "experiencias":
                    await CargarConteoExperiencias();
                    break;
                case "evaluaciones":
                    await CargarConteoEvaluaciones();
                    break;
                case "cursos":
                    await CargarConteoCursos();
                    break;
                case "tesis":
                    await CargarConteoTesis();
                    break;
            }
            
            // Verificar documentos completos después de actualizar
            VerificarDocumentosCompletos();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Log del error pero no mostrar al usuario para no interrumpir la experiencia
            Console.WriteLine($"Error actualizando contador de {tipoDocumento}: {ex.Message}");
        }
    }

    // Método para actualizar automáticamente los requisitos cuando cambian los documentos
    private async Task ActualizarRequisitosAutomaticamente()
    {
        try
        {
            Console.WriteLine("Debug - Actualizando conteos automáticamente...");
            
            // Actualizar conteo de documentos específico si hay una tabla visible
            if (!string.IsNullOrEmpty(tablaVisible))
            {
                await ActualizarContadorEspecifico(tablaVisible);
            }
            
            // Actualizar conteo general de documentos
            await CargarConteoDocumentos();
            
            // Pequeña pausa para asegurar que la UI se actualice
            await Task.Delay(100);
            
            // Forzar actualización de la UI
            StateHasChanged();
            
            // Log de conteos actualizados
            Console.WriteLine($"Debug - Conteos actualizados: Inv={conteoInvestigaciones}, Art={conteoArticulos}, Exp={conteoExperiencias}, Eval={conteoEvaluaciones}, Cur={conteoCursos}, Tesis={conteoTesis}");
            
            // Verificar si hay requisitos para verificar (solo si ya se habían verificado antes)
            if (!string.IsNullOrEmpty(solicitudId) && mostrarDetallesRequisitos)
            {
                Console.WriteLine("Debug - Re-verificando requisitos automáticamente...");
                // Verificar los requisitos automáticamente solo si ya estaban siendo mostrados
                await VerificarRequisitos();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al actualizar requisitos automáticamente: {ex.Message}");
        }
    }

