<body>
    <div class="header">
        <div class="branding">
            <img src="/images/logoSIGAD.png" alt="Logo" class="logo" />
            <h1>SIGAD</h1>
        </div>
        <div class="user-profile">
            <a href="/Dashboard" class="back-btn"><i class="fas fa-arrow-left"></i> Volver al Inicio</a>
            <span>@nombreUsuario</span>
            <img src="@urlFotoPerfil" alt="Usuario" />
            <button class="logout-btn" @onclick="Logout"><i class="fas fa-sign-out-alt"></i> Salir</button>
        </div>
    </div>

    <div class="main-content">
        <div class="page-header">
            <h1>Gestión de Documentos</h1>
            <p class="subtitle">Importe y exporte sus documentos académicos para el proceso de ascenso</p>
        </div>

        @if (isLoading)
        {
            <div class="loading">
                <p>Cargando información de documentos...</p>
            </div>
        }
        else
        {
            <div class="status-info">
                <h3>📋 Estado de sus Documentos</h3>
                <p>Docente: <strong>@nombreCompleto</strong> | Cédula: <strong>@cedula</strong></p>
                @if (!string.IsNullOrEmpty(solicitudId))
                {
                    <div style="margin-top: 1rem;">
                        <span style="color: #28a745; font-weight: bold;">🟢 Sesión Activa - Gestión de Documentos Habilitada</span>
                    </div>
                }
                else
                {
                    <div style="margin-top: 1rem;">
                        <span style="color: #dc3545; font-weight: bold;">🔴 Sesión Inactiva - No hay solicitud de ascenso activa</span>
                    </div>
                }
            </div>

            <!-- Guáas de Requisitos por Tipo de Documento -->
            @if (!string.IsNullOrEmpty(tipoDocumentoSeleccionado) && !string.IsNullOrEmpty(rangoSolicitado))
            {
                <div style="margin: 2rem 0;">
                    @* <RequirementsGuideSimple RangoSolicitadoNombre="@rangoSolicitado" TipoDocumento="@tipoDocumentoSeleccionado" /> *@
                    <div class="alert alert-info">
                        <strong>Guía de Requisitos para @rangoSolicitado</strong>
                        <p>Tipo de documento: @tipoDocumentoSeleccionado</p>
                    </div>
                </div>
            }

            <div class="documents-grid">
                <!-- Investigaciones -->
                <div class="document-card">
                    <h3>
                        <span class="icon"><i class="fas fa-microscope text-primary"></i></span>
                        Investigaciones
                        <span class="document-count">@conteoInvestigaciones</span>
                    </h3>
                    <p class="description">
                        Gestione sus proyectos de investigación, informes y documentos relacionados con actividades investigativas.
                    </p>

                    <div class="document-actions">
                        <button class="btn btn-import" @onclick="@(async () => await VerTabla("investigaciones"))" disabled="@operacionEnProceso">
                            <i class="fas fa-search"></i> Ver documentos
                        </button>
                        <button class="btn btn-info" @onclick="@(async () => await ActualizarConteoManual("investigaciones"))" disabled="@operacionEnProceso" title="Recarga manual (solo si es necesario)">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>

                <!-- Artículos -->
                <div class="document-card">
                    <h3>
                        <span class="icon"><i class="fas fa-newspaper text-info"></i></span>
                        Artículos
                        <span class="document-count">@conteoArticulos</span>
                    </h3>
                    <p class="description">
                        Administre sus publicaciones científicas, artículos de revista y documentos académicos publicados.
                    </p>

                    <div class="document-actions">
                        <button class="btn btn-import" @onclick="@(async () => await VerTabla("articulos"))" disabled="@operacionEnProceso">
                            <i class="fas fa-search"></i> Ver documentos
                        </button>
                    </div>
                </div>

                <!-- Experiencia Laboral -->
                <div class="document-card">
                    <h3>
                        <span class="icon"><i class="fas fa-briefcase text-success"></i></span>
                        Experiencia Laboral
                        <span class="document-count">@conteoExperiencias</span>
                    </h3>
                    <p class="description">
                        Gestione su historial profesional, certificados laborales y documentos de experiencia docente.
                    </p>

                    <div class="document-actions">
                        <button class="btn btn-import" @onclick="@(async () => await VerTabla("experiencias"))" disabled="@operacionEnProceso">
                            <i class="fas fa-search"></i> Ver documentos
                        </button>
                    </div>
                </div>

                <!-- Evaluaciones -->
                <div class="document-card">
                    <h3>
                        <span class="icon"><i class="fas fa-chart-line text-warning"></i></span>
                        Evaluaciones
                        <span class="document-count">@conteoEvaluaciones</span>
                    </h3>
                    <p class="description">
                        Administre sus evaluaciones docentes, reportes de desempeño y documentos de evaluación académica.
                    </p>

                    <div class="document-actions">
                        <button class="btn btn-import" @onclick="@(async () => await VerTabla("evaluaciones"))" disabled="@operacionEnProceso">
                            <i class="fas fa-search"></i> Ver documentos
                        </button>
                    </div>
                </div>

                <!-- Cursos -->
                <div class="document-card">
                    <h3>
                        <span class="icon"><i class="fas fa-graduation-cap text-secondary"></i></span>
                        Cursos
                        <span class="document-count">@conteoCursos</span>
                    </h3>
                    <p class="description">
                        Gestione sus cursos impartidos, certificados de capacitación y documentos de formación académica.
                    </p>

                    <div class="document-actions">
                        <button class="btn btn-import" @onclick="@(async () => await VerTabla("cursos"))" disabled="@operacionEnProceso">
                            <i class="fas fa-search"></i> Ver documentos
                        </button>
                    </div>
                </div>

                <!-- Tesis Asignadas -->
                 @if (RangoRequiereTesis())
                                            {
                <div class="document-card">
                    <h3>
                        <span class="icon"><i class="fas fa-book text-danger"></i></span>
                        Tesis Asignadas
                        <span class="document-count">@conteoTesis</span>
                    </h3>
                    <p class="description">
                        Gestione sus trabajos de titulación, tesis dirigidas o co-dirigidas asignadas oficialmente.
                    </p>

                    <div class="document-actions">
                        <button class="btn btn-import" @onclick="@(async () => await VerTabla("tesis"))" disabled="@operacionEnProceso">
                            <i class="fas fa-search"></i> Ver Documentos
                        </button>
                    </div>
                </div>
       }
               
            </div>

            <!-- Modal para mostrar la tabla -->
            @if (!string.IsNullOrEmpty(tablaVisible))
            {
                <div class="modal-overlay" @onclick="CerrarTabla">
                    <div class="modal-content" @onclick:stopPropagation="true">
                        <div class="modal-header">
                            <h3>📊 @(tablaVisible switch {
                                "investigaciones" => "Proyectos de Investigación",
                                "articulos" => "Artículos Científicos", 
                                "experiencias" => "Experiencia Laboral",
                                "evaluaciones" => "Evaluaciones Docentes",
                                "cursos" => "Cursos y Capacitaciones",
                                "tesis" => "Tesis Dirigidas",
                                _ => "Documentos"
                            })</h3>
                            <button class="modal-close-btn" @onclick="CerrarTabla">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="modal-body">
                            <Tabla TipoDocumento="@tablaVisible" 
                                   Cedula="@cedula" 
                                   OnImportar="ImportarDocumentos" 
                                   OnAgregar="AbrirModalAgregar"
                                   OnCerrar="@(async () => await CerrarTabla())"
                                   OnDocumentosActualizados="ActualizarRequisitosAutomaticamente" />
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CerrarTabla">
                                <i class="fas fa-times"></i> Cerrar
                            </button>
                            <button class="btn btn-primary" @onclick="() => AbrirModalAgregar(tablaVisible)">
                                <i class="fas fa-plus"></i> Agregar @(tablaVisible.TrimEnd('s'))
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Modal para agregar documento -->
            @if (!string.IsNullOrEmpty(tipoDocumentoAgregar))
            {
                <div class="add-modal-overlay" @onclick="CerrarModalAgregar">
                    <div class="add-modal-content" @onclick:stopPropagation="true">
                        <div class="add-modal-header">
                            <h3>
                                <i class="fas @(GetIconoTipoDocumento(tipoDocumentoAgregar))"></i>
                                Agregar @(GetNombreTipoDocumento(tipoDocumentoAgregar))
                            </h3>
                            <button class="add-modal-close-btn" @onclick="CerrarModalAgregar">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="add-modal-body">
                            @if (cargandoModalAgregar)
                            {
                                <div class="loading-iframe">
                                    <i class="fas fa-spinner"></i>
                                    Cargando formulario...
                                </div>
                            }
                            else
                            {
                                <iframe src="@GetUrlAgregarDocumento(tipoDocumentoAgregar)" 
                                        class="iframe-container"
                                        @onload="OnIframeLoaded"></iframe>
                            }
                        </div>
                        <div class="add-modal-footer">
                            <button class="btn btn-secondary" @onclick="CerrarModalAgregar">
                                <i class="fas fa-times"></i> Cerrar
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (operacionEnProceso)
            {
                <div class="alert alert-info">
                    <strong>Procesando...</strong> @mensajeProceso
                </div>
            }

            <!-- Sección de Enváo de Solicitud -->
            @if (!string.IsNullOrEmpty(solicitudId))
            {
                <div class="submission-section">
                    <div class="submission-card">
                        <h2>­Enviar Solicitud de Ascenso</h2>
                        <p class="submission-description">
                            Una vez que haya agregado todos sus documentos, puede enviar su solicitud de ascenso para revisión.
                        </p>

                        @if (tieneDocumentosCompletos)
                        {
                            <div class="alert alert-success">
                                ✅ Su solicitud tiene documentos en todas las categoráas requeridas.
                            </div>

                            <!-- Botón para verificar requisitos del rango -->
                            @if (!mostrarDetallesRequisitos)
                            {
                                <div class="verification-actions" style="margin: 1.5rem 0;">
                                    <button class="btn btn-primary btn-large" @onclick="VerificarRequisitos" disabled="@operacionEnProceso">
                                        @if (operacionEnProceso)
                                        {
                                            <span><i class="fas fa-spinner fa-spin"></i> Verificando requisitos...</span>
                                        }
                                        else
                                        {
                                            <span><i class="fas fa-check-circle"></i> Verificar Requisitos del Rango</span>
                                        }
                                    </button>
                                    <p class="help-text">Verifique si cumple con todos los requisitos para su rango antes de enviar la solicitud</p>
                                </div>
                            }

                            @if (mostrarDetallesRequisitos && requisitosInfo != null)
                            {
                                <div class="requirements-details">
                                    <h4>📋 Verificación de Requisitos para @requisitosInfo.RangoSolicitado</h4>
                                    
                                    @if (requisitosInfo.CumpleRequisitos)
                                    {
                                        <div class="alert alert-success">
                                            ✅ <strong>Cumple todos los requisitos!</strong> Su solicitud está lista para envío.
                                        </div>
                                        
                                        <div class="requirements-summary">
                                            <div class="requirement-item">
                                                <span class="label">­Artículos:</span>
                                                <span class="value success">@requisitosInfo.ValoresActuales!.Articulos / @requisitosInfo.ValoresRequeridos!.Articulos ✅</span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Experiencia:</span>
                                                <span class="value success">@requisitosInfo.ValoresActuales.AniosExperiencia años / @requisitosInfo.ValoresRequeridos.AniosExperiencia años ✅</span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Cursos:</span>
                                                <span class="value success">@requisitosInfo.ValoresActuales.HorasCursos h / @requisitosInfo.ValoresRequeridos.HorasCursos h ✅</span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Investigación:</span>
                                                <span class="value success">@requisitosInfo.ValoresActuales.MesesInvestigacion meses / @requisitosInfo.ValoresRequeridos.MesesInvestigacion meses ✅</span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Evaluaciones:</span>
                                                <span class="value success">@requisitosInfo.ValoresActuales.PromedioEvaluaciones% / @requisitosInfo.ValoresRequeridos.PromedioEvaluaciones% ✅</span>
                                            </div>
                                            @if (RangoRequiereTesis())
                                            {
                                                <div class="requirement-item">
                                                    <span class="label">📚 Tesis Dirigidas:</span>
                                                    <span class="value success">@requisitosInfo.ValoresActuales.TesisDirigidas / @requisitosInfo.ValoresRequeridos.TesisDirigidas ✅</span>
                                                </div>
                                            }
                                        </div>

                                        @if (solicitudEnviada)
                                        {
                                            <div class="alert alert-info" style="margin-bottom: 15px;">
                                                <i class="fas fa-info-circle"></i> 
                                                <strong>Solicitud enviada:</strong> Esta solicitud ya ha sido enviada para aprobación. Recibirá una notificación por correo electrónico cuando sea procesada.
                                            </div>
                                        }

                                        <div class="submission-actions">
                                            <button class="btn btn-success btn-large" 
                                                    @onclick="EnviarSolicitud" 
                                                    disabled="@(enviandoSolicitud || solicitudEnviada)"
                                                    title="@(solicitudEnviada ? "Esta solicitud ya ha sido enviada" : "Enviar su solicitud de ascenso")">
                                                @if (enviandoSolicitud)
                                                {
                                                    <span><i class="fas fa-spinner fa-spin"></i> Enviando solicitud...</span>
                                                }
                                                else if (solicitudEnviada)
                                                {
                                                    <span><i class="fas fa-check-circle"></i> Solicitud Enviada</span>
                                                }
                                                else
                                                {
                                                    <span><i class="fas fa-paper-plane"></i> Enviar Solicitud de Ascenso</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger">
                                            ❌ <strong>No cumple los requisitos mínimos</strong> para el rango solicitado.
                                        </div>
                                        
                                        <div class="requirements-summary">
                                            <div class="requirement-item">
                                                <span class="label">­Artículos:</span>
                                                <span class="value @(requisitosInfo.ValoresActuales!.Articulos >= requisitosInfo.ValoresRequeridos!.Articulos ? "success" : "error")">
                                                    @requisitosInfo.ValoresActuales.Articulos / @requisitosInfo.ValoresRequeridos.Articulos 
                                                    @(requisitosInfo.ValoresActuales.Articulos >= requisitosInfo.ValoresRequeridos.Articulos ? "✅" : "❌")
                                                </span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Experiencia:</span>
                                                <span class="value @((requisitosInfo.ValoresActuales.AniosExperiencia >= (requisitosInfo.ValoresRequeridos.AniosExperiencia - 0.1m)) ? "success" : "error")">
                                                    @requisitosInfo.ValoresActuales.AniosExperiencia años / @requisitosInfo.ValoresRequeridos.AniosExperiencia años 
                                                    @((requisitosInfo.ValoresActuales.AniosExperiencia >= (requisitosInfo.ValoresRequeridos.AniosExperiencia - 0.1m)) ? "✅" : "❌")
                                                </span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Cursos:</span>
                                                <span class="value @(requisitosInfo.ValoresActuales.HorasCursos >= requisitosInfo.ValoresRequeridos.HorasCursos ? "success" : "error")">
                                                    @requisitosInfo.ValoresActuales.HorasCursos h / @requisitosInfo.ValoresRequeridos.HorasCursos h 
                                                    @(requisitosInfo.ValoresActuales.HorasCursos >= requisitosInfo.ValoresRequeridos.HorasCursos ? "✅" : "❌")
                                                </span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Investigación:</span>
                                                <span class="value @(requisitosInfo.ValoresActuales.MesesInvestigacion >= requisitosInfo.ValoresRequeridos.MesesInvestigacion ? "success" : "error")">
                                                    @requisitosInfo.ValoresActuales.MesesInvestigacion meses / @requisitosInfo.ValoresRequeridos.MesesInvestigacion meses 
                                                    @(requisitosInfo.ValoresActuales.MesesInvestigacion >= requisitosInfo.ValoresRequeridos.MesesInvestigacion ? "✅" : "❌")
                                                </span>
                                            </div>
                                            <div class="requirement-item">
                                                <span class="label">­Evaluaciones:</span>
                                                <span class="value @(requisitosInfo.ValoresActuales.PromedioEvaluaciones >= requisitosInfo.ValoresRequeridos.PromedioEvaluaciones ? "success" : "error")">
                                                    @requisitosInfo.ValoresActuales.PromedioEvaluaciones% / @requisitosInfo.ValoresRequeridos.PromedioEvaluaciones% 
                                                    @(requisitosInfo.ValoresActuales.PromedioEvaluaciones >= requisitosInfo.ValoresRequeridos.PromedioEvaluaciones ? "✅" : "❌")
                                                </span>
                                            </div>
                                            @if (RangoRequiereTesis())
                                            {
                                                <div class="requirement-item">
                                                    <span class="label">📚 Tesis Dirigidas:</span>
                                                    <span class="value @(requisitosInfo.ValoresActuales.TesisDirigidas >= requisitosInfo.ValoresRequeridos.TesisDirigidas ? "success" : "error")">
                                                        @requisitosInfo.ValoresActuales.TesisDirigidas / @requisitosInfo.ValoresRequeridos.TesisDirigidas 
                                                        @(requisitosInfo.ValoresActuales.TesisDirigidas >= requisitosInfo.ValoresRequeridos.TesisDirigidas ? "✅" : "❌")
                                                    </span>
                                                </div>
                                            }
                                        </div>

                                        <div class="missing-requirements">
                                            <h5>Requisitos faltantes:</h5>
                                            <ul>
                                                @foreach (var requisito in requisitosInfo.RequisitosFaltantes ?? new List<string>())
                                                {
                                                    <li>@requisito</li>
                                                }
                                            </ul>
                                        </div>

                                        <div class="submission-actions">
                                            <button class="btn btn-secondary btn-large" disabled>
                                                ­No se puede enviar (Requisitos faltantes)
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                Su solicitud aún no está completa. Necesita agregar documentos en las siguientes categorías:
                                <ul class="missing-docs-list">
                                    @if (conteoInvestigaciones == 0) { <li>Investigaciones</li> }
                                    @if (conteoArticulos == 0) { <li>Artículos</li> }
                                    @if (conteoExperiencias == 0) { <li>Experiencia Laboral</li> }
                                    @if (conteoEvaluaciones == 0) { <li>Evaluaciones</li> }
                                    @if (conteoCursos == 0) { <li>Cursos</li> }
                                    @if (conteoTesis == 0 && RangoRequiereTesis()) { <li>Tesis Dirigidas</li> }
                                </ul>
                            </div>
                            <div class="submission-actions">
                                <button class="btn btn-secondary btn-large" disabled>
                                    ­Enviar Solicitud de Ascenso
                                </button>
                                <p class="help-text">Complete todos los documentos requeridos para habilitar el envío</p>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <img src="/images/triangulos.jpg" alt="Background Graphic" class="triangle-bg" />
</body>

@code {
    // Variables para información del usuario
    private string nombreUsuario = "";
    private string nombreCompleto = "";
    private string cedula = "";
    private string urlFotoPerfil = "/images/IconoUser.png";
    private string? tablaVisible = null;

    // Variables para modal de agregar documento
    private string? tipoDocumentoAgregar = null;
    private bool cargandoModalAgregar = false;

    // Variables de conteo de documentos
    private int conteoInvestigaciones = 0;
    private int conteoArticulos = 0;
    private int conteoExperiencias = 0;
    private int conteoEvaluaciones = 0;
    private int conteoCursos = 0;

    // Variables de estado
    private bool isLoading = true;
    private bool operacionEnProceso = false;
    private bool operacionExitosa = false;
    private string? mensajeOperacion;
    private string mensajeProceso = "";

    // Variables para enváo de solicitud
    private string? solicitudId;
    private bool tieneDocumentosCompletos = false;
    private bool enviandoSolicitud = false;
    private bool solicitudEnviada = false;
    private int conteoTesis = 0;
    
    // Variables para verificación de requisitos
    private bool mostrarDetallesRequisitos = false;
    private VerificacionRequisitosResponse? requisitosInfo;
    private string? tipoDocumentoSeleccionado;
    private string? rangoSolicitado;

    // Variable para detectar cuando el usuario regresa a la p├ígina
    private bool hasCargadoContadores = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarInformacionUsuario();
        await VerificarSolicitudActiva();
        await CargarConteoDocumentos();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        
        // Si no es el primer render y aún no se han cargado los contadores,
        // significa que el usuario regresó a la p├ígina
        if (!firstRender && !hasCargadoContadores)
        {
            await CargarConteoDocumentos();
            hasCargadoContadores = true;
            StateHasChanged();
        }
        else if (firstRender)
        {
            hasCargadoContadores = true;
        }
    }

    private async Task VerificarSolicitudActiva()
    {
        try
        {
            solicitudId = await SolicitudService.GetSolicitudActualAsync();
            if (string.IsNullOrEmpty(solicitudId))
            {
                // No hay solicitud activa, mostrar mensaje informativo
                mensajeOperacion = "ÔÜá´©Å No hay una solicitud de ascenso activa. Inicie un proceso de ascenso para gestionar documentos.";
                operacionExitosa = false;
            }
            else
            {
                // Obtener información adicional de la solicitud incluyendo el rango solicitado
                await ObtenerInformacionSolicitud();
            }
        }
        catch (Exception)
        {
            // Silenciar errores
        }
    }

    private async Task ObtenerInformacionSolicitud()
    {
        try
        {
            var response = await Http.GetAsync($"api/auth/solicitud-info/{solicitudId}");
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var solicitudInfo = JsonSerializer.Deserialize<JsonElement>(jsonString);
                
                if (solicitudInfo.TryGetProperty("rangoSolicitado", out var rangoElement))
                {
                    rangoSolicitado = rangoElement.GetString();
                }
                
                // Verificar estado de la solicitud
                if (solicitudInfo.TryGetProperty("estado", out var estadoElement))
                {
                    string? estado = estadoElement.GetString();
                    solicitudEnviada = estado == "Enviada" || estado == "En_Revision" || estado == "Aprobada" || estado == "Rechazada";
                    Console.WriteLine($"Debug - Estado de solicitud: {estado}, Enviada: {solicitudEnviada}");
                }
            }
        }
        catch (Exception)
        {
            // Silenciar errores - no es crático
        }
    }

    private void VerificarDocumentosCompletos()
    {
        bool requiereTesis = RangoRequiereTesis();
        
        tieneDocumentosCompletos = conteoInvestigaciones > 0 && 
                                 conteoArticulos > 0 && 
                                 conteoExperiencias > 0 && 
                                 conteoEvaluaciones > 0 && 
                                 conteoCursos > 0 &&
                                 (requiereTesis ? conteoTesis > 0 : true);
    }

    private async Task VerificarRequisitos()
    {
        if (string.IsNullOrEmpty(solicitudId))
            return;

        try
        {
            operacionEnProceso = true;
            mensajeProceso = "Verificando requisitos del rango...";
            StateHasChanged();

            var response = await Http.GetAsync($"api/auth/verificar-requisitos/{solicitudId}");
            
            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Debug - JSON respuesta verificar requisitos: {jsonContent}");
                
                var result = await response.Content.ReadFromJsonAsync<VerificacionRequisitosResponse>();
                
                if (result?.Success == true)
                {
                    Console.WriteLine($"Debug - Valores requeridos: MesesInvestigacion={result.ValoresRequeridos?.MesesInvestigacion}");
                    Console.WriteLine($"Debug - Valores actuales: MesesInvestigacion={result.ValoresActuales?.MesesInvestigacion}");
                    
                    requisitosInfo = result;
                    mostrarDetallesRequisitos = true;
                    mensajeOperacion = "✅ Verificación de requisitos completada";
                    operacionExitosa = true;
                }
                else
                {
                    mensajeOperacion = "❌ Error al verificar los requisitos. Intente nuevamente.";
                    operacionExitosa = false;
                }
            }
            else
            {
                mensajeOperacion = "❌ Error al verificar los requisitos. Intente nuevamente.";
                operacionExitosa = false;
            }
        }
        catch (Exception ex)
        {
            mensajeOperacion = $"❌ Error al verificar requisitos: {ex.Message}";
            operacionExitosa = false;
        }
        finally
        {
            operacionEnProceso = false;
            StateHasChanged();
            
            // Limpiar mensaje después de 3 segundos
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                mensajeOperacion = null;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task EnviarSolicitud()
    {
        if (enviandoSolicitud || string.IsNullOrEmpty(solicitudId))
            return;

        enviandoSolicitud = true;

        try
        {
            // PASO 1: Verificar requisitos antes de enviar
            var verificacionResponse = await Http.GetAsync($"api/auth/verificar-requisitos/{solicitudId}");
            
            if (verificacionResponse.IsSuccessStatusCode)
            {
                var verificacionResult = await verificacionResponse.Content.ReadFromJsonAsync<VerificacionRequisitosResponse>();
                
                if (verificacionResult?.Success == true)
                {
                    if (!verificacionResult.CumpleRequisitos)
                    {
                        // No cumple los requisitos, mostrar detalles
                        var requisitosFaltantes = string.Join("; ", verificacionResult.RequisitosFaltantes ?? new List<string>());
                        mensajeOperacion = $"❌ No se puede enviar la solicitud. Requisitos faltantes: {requisitosFaltantes}";
                        operacionExitosa = false;
                        mostrarDetallesRequisitos = true;
                        requisitosInfo = verificacionResult;
                        enviandoSolicitud = false;
                        return;
                    }
                }
                else
                {
                    mensajeOperacion = "❌ Error al verificar requisitos. Intente nuevamente.";
                    operacionExitosa = false;
                    enviandoSolicitud = false;
                    return;
                }
            }
            else
            {
                mensajeOperacion = "❌ Error al verificar requisitos. Intente nuevamente.";
                operacionExitosa = false;
                enviandoSolicitud = false;
                return;
            }

            // PASO 2: Si cumple los requisitos, proceder con el enváo
            var response = await Http.PostAsync($"api/auth/enviar-solicitud/{solicitudId}", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<EnvioSolicitudResponse>();
                
                if (result?.Success == true)
                {
                    mensajeOperacion = "✅ Solicitud enviada exitosamente. Su solicitud está ahora en revisión.";
                    operacionExitosa = true;
                    
                    // Limpiar la solicitud actual del servicio
                    await SolicitudService.ClearSolicitudActualAsync();
                    
                    // Mostrar SweetAlert de confirmación
                    await JSRuntime.InvokeVoidAsync("Swal.fire", 
                        new {
                            title = "¡Solicitud Enviada!",
                            text = "Su solicitud fue enviada con éxito. Le llegará la notificación de la aprobación de su ascenso por correo electrónico.",
                            icon = "success",
                            confirmButtonText = "Aceptar",
                            confirmButtonColor = "#0a1d44"
                        });
                    
                    // Redirigir al dashboard
                    Navigation.NavigateTo("/dashboard");
                }
                else
                {
                    mensajeOperacion = $"❌ Error: {result?.Message ?? "No se pudo enviar la solicitud"}";
                    operacionExitosa = false;
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                var errorResult = System.Text.Json.JsonSerializer.Deserialize<EnvioSolicitudResponse>(errorContent);
                
                mensajeOperacion = $"❌ Error al enviar solicitud: {errorResult?.Message ?? "Error desconocido"}";
                operacionExitosa = false;
            }
        }
        catch (Exception ex)
        {
            mensajeOperacion = $"❌ Error al enviar solicitud: {ex.Message}";
            operacionExitosa = false;
        }
        finally
        {
            enviandoSolicitud = false;
            StateHasChanged();
            
            // Limpiar mensaje después de 5 segundos si no fue exitoso
            if (!operacionExitosa)
            {
                _ = Task.Delay(5000).ContinueWith(_ => 
                {
                    mensajeOperacion = null;
                    InvokeAsync(StateHasChanged);
                });
            }
        }
    }

