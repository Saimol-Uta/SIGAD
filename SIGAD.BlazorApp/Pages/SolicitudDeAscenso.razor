@page "/solicitud-de-ascenso"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@using SIGAD.BlazorApp.Layout
@using SIGAD.BlazorApp.Services
@attribute [Layout(typeof(EmptyLayout))]
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject ISolicitudService SolicitudService

<div class="contenedor">
    <h2>Solicitud de Ascenso</h2>

    <div class="tarjeta-evidencia" style="--color:#531e2d;">
        <span>Cursos</span>
        <button class="boton">Gestionar</button>
    </div>

    <div class="tarjeta-evidencia" style="--color:#531e2d;">
        <span>Evaluación</span>
        <button class="boton">Gestionar</button>
    </div>

    <div class="tarjeta-evidencia" style="--color:#531e2d;">
        <span>Investigaciones</span>
        <button class="boton">Gestionar</button>
    </div>

    <div class="tarjeta-evidencia" style="--color:#531e2d;">
        <span>Artículos</span>
        <button class="boton">Gestionar</button>
    </div>

    <div class="tarjeta-evidencia" style="--color:#91022b;">
        <span>Historiales</span>
        <button class="boton">Gestionar</button>
    </div>
</div>

<style>
    .contenedor {
        padding: 2rem;
        background-color: white;
    }

    h2 {
        color: #91022b;
        margin-bottom: 1.5rem;
    }

    .tarjeta-evidencia {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: var(--color);
        color: white;
        padding: 1rem 1.5rem;
        margin-bottom: 1rem;
        border-radius: 5px;
    }

    .boton {
        background-color: #d4004a;
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .boton:hover {
            background-color: #a0012a;
    }
</style>
