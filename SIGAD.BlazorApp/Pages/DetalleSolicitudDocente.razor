@page "/docente/solicitud/{solicitudId}"
@using SIGAD.BlazorApp.Layout
@attribute [Layout(typeof(EmptyLayout))]
@using SIGAD.BlazorApp.Models
@using SIGAD.BlazorApp.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@inject ISolicitudesService SolicitudesService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="page-wrapper">
    <div class="admin-dashboard">
        <div class="main-content">
            <!-- ENCABEZADO -->
            <div class="header-section">
                <div class="header-left">
                    <h2>Detalle de Solicitud</h2>
                    <p class="subtitle">Información completa de su solicitud de ascenso</p>
                </div>
                <div class="header-right">
                    <button class="btn-volver" @onclick="VolverAlHistorial">
                        <i class="fas fa-arrow-left"></i> Volver al Historial
                    </button>
                </div>
            </div>

            @if (cargando)
            {
                <div class="loading-container">
                    <div>Cargando detalles de la solicitud...</div>
                    <div class="spinner"></div>
                </div>
            }
            else if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="error-message">
                    <strong>Error:</strong> @mensajeError
                    <button @onclick="CargarDetalle" class="btn-reintentar">
                        Reintentar
                    </button>
                </div>
            }
            else if (solicitud != null)
            {
                <!-- INFORMACIÓN GENERAL -->
                <div class="detalle-card">
                    <div class="card-header">
                        <h3><i class="fas fa-info-circle"></i> Información General</h3>
                        <span class="estado-badge @GetEstadoClass(solicitud.Estado)">
                            @GetEstadoDisplay(solicitud.Estado)
                        </span>
                    </div>
                    <div class="card-content">
                        <div class="info-grid">
                            <div class="info-item">
                                <label>ID de Solicitud:</label>
                                <span>@solicitud.Id</span>
                            </div>
                            <div class="info-item">
                                <label>Rango Actual:</label>
                                <span>@(solicitud.RangoActualNombre ?? "N/A")</span>
                            </div>
                            <div class="info-item">
                                <label>Rango Solicitado:</label>
                                <span>@solicitud.RangoSolicitadoNombre</span>
                            </div>
                            <div class="info-item">
                                <label>Fecha de Envío:</label>
                                <span>@(solicitud.FechaEnvio?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
                            </div>
                            <div class="info-item">
                                <label>Fecha de Creación:</label>
                                <span>@solicitud.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @if (solicitud.FechaResolucion.HasValue)
                            {
                                <div class="info-item">
                                    <label>Fecha de Resolución:</label>
                                    <span>@solicitud.FechaResolucion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- DOCUMENTOS PRESENTADOS -->
                <div class="detalle-card">
                    <div class="card-header">
                        <h3><i class="fas fa-folder-open"></i> Documentos Presentados</h3>
                    </div>
                    <div class="card-content">
                        @if (solicitud.ArticulosPresentados.Any() || 
                             solicitud.InvestigacionesPresentadas.Any() || 
                             solicitud.CursosPresentados.Any() || 
                             solicitud.ExperienciasLaborales.Any() || 
                             solicitud.EvaluacionesDocente.Any() || 
                             solicitud.TesisDirigidas.Any())
                        {
                            <!-- Artículos -->
                            @if (solicitud.ArticulosPresentados.Any())
                            {
                                <div class="documento-seccion">
                                    <h4><i class="fas fa-file-alt"></i> Artículos Científicos (@solicitud.ArticulosPresentados.Count)</h4>
                                    <div class="documentos-grid">
                                        @foreach (var articulo in solicitud.ArticulosPresentados)
                                        {
                                            <div class="documento-item">
                                                <div class="documento-info">
                                                    <h5>@articulo.Titulo</h5>
                                                    <p><strong>Revista:</strong> @articulo.Revista</p>
                                                    <p><strong>Año:</strong> @articulo.AnioPublicacion</p>
                                                    @if (!string.IsNullOrEmpty(articulo.DOI))
                                                    {
                                                        <p><strong>DOI:</strong> @articulo.DOI</p>
                                                    }
                                                </div>
                                                <div class="documento-acciones">
                                                    <button @onclick="@(() => VisualizarPDFDocumento("articulo", articulo.DOI))" class="btn-action btn-view">
                                                        <i class="fas fa-eye"></i> Ver PDF
                                                    </button>
                                                    <button @onclick="@(() => EditarDocumento("articulo", articulo.DOI))" class="btn-action btn-edit">
                                                        <i class="fas fa-edit"></i> Editar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Investigaciones -->
                            @if (solicitud.InvestigacionesPresentadas.Any())
                            {
                                <div class="documento-seccion">
                                    <h4><i class="fas fa-flask"></i> Proyectos de Investigación (@solicitud.InvestigacionesPresentadas.Count)</h4>
                                    <div class="documentos-grid">
                                        @foreach (var investigacion in solicitud.InvestigacionesPresentadas)
                                        {
                                            <div class="documento-item">
                                                <div class="documento-info">
                                                    <h5>@investigacion.Titulo</h5>
                                                    <p><strong>Rol:</strong> @investigacion.RolEnInvestigacion</p>
                                                    <p><strong>Duración:</strong> @investigacion.MesesDeInvestigacion meses</p>
                                                    <p><strong>Fecha Finalización:</strong> @investigacion.FechaFinalizacion.ToString("dd/MM/yyyy")</p>
                                                </div>
                                                <div class="documento-acciones">
                                                    <button @onclick="@(() => VisualizarPDFDocumento("investigacion", investigacion.Id.ToString()))" class="btn-action btn-view">
                                                        <i class="fas fa-eye"></i> Ver PDF
                                                    </button>
                                                    <button @onclick="@(() => EditarDocumento("investigacion", investigacion.Id.ToString()))" class="btn-action btn-edit">
                                                        <i class="fas fa-edit"></i> Editar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Cursos -->
                            @if (solicitud.CursosPresentados.Any())
                            {
                                <div class="documento-seccion">
                                    <h4><i class="fas fa-graduation-cap"></i> Cursos y Capacitaciones (@solicitud.CursosPresentados.Count)</h4>
                                    <div class="documentos-grid">
                                        @foreach (var curso in solicitud.CursosPresentados)
                                        {
                                            <div class="documento-item">
                                                <div class="documento-info">
                                                    <h5>@curso.Nombre</h5>
                                                    <p><strong>Organización:</strong> @curso.NombreOrganizacion</p>
                                                    <p><strong>Duración:</strong> @curso.NumeroHoras horas</p>
                                                    <p><strong>Fecha Finalización:</strong> @curso.FechaFinalizacion.ToString("dd/MM/yyyy")</p>
                                                    <p><strong>Certificado:</strong> @(curso.TieneCertificado ? "Sí" : "No")</p>
                                                </div>
                                                <div class="documento-acciones">
                                                    <button @onclick="@(() => VisualizarPDFDocumento("curso", curso.Id.ToString()))" class="btn-action btn-view">
                                                        <i class="fas fa-eye"></i> Ver PDF
                                                    </button>
                                                    <button @onclick="@(() => EditarDocumento("curso", curso.Id.ToString()))" class="btn-action btn-edit">
                                                        <i class="fas fa-edit"></i> Editar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Experiencias Laborales -->
                            @if (solicitud.ExperienciasLaborales.Any())
                            {
                                <div class="documento-seccion">
                                    <h4><i class="fas fa-briefcase"></i> Experiencia Laboral (@solicitud.ExperienciasLaborales.Count)</h4>
                                    <div class="documentos-grid">
                                        @foreach (var experiencia in solicitud.ExperienciasLaborales)
                                        {
                                            <div class="documento-item">
                                                <div class="documento-info">
                                                    <h5>@experiencia.Cargo</h5>
                                                    <p><strong>Organización:</strong> @experiencia.OrganizacionNombre</p>
                                                    <p><strong>Tipo:</strong> @experiencia.OrganizacionTipo</p>
                                                    <p><strong>Período:</strong> @experiencia.PeriodoTrabajo</p>
                                                </div>
                                                <div class="documento-acciones">
                                                    <button @onclick="@(() => VisualizarPDFDocumento("experiencia", experiencia.Id.ToString()))" class="btn-action btn-view">
                                                        <i class="fas fa-eye"></i> Ver PDF
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Evaluaciones Docente -->
                            @if (solicitud.EvaluacionesDocente.Any())
                            {
                                <div class="documento-seccion">
                                    <h4><i class="fas fa-star"></i> Evaluaciones Docente (@solicitud.EvaluacionesDocente.Count)</h4>
                                    <div class="documentos-grid">
                                        @foreach (var evaluacion in solicitud.EvaluacionesDocente)
                                        {
                                            <div class="documento-item">
                                                <div class="documento-info">
                                                    <h5>Evaluación @evaluacion.PeriodoAcademico</h5>
                                                    <p><strong>Puntaje:</strong> @evaluacion.PuntajeFormateado</p>
                                                    <p><strong>Fecha:</strong> @evaluacion.FechaEvaluacion.ToString("dd/MM/yyyy")</p>
                                                </div>
                                                <div class="documento-acciones">
                                                    <button @onclick="@(() => VisualizarPDFDocumento("evaluacion", evaluacion.Id.ToString()))" class="btn-action btn-view">
                                                        <i class="fas fa-eye"></i> Ver PDF
                                                    </button>
                                                    <button @onclick="@(() => EditarDocumento("evaluacion", evaluacion.Id.ToString()))" class="btn-action btn-edit">
                                                        <i class="fas fa-edit"></i> Editar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Tesis Dirigidas -->
                            @if (solicitud.TesisDirigidas.Any())
                            {
                                <div class="documento-seccion">
                                    <h4><i class="fas fa-book"></i> Tesis Dirigidas (@solicitud.TesisDirigidas.Count)</h4>
                                    <div class="documentos-grid">
                                        @foreach (var tesis in solicitud.TesisDirigidas)
                                        {
                                            <div class="documento-item">
                                                <div class="documento-info">
                                                    <h5>@tesis.Titulo</h5>
                                                    <p><strong>Nivel Académico:</strong> @tesis.Nivel</p>
                                                    <p><strong>Institución:</strong> @tesis.Institucion</p>
                                                    <p><strong>Estado:</strong> @tesis.Estado</p>
                                                    <p><strong>Período:</strong> @tesis.PeriodoFormateado</p>
                                                </div>
                                                <div class="documento-acciones">
                                                    <button @onclick="@(() => VisualizarPDFDocumento("tesis", tesis.Id.ToString()))" class="btn-action btn-view">
                                                        <i class="fas fa-eye"></i> Ver PDF
                                                    </button>
                                                    <button @onclick="@(() => EditarDocumento("tesis", tesis.Id.ToString()))" class="btn-action btn-edit">
                                                        <i class="fas fa-edit"></i> Editar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-state-icon"><i class="fas fa-folder-open"></i></div>
                                <h3>No hay documentos presentados</h3>
                                <p>Esta solicitud no tiene documentos de evidencia adjuntos.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- OBSERVACIONES Y ESTADO DE EVALUACIÓN -->
                @if (EsSolicitudRechazada() || TieneObservaciones())
                {
                    <div class="detalle-card">
                        <div class="card-header">
                            <h3><i class="fas fa-comments"></i> Observaciones y Evaluación</h3>
                        </div>
                        <div class="card-content">
                            <!-- Observaciones de Comisión -->
                            @if (!string.IsNullOrEmpty(solicitud.ObservacionesComision))
                            {
                                <div class="observacion-item">
                                    <div class="observacion-header">
                                        <h4><i class="fas fa-users"></i> Observaciones de la Comisión</h4>
                                        @if (solicitud.FechaAprobacionComision.HasValue)
                                        {
                                            <span class="fecha-observacion">@solicitud.FechaAprobacionComision.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </div>
                                    <div class="observacion-content">
                                        @solicitud.ObservacionesComision
                                    </div>
                                </div>
                            }

                            <!-- Observaciones de Consejo -->
                            @if (!string.IsNullOrEmpty(solicitud.ObservacionesConsejo))
                            {
                                <div class="observacion-item">
                                    <div class="observacion-header">
                                        <h4><i class="fas fa-university"></i> Observaciones del Consejo</h4>
                                        @if (solicitud.FechaAprobacionConsejo.HasValue)
                                        {
                                            <span class="fecha-observacion">@solicitud.FechaAprobacionConsejo.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </div>
                                    <div class="observacion-content">
                                        @solicitud.ObservacionesConsejo
                                    </div>
                                </div>
                            }

                            <!-- Observaciones del Administrador -->
                            @if (!string.IsNullOrEmpty(solicitud.ObservacionesAdmin))
                            {
                                <div class="observacion-item">
                                    <div class="observacion-header">
                                        <h4><i class="fas fa-user-shield"></i> Observaciones del Administrador</h4>
                                        @if (solicitud.FechaResolucion.HasValue)
                                        {
                                            <span class="fecha-observacion">@solicitud.FechaResolucion.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </div>
                                    <div class="observacion-content">
                                        @solicitud.ObservacionesAdmin
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- BOTÓN DE APELACIÓN (solo para solicitudes rechazadas) -->
                @if (EsSolicitudRechazada() && PuedeApelar())
                {
                    <div class="detalle-card">
                        <div class="card-header">
                            <h3><i class="fas fa-balance-scale"></i> Proceso de Apelación</h3>
                        </div>
                        <div class="card-content">
                            <div class="apelacion-info">
                                <p><strong>Su solicitud ha sido rechazada.</strong> De acuerdo al reglamento universitario, usted tiene derecho a presentar una apelación fundamentada.</p>
                                <p>La apelación debe incluir:</p>
                                <ul>
                                    <li>Motivo detallado de la apelación</li>
                                    <li>Documentos de soporte adicionales (opcional)</li>
                                    <li>Argumentos que justifiquen la revisión de la decisión</li>
                                </ul>
                            </div>
                            <div class="apelacion-acciones">
                                <button @onclick="AbrirModalApelacion" class="btn-primary">
                                    <i class="fas fa-balance-scale"></i> Presentar Apelación
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Modal de Apelación -->
@if (mostrarModalApelacion)
{
    <div class="modal-overlay" @onclick="CerrarModalApelacion">
        <div class="modal-content apelacion-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="fas fa-balance-scale"></i> Presentar Apelación</h3>
                <button @onclick="CerrarModalApelacion" class="btn-close">✕</button>
            </div>
            
            <EditForm Model="@modeloApelacion" OnValidSubmit="@EnviarApelacion">
                <DataAnnotationsValidator />
                
                <div class="modal-body">
                    <div class="form-group">
                        <label for="motivoApelacion" class="form-label">
                            <strong>Motivo de la Apelación *</strong>
                        </label>
                        <textarea @bind="modeloApelacion.Motivo" 
                                  id="motivoApelacion"
                                  class="form-control" 
                                  rows="6" 
                                  placeholder="Explique detalladamente los motivos por los cuales considera que su solicitud debe ser reconsiderada..."
                                  maxlength="2000"></textarea>
                        <ValidationMessage For="@(() => modeloApelacion.Motivo)" />
                        <small class="form-text">@modeloApelacion.Motivo.Length / 2000 caracteres</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <strong>Documentos de Soporte (Opcional)</strong>
                        </label>
                        <InputFile @ref="inputFileApelacion" 
                                   OnChange="@OnFileSelectedApelacion" 
                                   multiple 
                                   accept=".pdf,.doc,.docx,.jpg,.png"
                                   class="form-control" />
                        <small class="form-text">
                            Puede adjuntar documentos adicionales que soporten su apelación. 
                            Formatos permitidos: PDF, DOC, DOCX, JPG, PNG. Máximo 5MB por archivo.
                        </small>
                        
                        @if (archivosApelacion.Any())
                        {
                            <div class="archivos-seleccionados">
                                <h5>Archivos seleccionados:</h5>
                                @foreach (var archivo in archivosApelacion)
                                {
                                    <div class="archivo-item">
                                        <span class="archivo-nombre">@archivo.Name</span>
                                        <span class="archivo-tamaño">(@FormatearTamañoArchivo(archivo.Size))</span>
                                        <button type="button" @onclick="() => RemoverArchivo(archivo)" class="btn-remove">✕</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeErrorApelacion))
                    {
                        <div class="alert alert-danger">
                            @mensajeErrorApelacion
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" @onclick="CerrarModalApelacion" class="btn-secondary">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-primary" disabled="@enviandoApelacion">
                        @if (enviandoApelacion)
                        {
                            <span class="spinner-small"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <i class="fas fa-paper-plane"></i>
                            <span>Enviar Apelación</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal de Visualización de PDF -->
@if (mostrarModalPDF)
{
    <div class="modal-overlay" @onclick="CerrarModalPDF">
        <div class="modal-content pdf-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="fas fa-file-pdf"></i> Visualización de Documento</h3>
                <button @onclick="CerrarModalPDF" class="btn-close">✕</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(urlPDFActual))
                {
                    <iframe src="@urlPDFActual" style="width: 100%; height: 600px; border: none;"></iframe>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-file-pdf"></i></div>
                        <h3>No se pudo cargar el documento</h3>
                        <p>El archivo no está disponible o no se pudo acceder al mismo.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? solicitudId { get; set; }

    private SolicitudDetalleDto? solicitud;
    private bool cargando = true;
    private string mensajeError = "";
    
    // Modal de Apelación
    private bool mostrarModalApelacion = false;
    private bool enviandoApelacion = false;
    private string mensajeErrorApelacion = "";
    private ApelacionModel modeloApelacion = new();
    private List<IBrowserFile> archivosApelacion = new();
    private InputFile? inputFileApelacion;
    
    // Modal de PDF
    private bool mostrarModalPDF = false;
    private string urlPDFActual = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarDetalle();
    }

    private async Task CargarDetalle()
    {
        try
        {
            cargando = true;
            mensajeError = "";

            if (string.IsNullOrEmpty(solicitudId) || !Guid.TryParse(solicitudId, out var guid))
            {
                mensajeError = "ID de solicitud inválido";
                return;
            }

            solicitud = await SolicitudesService.GetSolicitudDetalleAsync(guid);
            
            if (solicitud == null)
            {
                mensajeError = "No se pudo cargar la información de la solicitud";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar los detalles: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void VolverAlHistorial()
    {
        Navigation.NavigateTo("/historial-solicitudes");
    }

    // Métodos de utilidad para estados
    private string GetEstadoClass(string estado)
    {
        return estado.ToLower() switch
        {
            "borrador" => "estado-borrador",
            "enviada" => "estado-enviada",
            "en_revision" => "estado-en-revision",
            "aprobada" => "estado-aprobada",
            "rechazada" => "estado-rechazada",
            "en_apelacion" => "estado-apelacion",
            "aprobada_por_apelacion" => "estado-aprobada",
            "rechazada_definitiva" => "estado-rechazada-definitiva",
            _ => "estado-borrador"
        };
    }

    private string GetEstadoDisplay(string estado)
    {
        return estado switch
        {
            "BORRADOR" => "Borrador",
            "ENVIADA" => "Enviada",
            "EN_REVISION" => "En Revisión",
            "APROBADA" => "Aprobada",
            "RECHAZADA" => "Rechazada",
            "EN_APELACION" => "En Apelación",
            "APROBADA_POR_APELACION" => "Aprobada por Apelación",
            "RECHAZADA_DEFINITIVA" => "Rechazada Definitivamente",
            _ => estado
        };
    }

    private bool EsSolicitudRechazada()
    {
        return solicitud?.Estado.ToUpper() == "RECHAZADA";
    }

    private bool PuedeApelar()
    {
        // Solo se puede apelar si está rechazada pero no definitivamente
        return solicitud?.Estado.ToUpper() == "RECHAZADA";
    }

    private bool TieneObservaciones()
    {
        return !string.IsNullOrEmpty(solicitud?.ObservacionesAdmin) ||
               !string.IsNullOrEmpty(solicitud?.ObservacionesComision) ||
               !string.IsNullOrEmpty(solicitud?.ObservacionesConsejo);
    }

    // Métodos para documentos
    private async Task VisualizarPDF(string rutaArchivo)
    {
        try
        {
            if (string.IsNullOrEmpty(rutaArchivo))
            {
                await JSRuntime.InvokeVoidAsync("alert", "No hay archivo disponible para visualizar.");
                return;
            }

            // Construir la URL completa del archivo
            urlPDFActual = $"/uploads/{rutaArchivo}";
            mostrarModalPDF = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al abrir el documento: {ex.Message}");
        }
    }

    private async Task EditarDocumento(string tipoDocumento, Guid documentoId)
    {
        // Por ahora mostrar mensaje, luego implementar navegación a edición
        await JSRuntime.InvokeVoidAsync("alert", $"Funcionalidad de edición en desarrollo.\nTipo: {tipoDocumento}\nID: {documentoId}");
    }

    private async Task VisualizarCertificado(string tipoDocumento, int documentoId)
    {
        try
        {
