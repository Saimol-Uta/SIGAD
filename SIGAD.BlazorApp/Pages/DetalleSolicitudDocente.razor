    private async Task VisualizarPDFDocumento(string tipoDocumento, string documentoId)
    {
        try
        {
            string? rutaPdf = null;
            string? urlCloudinary = null;

            // Obtener la ruta del PDF según el tipo de documento
            switch (tipoDocumento)
            {
                case "articulo":
                    var articulo = solicitud?.ArticulosPresentados.FirstOrDefault(a => a.DOI == documentoId);
                    if (articulo != null)
                    {
                        rutaPdf = articulo.ArchivoRuta;
                    }
                    break;

                case "investigacion":
                    var investigacion = solicitud?.InvestigacionesPresentadas.FirstOrDefault(i => i.Id.ToString() == documentoId);
                    if (investigacion != null)
                    {
                        rutaPdf = investigacion.InformeRuta;
                    }
                    break;

                case "curso":
                    var curso = solicitud?.CursosPresentados.FirstOrDefault(c => c.Id.ToString() == documentoId);
                    if (curso != null)
                    {
                        rutaPdf = curso.CertificadoRuta;
                    }
                    break;

                case "experiencia":
                    var experiencia = solicitud?.ExperienciasLaborales.FirstOrDefault(e => e.Id.ToString() == documentoId);
                    if (experiencia != null)
                    {
                        rutaPdf = experiencia.CertificadoRuta;
                    }
                    break;

                case "evaluacion":
                    var evaluacion = solicitud?.EvaluacionesDocente.FirstOrDefault(e => e.Id.ToString() == documentoId);
                    if (evaluacion != null)
                    {
                        rutaPdf = evaluacion.InformeRuta;
                    }
                    break;

                case "tesis":
                    var tesis = solicitud?.TesisDirigidas.FirstOrDefault(t => t.Id.ToString() == documentoId);
                    if (tesis != null)
                    {
                        rutaPdf = tesis.CertificacionPath;
                    }
                    break;
            }

            string? urlParaUsar = null;

            // PRIORIDAD 1: Cloudinary URL (si está disponible)
            if (!string.IsNullOrEmpty(urlCloudinary))
            {
                urlParaUsar = urlCloudinary;
            }
            // PRIORIDAD 2: URL local como fallback
            else if (!string.IsNullOrEmpty(rutaPdf))
            {
                // Usar la URL base del HttpClient
                var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "https://localhost:7072";
                
                // Construir la ruta relativa
                var relativePath = rutaPdf.StartsWith("/uploads", StringComparison.OrdinalIgnoreCase)
                    ? rutaPdf
                    : $"/uploads/{rutaPdf.TrimStart('/')}";

                urlParaUsar = $"{baseUrl}{relativePath}";
            }

            if (!string.IsNullOrEmpty(urlParaUsar))
            {
                // Abrir el PDF en una nueva pestaña
                await JSRuntime.InvokeVoidAsync("window.open", urlParaUsar, "_blank");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "No hay PDF disponible para este documento.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al abrir PDF: {ex.Message}");
        }
    }

