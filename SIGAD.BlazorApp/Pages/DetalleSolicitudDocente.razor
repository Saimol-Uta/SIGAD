    // Métodos para apelación
    private void AbrirModalApelacion()
    {
        modeloApelacion = new ApelacionModel();
        archivosApelacion.Clear();
        mensajeErrorApelacion = "";
        mostrarModalApelacion = true;
    }

    private void CerrarModalApelacion()
    {
        mostrarModalApelacion = false;
        modeloApelacion = new ApelacionModel();
        archivosApelacion.Clear();
        mensajeErrorApelacion = "";
    }

    private void OnFileSelectedApelacion(InputFileChangeEventArgs e)
    {
        try
        {
            mensajeErrorApelacion = "";
            
            foreach (var file in e.GetMultipleFiles(5)) // Máximo 5 archivos
            {
                // Validar tamaño (5MB máximo)
                if (file.Size > 5 * 1024 * 1024)
                {
                    mensajeErrorApelacion = $"El archivo '{file.Name}' excede el tamaño máximo de 5MB.";
                    continue;
                }

                // Validar tipo de archivo
                var extensionesPermitidas = new[] { ".pdf", ".doc", ".docx", ".jpg", ".jpeg", ".png" };
                var extension = Path.GetExtension(file.Name).ToLower();
                
                if (!extensionesPermitidas.Contains(extension))
                {
                    mensajeErrorApelacion = $"El archivo '{file.Name}' no tiene un formato permitido.";
                    continue;
                }

                // Evitar duplicados
                if (!archivosApelacion.Any(a => a.Name == file.Name))
                {
                    archivosApelacion.Add(file);
                }
            }
        }
        catch (Exception ex)
        {
            mensajeErrorApelacion = $"Error al seleccionar archivos: {ex.Message}";
        }
    }

    private void RemoverArchivo(IBrowserFile archivo)
    {
        archivosApelacion.Remove(archivo);
    }

    private string FormatearTamañoArchivo(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }

    private async Task EnviarApelacion()
    {
        try
        {
            enviandoApelacion = true;
            mensajeErrorApelacion = "";

            if (string.IsNullOrEmpty(solicitudId) || !Guid.TryParse(solicitudId, out var guid))
            {
                mensajeErrorApelacion = "ID de solicitud inválido";
                return;
            }

            // Validar que hay motivo
            if (string.IsNullOrWhiteSpace(modeloApelacion.Motivo))
            {
                mensajeErrorApelacion = "Debe proporcionar un motivo para la apelación";
                return;
            }

            // Llamar al servicio para enviar la apelación
            var (success, message) = await SolicitudesService.PresentarApelacionAsync(guid, modeloApelacion.Motivo, archivosApelacion);
            
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Apelación enviada exitosamente. Se ha notificado a las autoridades correspondientes.");
                
                // Actualizar estado de la solicitud
                if (solicitud != null)
                {
                    solicitud.Estado = "EN_APELACION";
                }
                
                CerrarModalApelacion();
            }
            else
            {
                mensajeErrorApelacion = message;
            }
        }
        catch (Exception ex)
        {
            mensajeErrorApelacion = $"Error al enviar la apelación: {ex.Message}";
        }
        finally
        {
            enviandoApelacion = false;
        }
    }

    // Función para editar documentos
    private void EditarDocumento(string tipoDocumento, string documentoId)
    {
        try
        {
            string url = "";
            
            switch (tipoDocumento.ToLower())
            {
                case "articulo":
                    // Para artículos, usar el DOI como ID
                    url = $"/editar-articulo/{Uri.EscapeDataString(documentoId)}";
                    break;
                case "investigacion":
                    url = $"/editar-investigacion/{documentoId}";
                    break;
                case "curso":
                    url = $"/editar-curso/{documentoId}";
                    break;
                case "tesis":
                    url = $"/editar-tesis/{documentoId}";
                    break;
                case "evaluacion":
                    url = $"/editar-evaluacion/{documentoId}";
                    break;
                default:
                    Console.WriteLine($"Tipo de documento no soportado para edición: {tipoDocumento}");
                    return;
            }
            
            // Navegar a la página de edición
            Navigation.NavigateTo(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al navegar a edición de {tipoDocumento}: {ex.Message}");
        }
    }

    // Modelo para el formulario de apelación
    public class ApelacionModel
    {
        [Required(ErrorMessage = "El motivo de la apelación es obligatorio")]
        [StringLength(2000, MinimumLength = 50, ErrorMessage = "El motivo debe tener entre 50 y 2000 caracteres")]
        public string Motivo { get; set; } = "";
    }
}

