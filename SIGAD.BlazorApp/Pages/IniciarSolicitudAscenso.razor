    private async Task ReanudarProceso()
    {
        if (solicitudExistente?.SolicitudId == null) return;

        try
        {
            // Guardar el ID de la solicitud existente
            await SolicitudService.SetSolicitudActualAsync(solicitudExistente.SolicitudId);
            
            // Redirigir a gestión de documentos
            Navigation.NavigateTo("/gestion-documentos");
        }
        catch (Exception ex)
        {
            errorMessage = "Error al reanudar el proceso: " + ex.Message;
        }
    }

    private void MostrarConfirmacionCancelar()
    {
        mostrarConfirmacionCancelar = true;
    }

    private void OcultarConfirmacionCancelar()
    {
        mostrarConfirmacionCancelar = false;
    }

    private async Task CancelarSolicitudExistente()
    {
        if (solicitudExistente?.SolicitudId == null) return;

        isSubmitting = true;
        try
        {
            // Llamar al endpoint para cancelar/eliminar la solicitud existente
            var response = await Http.DeleteAsync($"api/solicitudesAscenso/{solicitudExistente.SolicitudId}");
            
            if (response.IsSuccessStatusCode)
            {
                // Limpiar estado
                solicitudExistente = null;
                mostrarConfirmacionCancelar = false;
                errorMessage = null;
                
                // Limpiar servicio de solicitud
                await SolicitudService.ClearSolicitudActualAsync();
                
                // Mostrar mensaje de éxito
                await JSRuntime.InvokeVoidAsync("alert", "Solicitud cancelada exitosamente. Ahora puede crear una nueva solicitud.");
                
                // Permitir crear nueva solicitud
                StateHasChanged();
            }
            else
            {
                errorMessage = "Error al cancelar la solicitud. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cancelar la solicitud: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetAlertClassFromEstado(string estado)
    {
        return estado switch
        {
            "Borrador" => "alert-warning",
            "Enviada" => "alert-info",
            "EnRevision" => "alert-primary",
            "Aprobada" => "alert-success",
            "Rechazada" => "alert-danger",
            _ => "alert-secondary"
        };
    }

    private string GetIconFromEstado(string estado)
    {
        return estado switch
        {
            "Borrador" => "⚠️",
            "Enviada" => "📤",
            "EnRevision" => "🔍",
            "Aprobada" => "✅",
            "Rechazada" => "❌",
            _ => "📋"
        };
    }

    private string GetEstadoDescripcionFrontend(string estado)
    {
        return estado switch
        {
            "Borrador" => "Solicitud en Preparación",
            "Enviada" => "Solicitud Enviada para Revisión",
            "EnRevision" => "Solicitud en Proceso de Evaluación",
            "Aprobada" => "Solicitud Aprobada",
            "Rechazada" => "Solicitud Rechazada",
            _ => "Estado Desconocido"
        };
    }

    private string GetMensajeEstadoFrontend(string estado)
    {
        return estado switch
        {
            "Borrador" => "Tiene una solicitud en preparación. Complete los documentos requeridos y envíela para revisión.",
            "Enviada" => "Su solicitud ha sido enviada y está pendiente de revisión. No puede crear otra solicitud hasta recibir una respuesta.",
            "EnRevision" => "Su solicitud está siendo evaluada por los administradores. No puede crear otra solicitud hasta recibir el resultado.",
            "Aprobada" => "Su anterior solicitud fue aprobada. Puede crear una nueva solicitud para el siguiente nivel.",
            "Rechazada" => "Su anterior solicitud fue rechazada. Puede crear una nueva solicitud después de revisar las observaciones.",
            _ => "Tiene una solicitud activa en el sistema."
        };
    }
