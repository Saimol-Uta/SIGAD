@page "/reestablecer"
@using SIGAD.BlazorApp.Layout
@attribute [Layout(typeof(EmptyLayout))]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation


@code {
    private string correo = "";
    private bool codigoEnviado = false;
    private string mensajeAPI = "";
    private bool enProceso = false;

    private string codigo = "";
    private string mensajeVerificacion = "";
    private bool verificacionExitosa = false;

    private async Task EnviarCodigo()
    {
        if (enProceso || string.IsNullOrWhiteSpace(correo))
            return;

        enProceso = true;
        mensajeAPI = "";

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/solicitar-recuperacion", new { email = correo });
            var result = await response.Content.ReadFromJsonAsync<RespuestaApi>();
            mensajeAPI = result?.Message ?? "Respuesta desconocida.";

            if (response.IsSuccessStatusCode)
            {
                codigoEnviado = true;
            }
        }
        catch
        {
            mensajeAPI = "Error de conexión con el servidor.";
        }

        enProceso = false;
    }

    private async Task VerificarCodigo()
    {
        if (codigo.Length != 6)
        {
            mensajeVerificacion = "Debes ingresar los 6 dígitos del código.";
            verificacionExitosa = false;
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/verificar-codigo", new { Email = correo, Codigo = codigo });

            if (response.IsSuccessStatusCode)
            {
                verificacionExitosa = true;
                Navigation.NavigateTo($"/cambiar-contrasena/{correo}/{codigo}");
            }
            else
            {
                mensajeVerificacion = "El código ingresado es incorrecto o ha expirado.";
                verificacionExitosa = false;
            }
        }
        catch
        {
            mensajeVerificacion = "Error al verificar el código.";
            verificacionExitosa = false;
        }
    }

    public class RespuestaApi
    {
        public string Message { get; set; } = "";
    }
}

<div class="recovery-container">
        <svg class="svg-background" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
        <defs>
            <linearGradient id="grad-dark" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#081631" /><stop offset="100%" stop-color="#0a1d44" /></linearGradient>
            <linearGradient id="grad-medium" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#0a1d44" /><stop offset="100%" stop-color="#0e2c6c" /></linearGradient>
            <linearGradient id="grad-light" x1="50%" y1="0%" x2="50%" y2="100%"><stop offset="0%" stop-color="#1a3a8a" /><stop offset="100%" stop-color="#0e2c6c" /></linearGradient>
        </defs>
        <polygon points="0,0 20,0 10,25" fill="url(#grad-dark)" />
        <polygon points="20,0 45,0 30,20" fill="url(#grad-medium)" />
        <polygon points="45,0 70,0 60,30" fill="url(#grad-dark)" />
        <polygon points="70,0 100,0 85,25" fill="url(#grad-light)" />
        <polygon points="100,0 100,30 85,25" fill="url(#grad-medium)" />
        <polygon points="0,0 0,35 10,25" fill="url(#grad-medium)" />
        <polygon points="10,25 30,20 25,45" fill="url(#grad-light)" />
        <polygon points="30,20 60,30 45,50" fill="url(#grad-dark)" />
        <polygon points="60,30 85,25 70,55" fill="url(#grad-medium)" />
        <polygon points="85,25 100,30 95,50" fill="url(#grad-dark)" />
        <polygon points="0,35 25,45 5,60" fill="url(#grad-dark)" />
        <polygon points="25,45 45,50 35,70" fill="url(#grad-medium)" />
        <polygon points="45,50 70,55 60,80" fill="url(#grad-light)" />
        <polygon points="70,55 95,50 80,75" fill="url(#grad-dark)" />
        <polygon points="95,50 100,65 80,75" fill="url(#grad-medium)" />
        <polygon points="0,100 0,60 5,60" fill="url(#grad-light)" />
        <polygon points="5,60 35,70 20,100" fill="url(#grad-dark)" />
        <polygon points="35,70 60,80 50,100" fill="url(#grad-medium)" />
        <polygon points="60,80 80,75 70,100" fill="url(#grad-dark)" />
        <polygon points="80,75 100,65 90,100" fill="url(#grad-light)" />
        <polygon points="100,65 100,100 90,100" fill="url(#grad-medium)" />
    </svg>

    <div class="recovery-box">
        <div class="logo-container">
            <img src="/images/logoSIGAD.png" class="logo" />
            <span class="logo-text">SIGAD</span>
        </div>

        <h2>REESTABLECER CONTRASEÑA</h2>

        <p class="info-text">Ingresa tu correo electrónico para recuperar tu contraseña</p>

        <input class="input"
               @bind="correo"
               placeholder="Correo electrónico"
               type="email"
               required />

        <button class="btn" @onclick="EnviarCodigo" disabled="@enProceso">
            Enviar Código de recuperación
        </button>

        @if (!string.IsNullOrWhiteSpace(mensajeAPI))
        {
            <p class="api-message">@mensajeAPI</p>
        }

        @if (codigoEnviado)
        {
            <p class="info-text" style="margin-top:1rem;">
                Ingresa el código de 6 dígitos que fue enviado a tu correo
            </p>

            <input class="input-codigo"
                   maxlength="6"
                   @bind="codigo"
                   placeholder="------"
                   inputmode="numeric" />

            <button class="btn" style="margin-top: 1rem;" @onclick="VerificarCodigo">
                Verificar Código
            </button>

            @if (!string.IsNullOrWhiteSpace(mensajeVerificacion))
            {
                <div class="mensaje-verificacion @(verificacionExitosa ? "exito" : "error")">
                    <span class="icono">
                        @(verificacionExitosa ? "✔️" : "❌")
                    </span>
                    <span class="texto">@mensajeVerificacion</span>
                </div>
            }
        }

        <a href="/login" class="volver">Volver</a>
    </div>
</div>


<style>
.input-codigo {
    text-align: center;
    font-size: 1.5rem;
    letter-spacing: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 0.6rem 1rem;
    width: 100%;
    max-width: 300px;
    margin: 1rem auto 0 auto;
    display: block;
    background-color: #f9f9f9;
    color: #1a1a1a;
}

.api-message {
    color: gray;
    margin-top: 1rem;
    text-align: center;
    font-size: 0.95rem;
}

.mensaje-verificacion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    margin-top: 1rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 500;
    max-width: 90%;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.mensaje-verificacion.exito {
    background-color: #e6f7ed;
    color: #207544;
    border: 1px solid #a3d7b4;
}

.mensaje-verificacion.error {
    background-color: #fdecea;
    color: #d93025;
    border: 1px solid #f5c6cb;
}

.mensaje-verificacion .icono {
    font-size: 1.4rem;
}

.mensaje-verificacion .texto {
    flex: 1;
}

.recovery-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #0a1d44; /* Cambia el fondo */
    position: relative; /* Añade esto */
    overflow: hidden; /* Añade esto para asegurar que el SVG no se desborde */
    /* Las propiedades de 'animation' y 'background-size' ya no son necesarias */
}

.svg-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1; /* Para que esté detrás de todo */
    opacity: 0.85;
}

.recovery-box {
    background-color: white;
    padding: 3rem;
    width: 700px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.08);
    position: relative;
    border-radius: 0.2rem;
    text-align: center;
        z-index: 2; /* Asegura que la caja esté sobre el SVG */

}

.recovery-box h2 {
    font-size: 24px;
    color: #0a1d44;
    margin-bottom: 4rem;
}
.logo-container {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    margin-bottom: 10px;
}

.logo {
    width: 35px;
    height: 35px;
}

.logo-text {
    font-size: 16px;
    color: #0a1d44;
}
.info-text {
    text-align: left;
    color: #999;
    font-size: 0.95rem;
    margin: 55px 0 0px 2px;
}
.input {
    width: 100%;
    padding: 0.8rem;
    margin: 10px 0;
    border: 1px solid #ccc;
    border-radius: 5px;
}

.btn {
    width: 60%;
    background-color: #0a1d44;
    color: white;
    border: none;
    padding: 0.8rem;
    border-radius: 5px;
    cursor: pointer;
    margin-bottom: 1rem;
    margin-top: 1rem;

}
.btn:hover {
                background-color: #0e2c6c;
                color: white;

}

.codigo-box {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 1rem;
    flex-wrap: nowrap;
}

.code-input {
    width: 40px;
    height: 50px;
    text-align: center;
    font-size: 1rem;
    border: 1px solid #ccc;
    border-radius: 5px;
    background-color : gainsboro;
}

.volver {
    position: absolute;
    top: 50px;
    right: 50px;
    color: #888;
    font-size: 0.9rem;
    text-decoration: none;
}



</style>
