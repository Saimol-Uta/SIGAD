@page "/detalles-promocion"
@inject IDocumentoService DocumentoService

<h3>Avance de Promoción</h3>
<p>Etapa 3 de 5 – 60%</p>
<div class="progress-bar mb-4">
    <div class="progress" style="width: 60%; height: 5px; background-color: #4f46e5;"></div>
</div>

<div class="etapas-container">
    @foreach (var etapa in Enumerable.Range(1, 5))
    {
        <div class="etapa-card">
            <h5>@etapa. @TituloEtapa(etapa)</h5>
            @foreach (var doc in Documentos.Where(d => d.Etapa == etapa))
            {
                <div class="doc-card">
                    <span class="estado @GetEstadoClase(doc.Estado)">
                        @doc.Estado.ToUpper()
                    </span>
                    <div class="nombre">@doc.Nombre</div>
                    <a href="@doc.Url" target="_blank">Ver/descargar</a>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    private List<Documento> Documentos = new();

    protected override async Task OnInitializedAsync()
    {
        Documentos = await DocumentoService.ObtenerDocumentosPorSolicitudAsync(SolicitudId);
    }

    private string TituloEtapa(int etapa) => etapa switch
    {
        1 => "Postulación",
        2 => "Revisión de Documentos",
        3 => "Evaluación de Comité",
        4 => "Documentos Finales",
        5 => "Aprobación Final",
        _ => "Etapa Desconocida"
    };

    private string GetEstadoClase(string estado) => estado switch
    {
        "Aprobado" => "estado-aprobado",
        "En Revisión" => "estado-revision",
        "Reprobado" => "estado-reprobado",
        "Sin Revisar" => "estado-sinrevisar",
        _ => "estado-desconocido"
    };
}
