@page "/counter"
@page "/promotion-detail"

<h2>Promotion Progress</h2>
<p>Step 1 of 4 - 25%</p>

<div class="progress-bar">
    <div class="progress" style="width: 25%;"></div>
</div>

<div class="step-grid">
    @foreach (var step in Steps)
    {
        <PromotionDetailStep Step="step" />
    }
</div>

