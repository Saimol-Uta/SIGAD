        .nav-item.active {
            background-color: #112855;
        }

    .main-content {
        flex: 1;
        padding: 30px 40px;
        background-color: #f9f9f9;
    }

    .btn-añadir, .select-documento, .btn-continuar {
        background-color: #0a1d44;
        color: white;
        padding: 12px 18px;
        border-radius: 4px;
    }

    .btn-añadir, .btn-continuar {
        width: 150px;
        text-decoration: none;
    }

    .btn-continuar {
        cursor: pointer;
        width: 200px;
    }

        .btn-continuar::after {
            content: '➔';
            font-weight: bold;
            color: white;
            margin-left: 10px;
        }


    .select-documento {
        width: 175px;
        cursor: pointer;
    }

    .select-documento option {
        background-color:white;
        color: #0a1d44;

    }

    .bloque-izquierdo {
        display: flex;
        align-items: center;
        gap: 60px;
    }

    .bloque-izquierdo h2 {
        font-size: 36px;
        font-weight: 00;
        margin: 0;
    }

    .flex, .flex-center{
        display: flex;
        align-items: center;
        
    }
    .flex {
        justify-content: space-between;
    }
    .flex-center {
        justify-content: center;
    }

    .contenedor-img-documento {
        max-width: 25px;
    }

    .img-documento {
        width: 100%;
    }

    .txt-mas {
        font-weight:900;
    }

    .bloque-bajo {
        margin-top: 20px;
    }

    .custom-checkbox {
        display: inline-block;
        position: relative;
        cursor: pointer;
        width: 25px;
        height: 25px;
    }

        .custom-checkbox input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .checkmark {
        position: absolute;
        top: 0;
        left: 0;
        height: 25px;
        width: 25px;
        background-color: white;
        border: 2px solid black;
        border-radius: 6px;
        box-sizing: border-box;
    }

        /* El check */
        .checkmark::after {
            content: "";
            position: absolute;
            display: none;
            left: 8px;
            top: 4px;
            width: 7px;
            height: 12px;
            border: solid black;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

    /* Mostrar check cuando está marcado */
    .custom-checkbox input:checked + .checkmark::after {
        display: block;
    }


</style>

@code {
    int NuevasSolicitudes = 0;
    int SolicitudesEnProceso = 0;
    int SolicitudesFinalizadas = 0;

    private string filtroNombre = "";
    private int paginaActual = 1;
    private int porPagina = 6;
    private bool cargando = true;
    private string? mensajeError = null;

    private List<SolicitudDto> TodasSolicitudes = new();

    private string estadoSeleccionado = "";

    private readonly string[] ESTADOS_NUEVOS = new[] { "Enviada", "Pendiente" };
    private readonly string[] ESTADOS_EN_PROCESO = new[] { "EnRevision", "En Revisión" };
    private readonly string[] ESTADOS_FINALIZADOS = new[] { "Aprobada", "Rechazada" };

    
    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }
    
   /*
    protected override async Task OnInitializedAsync()
    {
        // Simulación para probar paginación
        TodasSolicitudes = Enumerable.Range(1, 25).Select(i => new SolicitudDto
        {
            Id = Guid.NewGuid(),
            DocenteNombreCompleto = $"Docente {i}",
            RangoSolicitadoNombre = $"Rango {i}",
            FechaEnvio = DateTime.Today.AddDays(-i),
            Estado = i % 3 == 0 ? "Aprobada" : (i % 3 == 1 ? "En Revisión" : "Rechazada")
            }).ToList();

        ActualizarContadores();
        cargando = false;
        }
         */

    private async Task CargarSolicitudes()
    {
        try
        {
            cargando = true;
            mensajeError = null;
            StateHasChanged();

            var solicitudesApi = await SolicitudesService.GetAllSolicitudesAsync();
            
            TodasSolicitudes = solicitudesApi;
            ActualizarContadores();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar las solicitudes: {ex.Message}";
            Console.WriteLine($"Error en CargarSolicitudes: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void ActualizarContadores()
    {
        NuevasSolicitudes = TodasSolicitudes.Count(s => ESTADOS_NUEVOS.Contains(s.Estado));
        SolicitudesEnProceso = TodasSolicitudes.Count(s => ESTADOS_EN_PROCESO.Contains(s.Estado));
        SolicitudesFinalizadas = TodasSolicitudes.Count(s => ESTADOS_FINALIZADOS.Contains(s.Estado));
    }

    private IEnumerable<SolicitudDto> Filtradas =>
        TodasSolicitudes
            .Where(s => string.IsNullOrWhiteSpace(filtroNombre) || s.DocenteNombreCompleto.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
            .Where(s => estadoSeleccionado switch
            {
                "NUEVOS" => ESTADOS_NUEVOS.Contains(s.Estado),
                "EN_PROCESO" => ESTADOS_EN_PROCESO.Contains(s.Estado),
                "FINALIZADOS" => ESTADOS_FINALIZADOS.Contains(s.Estado),
                _ => true
            })
            .Skip((paginaActual - 1) * porPagina)
            .Take(porPagina);

    private int PaginasTotales
    {
        get
        {
            var totalFiltradas = TodasSolicitudes
                .Where(s => string.IsNullOrWhiteSpace(filtroNombre) || s.DocenteNombreCompleto.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
                .Where(s => estadoSeleccionado switch
                {
                    "NUEVOS" => ESTADOS_NUEVOS.Contains(s.Estado),
                    "EN_PROCESO" => ESTADOS_EN_PROCESO.Contains(s.Estado),
                    "FINALIZADOS" => ESTADOS_FINALIZADOS.Contains(s.Estado),
                    _ => true
                })
                .Count();
            
            return (int)Math.Ceiling(totalFiltradas / (double)porPagina);
        }
    }

    private void CambiarPagina(int nueva) => paginaActual = nueva;    private void FiltrarPor(string estadoGrupo)
    {
        estadoSeleccionado = estadoGrupo;
        paginaActual = 1;
    }

    private void VerDetalles(Guid solicitudId)
    {
        Navigation.NavigateTo($"/admin/solicitud/{solicitudId}");
    }

    private string ObtenerColorEstado(string estado) =>
        estado.Contains("Aprobad") ? "green" :
        estado.Contains("Revision") || estado.Contains("Revisión") ? "orange" :
        estado.Contains("Rechazad") ? "red" :
        "blue";
}
