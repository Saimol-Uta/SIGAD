    // Implementación completa de métodos
    private async Task ImportarDocumentos()
    {
        if (operacionEnProceso) return;

        // Primero verificamos si hay documentos nuevos para importar
        // Para esto comparamos la cantidad de documentos actual con la cantidad después de la importación
        int documentosInicialesCount = documentos.Count;

        operacionEnProceso = true;
        mensajeProceso = $"Importando {TipoDocumento} desde sistemas externos...";
        StateHasChanged();

        try
        {
            if (OnImportar.HasDelegate)
            {
                await OnImportar.InvokeAsync(TipoDocumento);
                await Task.Delay(2000); // Esperar a que termine la importación
                await CargarDocumentos(); // Recargar los datos
                
                // Verificamos si se importaron nuevos documentos
                if (documentos.Count > documentosInicialesCount)
                {
                    int documentosNuevos = documentos.Count - documentosInicialesCount;
                    // Mostrar SweetAlert para importación exitosa con documentos nuevos
                    await MostrarSweetAlert(
                        "¡Importación exitosa!", 
                        $"Se han importado {documentosNuevos} {config.Titulo.ToLower()} desde sistemas externos.",
                        "success"
                    );
                    operacionExitosa = true;
                }
                else
                {
                    // Mostrar SweetAlert informativo cuando no hay nuevos documentos
                    await MostrarSweetAlert(
                        "No hay documentos nuevos", 
                        $"No se encontraron {config.Titulo.ToLower()} adicionales para importar.",
                        "info"
                    );
                }
            }
        }
        catch (Exception ex)
        {
            // Mostrar SweetAlert para errores
            await MostrarSweetAlert(
                "Error en la importación", 
                $"No se pudieron importar los documentos: {ex.Message}",
                "error"
            );
            operacionExitosa = false;
        }
        finally
        {
            operacionEnProceso = false;
            mensajeProceso = "";
            StateHasChanged();
        }
    }

