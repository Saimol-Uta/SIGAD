            confirmButtonColor = "#d33",
            cancelButtonColor = "#3085d6",
            confirmButtonText = "Sí, eliminar",
            cancelButtonText = "Cancelar"
        });

        // Verificar si el usuario confirmó la eliminación
        if (result == null || !result.ToString()?.Contains("isConfirmed\":true") == true)
            return;

        try
        {
            var id = ObtenerIdDocumento(doc, TipoDocumento);
            if (string.IsNullOrEmpty(id))
            {
                await MostrarSweetAlert("Error", "No se pudo obtener el identificador del documento", "error");
                return;
            }

            var endpoint = TipoDocumento switch
            {
                "investigaciones" => $"api/investigaciones/{id}",
                "articulos" => $"api/articulos/{Uri.EscapeDataString(id)}",
                "tesis" => $"api/TesisDirigidas/{id}",
                "experiencias" => $"api/experienciaslaborales/{id}",
                "cursos" => $"api/cursos/{id}",
                "evaluaciones" => $"api/evaluaciones/{id}",
                _ => ""
            };

            var response = await Http.DeleteAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                await MostrarSweetAlert("¡Documento eliminado!", "El documento se eliminó correctamente", "success", true);
                await CargarDocumentos();
                
                // Notificar al componente padre para que actualice los requisitos
                if (OnDocumentosActualizados.HasDelegate)
                {
                    await OnDocumentosActualizados.InvokeAsync();
                }
            }
            else
            {
                await MostrarSweetAlert("Error", "No se pudo eliminar el documento", "error");
            }
        }
        catch (Exception ex)
        {
            await MostrarSweetAlert("Error", $"Error al eliminar: {ex.Message}", "error");
        }
    }

    private async Task DesasociarDocumento(JsonElement doc)
    {
        try
        {
            var documentoId = ObtenerIdDocumento(doc, TipoDocumento);
            if (string.IsNullOrEmpty(documentoId))
            {
                await MostrarSweetAlert("Error", "No se pudo obtener el ID del documento", "error");
                return;
            }

            // Obtener ID de la solicitud activa
            var solicitudId = await ObtenerSolicitudActivaId();
            if (string.IsNullOrEmpty(solicitudId))
            {
                await MostrarSweetAlert("Error", "No hay una solicitud activa para desasociar documentos", "error");
                return;
            }

            // Construir el endpoint correcto según el tipo de documento
            string? endpoint = null;
            object? requestData = null;

            switch (TipoDocumento)
            {
                case "investigaciones":
                    endpoint = $"api/investigaciones/{documentoId}/desasociar-solicitud";
                    requestData = new { SolicitudId = Guid.Parse(solicitudId) };
                    break;
                    
                case "articulos":
                    endpoint = $"api/articulos/desasociar-solicitud/{Uri.EscapeDataString(documentoId)}";
                    requestData = new { SolicitudId = Guid.Parse(solicitudId) };
                    break;
                    
                case "experiencias":
                    // Para experiencias usamos el formato DELETE compatible con el backend
                    // Asegurarse que los IDs están en el formato correcto
                    var formattedSolicitudId = Guid.Parse(solicitudId).ToString();
                    var formattedDocumentoId = int.Parse(documentoId).ToString();
                    endpoint = $"api/experienciaslaborales/desasociar-solicitud/{formattedSolicitudId}/{formattedDocumentoId}";
                    Console.WriteLine($"[FRONTEND] Desasociando experiencia - ID: {documentoId}, SolicitudId: {solicitudId}, Endpoint: {endpoint}");
                    requestData = null; // No se necesita body para este endpoint
                    break;

                case "evaluaciones":
                    endpoint = $"api/evaluaciones/{documentoId}/desasociar-solicitud";
                    requestData = new { SolicitudId = Guid.Parse(solicitudId) };
                    Console.WriteLine($"[FRONTEND] Desasociando evaluación - ID: {documentoId}, SolicitudId: {solicitudId}, Endpoint: {endpoint}");
                    break;
                    
                case "cursos":
                    endpoint = $"api/cursos/{documentoId}/desasociar-solicitud";
                    requestData = new { SolicitudId = Guid.Parse(solicitudId) };
                    break;
                    
                case "tesis":
                    endpoint = $"api/TesisDirigidas/{documentoId}/desasociar-solicitud";
                    requestData = new { SolicitudId = Guid.Parse(solicitudId) };
                    break;
            }

            if (endpoint == null)
            {
                await MostrarSweetAlert("Error", "Tipo de documento no válido para desasociación", "error");
                return;
            }

            HttpResponseMessage response;
            
            if (TipoDocumento == "experiencias")
            {
                // Las experiencias usan DELETE sin body
                Console.WriteLine($"[FRONTEND] Ejecutando DELETE para desasociar experiencia: {endpoint}");
                response = await Http.DeleteAsync(endpoint);
            }
            else if (requestData != null)
            {
                // El resto usa POST con requestData
                response = await Http.PostAsJsonAsync(endpoint, requestData);
            }
            else
            {
                await MostrarSweetAlert("Error", "Error en la configuración del endpoint", "error");
                return;
            }

            if (TipoDocumento == "evaluaciones" || TipoDocumento == "experiencias")
            {
                Console.WriteLine($"[FRONTEND] Respuesta desasociación {TipoDocumento} - StatusCode: {response.StatusCode}, IsSuccessStatusCode: {response.IsSuccessStatusCode}");
            }
            
            if (response.IsSuccessStatusCode)
            {
                // Usar un SweetAlert que cierre automáticamente
                await JSRuntime.InvokeVoidAsync("Swal.fire", new
                {
                    position = "center",
                    icon = "success",
                    title = "Documento desasociado correctamente",
                    showConfirmButton = false,
                    timer = 1500
                });
                
                // Recargar los datos para reflejar los cambios
                await CargarDocumentos();
                StateHasChanged();
                
                // Notificar al componente padre para que actualice los requisitos
                if (OnDocumentosActualizados.HasDelegate)
                {
                    await OnDocumentosActualizados.InvokeAsync();
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                
                if (TipoDocumento == "evaluaciones" || TipoDocumento == "experiencias") 
                {
                    Console.WriteLine($"[FRONTEND] Error desasociación {TipoDocumento}: {response.StatusCode} - {errorContent}");
                }
                
                await MostrarSweetAlert("Error", $"No se pudo desasociar el documento: {response.StatusCode}", "error");
            }
        }
        catch (Exception ex)
        {
            await MostrarSweetAlert("Error inesperado", ex.Message, "error");
        }
    }

    private List<string> ObtenerValoresDocumento(JsonElement doc, string tipo)
    {
        try
        {
            return tipo switch
            {
                "investigaciones" => new List<string>
                {
                    doc.TryGetProperty("titulo", out var titulo) ? titulo.GetString() ?? "" : "",
                    doc.TryGetProperty("rolEnInvestigacion", out var rol) ? rol.GetString() ?? "" : "",
                    doc.TryGetProperty("fechaInicio", out var fechaInicio) ? fechaInicio.GetDateTime().ToString("yyyy-MM-dd") : "",
                    doc.TryGetProperty("fechaFinalizacion", out var fechaFin) ? fechaFin.GetDateTime().ToString("yyyy-MM-dd") : "",
                    doc.TryGetProperty("mesesDeInvestigacion", out var meses) ? meses.GetDecimal().ToString("F0") : ""
                },
                "articulos" => new List<string>
                {
                    doc.TryGetProperty("doi", out var doi) ? doi.GetString() ?? "" : "",
                    doc.TryGetProperty("titulo", out var tituloArt) ? tituloArt.GetString() ?? "" : "",
                    doc.TryGetProperty("revista", out var revista) ? revista.GetString() ?? "" : "",
                    doc.TryGetProperty("anioPublicacion", out var anio) ? anio.GetInt32().ToString() : "",
                    doc.TryGetProperty("idiomaPublicacion", out var idioma) ? idioma.GetString() ?? "" : ""
                },
                "experiencias" => new List<string>
                {
                    doc.TryGetProperty("organizacionNombre", out var institucion) ? institucion.GetString() ?? "" : "",
                    doc.TryGetProperty("cargo", out var cargo) ? cargo.GetString() ?? "" : "",
                    doc.TryGetProperty("fechaInicio", out var fechaInicioExp) ? fechaInicioExp.GetDateTime().ToString("yyyy-MM-dd") : "",
                    doc.TryGetProperty("fechaFin", out var fechaFinExp) && fechaFinExp.ValueKind != JsonValueKind.Null ? fechaFinExp.GetDateTime().ToString("yyyy-MM-dd") : "Actual",
                    ObtenerAniosExperiencia(doc)
                },
                "evaluaciones" => new List<string>
                {
                    doc.TryGetProperty("periodoAcademico", out var periodo) ? periodo.GetString() ?? "" : "",
                    doc.TryGetProperty("puntajePorcentual", out var calificacion) ? calificacion.GetDecimal().ToString("F1") : "",
                    doc.TryGetProperty("fechaEvaluacion", out var fechaEval) ? fechaEval.GetDateTime().ToString("yyyy-MM-dd") : ""
                },
                "cursos" => new List<string>
                {
                    doc.TryGetProperty("nombre", out var nombreCurso) ? nombreCurso.GetString() ?? "" : "",
                    doc.TryGetProperty("tipoCurso", out var tipoCurso) ? tipoCurso.GetString() ?? "" : "",
                    doc.TryGetProperty("numeroHoras", out var horas) ? horas.GetInt32().ToString() : "",
                    doc.TryGetProperty("fechaFinalizacion", out var fechaCurso) ? fechaCurso.GetDateTime().ToString("yyyy-MM-dd") : "",
                    doc.TryGetProperty("nombreOrganizacion", out var organizacion) ? organizacion.GetString() ?? "" : ""
                },
                "tesis" => new List<string>
                {
                    doc.TryGetProperty("tituloTesis", out var tituloTesis) ? tituloTesis.GetString() ?? "" : "",
                    doc.TryGetProperty("nivelAcademico", out var nivel) ? nivel.GetString() ?? "" : "",
                    doc.TryGetProperty("estado", out var estado) ? estado.GetString() ?? "" : "",
                    doc.TryGetProperty("fechaInicio", out var fechaInicioTesis) ? fechaInicioTesis.GetDateTime().ToString("yyyy-MM-dd") : "",
                    doc.TryGetProperty("institucion", out var institucionTesis) ? institucionTesis.GetString() ?? "" : 
                        (doc.TryGetProperty("nombreInstitucion", out var inst2) ? inst2.GetString() ?? "" : "")
                },
                _ => new List<string> { "Información no disponible" }
            };
        }
        catch (Exception)
        {
            return new List<string> { "Error al cargar datos" };
        }
    }

    private string? ObtenerIdDocumento(JsonElement doc, string tipo)
    {
        if (tipo == "articulos")
        {
            if (doc.TryGetProperty("doi", out var doiElement) && doiElement.ValueKind == JsonValueKind.String)
            {
                return doiElement.GetString();
            }
            return null;
        }
        
        if (doc.TryGetProperty("id", out var idElement))
        {
            if (idElement.ValueKind == JsonValueKind.Number)
                return idElement.GetInt32().ToString();
            if (idElement.ValueKind == JsonValueKind.String)
                return idElement.GetString();
        }
        return null;
    }

    private string? ObtenerRutaPdf(JsonElement doc, string tipo)
    {
        try
        {
            // Propiedades específicas por tipo de documento
            var propiedadesPorTipo = tipo switch
            {
                "cursos" => new[] { "certificadoRuta", "rutaPdf" },
                "experiencias" => new[] { "certificadoRuta", "rutaPdf" }, 
                "investigaciones" => new[] { "informeRuta", "rutaPdf" }, 
                "articulos" => new[] { "archivoRuta" },
                "evaluaciones" => new[] { "informeRuta", "rutaPdf" },
                "tesis" => new[] { "certificacionRuta", "CertificacionRuta", "certificadoRuta", "rutaPdf" },
                _ => new[] { "rutaPdf" }
            };

            // Buscar en las propiedades específicas del tipo
            foreach (var propiedad in propiedadesPorTipo)
            {
                if (doc.TryGetProperty(propiedad, out var rutaElement) && 
                    rutaElement.ValueKind == JsonValueKind.String)
                {
                    var ruta = rutaElement.GetString();
                    if (!string.IsNullOrEmpty(ruta))
                    {
                        return ruta;
                    }
                }
            }

            // Búsqueda adicional en propiedades generales
            var propiedadesGenerales = new[] {
                "rutaArchivo",
                "archivoPdf",
                "rutaDocumento",
                "pdfPath",
                "filePath"
            };

            foreach (var propiedad in propiedadesGenerales)
            {
                if (doc.TryGetProperty(propiedad, out var rutaElement) && 
                    rutaElement.ValueKind == JsonValueKind.String)
                {
                    var ruta = rutaElement.GetString();
                    if (!string.IsNullOrEmpty(ruta))
                    {
                        return ruta;
                    }
                }
            }

            return null;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private string? ObtenerUrlCloudinary(JsonElement doc, string tipo)
    {
        try
        {
            // Lista de propiedades posibles para buscar la URL de Cloudinary
            var propiedadesPosibles = new[] {
                "urlCloudinary",  // ✅ Propiedad estándar para todos los tipos
                "UrlCloudinary",  // Con U mayúscula (usado en TesisDirigidaDto)
                "cloudinaryUrl",
