</style>

@code {
    // Parámetros del componente
    [Parameter] public string TipoDocumento { get; set; } = "";
    [Parameter] public string Cedula { get; set; } = "";
    [Parameter] public EventCallback<string> OnImportar { get; set; }
    [Parameter] public EventCallback<string> OnAgregar { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }

    // Variables de estado
    private bool cargando = true;
    private bool operacionEnProceso = false;
    private bool operacionExitosa = false;
    private string? mensajeError = null;
    private string? mensajeOperacion = null;
    private string mensajeProceso = "";

    // Variables de paginación
    private int paginaActual = 1;
    private int porPagina = 6;

    // Datos dinámicos
    private List<JsonElement> documentos = new();
    private IEnumerable<JsonElement> documentosPaginados => documentos
        .Skip((paginaActual - 1) * porPagina)
        .Take(porPagina);

    private int PaginasTotales => (int)Math.Ceiling(documentos.Count / (double)porPagina);

    protected override async Task OnInitializedAsync()
    {
        await CargarDocumentos();
    }

    protected override async Task OnParametersSetAsync()
{
    // Solo recargar si los parámetros han cambiado y no estamos ya cargando
    if (!cargando && !string.IsNullOrEmpty(TipoDocumento) && !string.IsNullOrEmpty(Cedula))
    {
        await CargarDocumentos();
    }
}
private async Task CargarDocumentos()
{
    if (string.IsNullOrEmpty(Cedula) || string.IsNullOrEmpty(TipoDocumento))
        return;

    try
    {
        cargando = true;
        mensajeError = null;
        StateHasChanged();

        string endpoint = TipoDocumento switch
        {
            "investigaciones" => $"api/investigaciones/docente/{Cedula}",
            "articulos" => $"api/articulos/docente/{Cedula}",
            "experiencias" => $"api/experienciaslaborales/docente/{Cedula}",
            "evaluaciones" => $"api/evaluaciones/docente/{Cedula}",
            "cursos" => $"api/cursos/docente/{Cedula}",
            "tesis" => $"api/TesisDirigidas/docente/{Cedula}",
            _ => ""
        };

        if (!string.IsNullOrEmpty(endpoint))
        {
            var response = await Http.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var jsonDoc = JsonDocument.Parse(jsonString);

                // Ajuste aquí para tesis
                if (TipoDocumento == "articulos" || TipoDocumento == "experiencias" || TipoDocumento == "evaluaciones" || TipoDocumento == "tesis")
                {
                    if (jsonDoc.RootElement.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == JsonValueKind.Array)
                    {
                        documentos = dataElement.EnumerateArray().ToList();
                    }
                    else
                    {
                        documentos = new List<JsonElement>();
                    }
                }
                else
                {
                    if (jsonDoc.RootElement.ValueKind == JsonValueKind.Array)
                    {
                        documentos = jsonDoc.RootElement.EnumerateArray().ToList();
                    }
                    else
                    {
                        documentos = new List<JsonElement>();
                    }
                }
            }
            else
            {
                mensajeError = "Error al cargar los documentos";
            }
        }
    }
    catch (Exception ex)
    {
        mensajeError = $"Error al cargar documentos: {ex.Message}";
    }
    finally
    {
        cargando = false;
        StateHasChanged();
    }
}
private string? ObtenerRutaPdf(JsonElement doc, string tipo)
{
    return tipo switch
    {
        "investigaciones" => doc.TryGetProperty("informeRuta", out var rutaInv) ? rutaInv.GetString() : null,
        "articulos" => doc.TryGetProperty("archivoRuta", out var rutaArt) ? rutaArt.GetString() : null,
        "tesis" => doc.TryGetProperty("certificacionRuta", out var rutaTesis) ? rutaTesis.GetString() : null,
        "experiencias" => doc.TryGetProperty("certificadoRuta", out var rutaExp) ? rutaExp.GetString() : null,
        "cursos" => doc.TryGetProperty("certificadoRuta", out var rutaCurso) ? rutaCurso.GetString() : null,
        "evaluaciones" => doc.TryGetProperty("informeRuta", out var rutaEval) ? rutaEval.GetString() : null, 
        _ => null
    };
}
    
    private async Task ImportarDocumentos()
    {
        if (operacionEnProceso) return;

        operacionEnProceso = true;
        mensajeProceso = $"Importando {TipoDocumento} desde sistemas externos...";
        mensajeOperacion = null;

        try
        {
            if (OnImportar.HasDelegate)
            {
                await OnImportar.InvokeAsync(TipoDocumento);
                
                // Recargar documentos después de importar
                await Task.Delay(1000); // Pequeña pausa para asegurar que la importación termine
                await CargarDocumentos();
                
                mensajeOperacion = "✅ Importación completada exitosamente";
                operacionExitosa = true;
            }
        }
        catch (Exception ex)
        {
            mensajeOperacion = $"❌ Error al importar: {ex.Message}";
            operacionExitosa = false;
        }
        finally
        {
            operacionEnProceso = false;
            mensajeProceso = "";
            StateHasChanged();

            // Limpiar mensaje después de 3 segundos
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                mensajeOperacion = null;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task AgregarDocumento()
    {
        if (OnAgregar.HasDelegate)
        {
            await OnAgregar.InvokeAsync(TipoDocumento);
        }
    }

    private async Task CerrarTabla()
    {
        if (OnCerrar.HasDelegate)
        {
            await OnCerrar.InvokeAsync();
        }
    }
    // Abrir PDF en nueva pestaña
    private async Task VerPdf(JsonElement doc)
{
    var pdfRuta = ObtenerRutaPdf(doc, TipoDocumento);
    if (!string.IsNullOrEmpty(pdfRuta))
    {
        // Para todos los tipos de documentos, usar la lógica existente
        var relativePath = pdfRuta.StartsWith("/uploads", StringComparison.OrdinalIgnoreCase)
            ? pdfRuta
            : $"/uploads/{pdfRuta.TrimStart('/')}";
        
        var backendUrl = $"https://localhost:7072{relativePath}";
        
        await JSRuntime.InvokeVoidAsync("window.open", backendUrl, "_blank");
    }
    else
    {
        mensajeOperacion = "No hay PDF disponible para este documento.";
        operacionExitosa = false;
    }
}

private string ObtenerEndpointEliminar(string tipo, string id)
{
    return tipo switch
    {
        "investigaciones" => $"api/investigaciones/{id}",
        "articulos" => $"api/articulos/{id}",
        "tesis" => $"api/TesisDirigidas/{id}",
        "experiencias" => $"api/experienciaslaborales/{id}",
        "cursos" => $"api/cursos/{id}",
        "evaluaciones" => $"api/evaluaciones/{id}",
        _ => ""
    };
}

// Editar documento
private async Task EditarDocumento(JsonElement doc)
{
    var id = ObtenerIdDocumento(doc, TipoDocumento);
    if (!string.IsNullOrEmpty(id))
    {
        switch (TipoDocumento)
        {
            case "tesis":
                Navigation.NavigateTo($"/editar-tesis/{id}");
                break;
            case "cursos":
                Navigation.NavigateTo($"/editar-curso/{id}");
                break;
            case "articulos":
                // Para artículos, codificar el DOI para la URL
                var encodedDoi = Uri.EscapeDataString(id);
                Navigation.NavigateTo($"/editar-articulo/{encodedDoi}");
                break;
            case "investigaciones":
                Navigation.NavigateTo($"/editar-investigacion/{id}");
                break;
            case "experiencias":
                Navigation.NavigateTo($"/editar-experiencia/{id}");
                break;
            case "evaluaciones":
                Navigation.NavigateTo($"/editar-evaluacion/{id}");
                break;
            default:
                mensajeOperacion = "Funcionalidad de edición aún no implementada para este tipo de documento.";
                operacionExitosa = false;
                break;
        }
    }
    else
    {
        mensajeOperacion = "No se pudo obtener el identificador del documento.";
        operacionExitosa = false;
    }
}

// Eliminar documento
private async Task EliminarDocumento(JsonElement doc)
{
    var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar este documento?");
    if (!confirmado) return;

    try
    {
        var id = ObtenerIdDocumento(doc, TipoDocumento);
        if (string.IsNullOrEmpty(id))
        {
            mensajeOperacion = "No se pudo obtener el identificador del documento.";
            operacionExitosa = false;
            return;
        }

        // Para artículos, codificar el DOI
        var encodedId = TipoDocumento == "articulos" ? Uri.EscapeDataString(id) : id;
        var endpoint = ObtenerEndpointEliminar(TipoDocumento, encodedId);
        var response = await Http.DeleteAsync(endpoint);

        if (response.IsSuccessStatusCode)
        {
            mensajeOperacion = "Documento eliminado correctamente.";
            operacionExitosa = true;
            await CargarDocumentos();
        }
        else
        {
            mensajeOperacion = "Error al eliminar el documento.";
            operacionExitosa = false;
        }
    }
    catch (Exception ex)
    {
        mensajeOperacion = $"Error: {ex.Message}";
        operacionExitosa = false;
    }
}

    private void CambiarPagina(int nueva)
    {
        paginaActual = nueva;
    }

    // Configuración dinámica según el tipo de documento
    private DocumentConfig ObtenerConfiguracion(string tipo)
    {
        return tipo switch
        {
            "investigaciones" => new DocumentConfig
            {
                Titulo = "Investigaciones",
                Columnas = new() { "Título", "Rol", "Fecha Inicio", "Fecha Fin", "Meses" }
            },
            "articulos" => new DocumentConfig
            {
                Titulo = "Artículos",
                Columnas = new() { "DOI", "Título", "Revista", "Año", "Idioma Publicación" }
            },
            "experiencias" => new DocumentConfig
            {
                Titulo = "Experiencias Laborales",
                Columnas = new() { "Institución", "Cargo", "Fecha Inicio", "Fecha Fin", "Años" }
            },
            "evaluaciones" => new DocumentConfig
            {
                Titulo = "Evaluaciones",
                Columnas = new() { "Periodo Académico", "Calificación", "Fecha Evaluación"}
            },
            "cursos" => new DocumentConfig
{
    Titulo = "Cursos",
    Columnas = new() { "Nombre", "Tipo de Curso", "Horas Impartidas", "Fecha", "Institución" }
},
            
            "tesis" => new DocumentConfig
            {
                Titulo = "Tesis Dirigidas",
                Columnas = new() { "Título", "Nivel", "Estado", "Fecha Inicio", "Institución" }
            },
            _ => new DocumentConfig { Titulo = "Documentos", Columnas = new() { "Información" } }
        };
    }

    // Extraer valores dinámicos según el tipo de documento
    private List<string> ObtenerValoresDocumento(JsonElement doc, string tipo)
    {
        try
        {
            var valores = new List<string>();
            
            switch (tipo)
            {
                case "investigaciones":
                    valores.AddRange(new[]
                    {
                        doc.TryGetProperty("titulo", out var titulo) ? titulo.GetString() ?? "" : "",
                        doc.TryGetProperty("rolEnInvestigacion", out var rol) ? rol.GetString() ?? "" : "",
                        doc.TryGetProperty("fechaInicio", out var fechaInicio) ? fechaInicio.GetDateTime().ToString("yyyy-MM-dd") : "",
                        doc.TryGetProperty("fechaFinalizacion", out var fechaFin) ? fechaFin.GetDateTime().ToString("yyyy-MM-dd") : "",
                        doc.TryGetProperty("mesesDeInvestigacion", out var meses) ? meses.GetInt32().ToString() : ""
                    });
                    break;
                    
                case "articulos":
                    valores.AddRange(new[]
                    {
                        doc.TryGetProperty("doi", out var doi) ? doi.GetString() ?? "" : "",
                        doc.TryGetProperty("titulo", out var tituloArt) ? tituloArt.GetString() ?? "" : "",
                        doc.TryGetProperty("revista", out var revista) ? revista.GetString() ?? "" : "",
                        doc.TryGetProperty("anioPublicacion", out var anio) ? anio.GetInt32().ToString() : "",
                        doc.TryGetProperty("idiomaPublicacion", out var idioma) ? idioma.GetString() ?? "" : ""
                    });
                    break;
                    
                case "tesis":
                    valores.AddRange(new[]
                    {
                        doc.TryGetProperty("tituloTesis", out var tituloTesis) ? tituloTesis.GetString() ?? "" : "",
                        doc.TryGetProperty("nivelAcademico", out var nivel) ? nivel.GetString() ?? "" : "",
                        doc.TryGetProperty("estado", out var estado) ? estado.GetString() ?? "" : "",
                        doc.TryGetProperty("fechaInicio", out var fechaInicioTesis) ? fechaInicioTesis.GetDateTime().ToString("yyyy-MM-dd") : "",
                        doc.TryGetProperty("institucion", out var institucion) ? institucion.GetString() ?? "" : ""
                    });
                    break;

                case "experiencias":
                    valores.AddRange(new[]
                    {
                        doc.TryGetProperty("organizacionNombre", out var inst) ? inst.GetString() ?? "" : "",
                        doc.TryGetProperty("cargo", out var cargo) ? cargo.GetString() ?? "" : "",
                        doc.TryGetProperty("fechaInicio", out var fechaInicioExp) ? fechaInicioExp.GetDateTime().ToString("yyyy-MM-dd") : "",
                        doc.TryGetProperty("fechaFin", out var fechaFinExp) ? fechaFinExp.GetDateTime().ToString("yyyy-MM-dd") : "",
                        doc.TryGetProperty("aniosExperiencia", out var aniosExp) ? aniosExp.GetDecimal().ToString("F1") : ""
                    });
                    break;
                    case "evaluaciones":
    valores.AddRange(new[]
    {
        doc.TryGetProperty("periodoAcademico", out var periodo) ? periodo.GetString() ?? "" : "",
        doc.TryGetProperty("puntajePorcentual", out var calificacion) ? calificacion.GetDecimal().ToString("F1") : "",
        doc.TryGetProperty("fechaEvaluacion", out var fechaEval) ? fechaEval.GetDateTime().ToString("yyyy-MM-dd") : ""
    });
    break; 
                    case "cursos":
    valores.AddRange(new[]
    {
        doc.TryGetProperty("nombre", out var nombreCurso) ? nombreCurso.GetString() ?? "" : "",
        doc.TryGetProperty("tipoCurso", out var tipoCurso) ? tipoCurso.GetString() ?? "" : "",
        doc.TryGetProperty("horasImpartidas", out var horas) && horas.ValueKind == JsonValueKind.Number ? horas.GetInt32().ToString() : "",
        doc.TryGetProperty("fechaFinalizacion", out var fechaCurso) && fechaCurso.ValueKind == JsonValueKind.String
            ? (DateTime.TryParse(fechaCurso.GetString(), out var fecha) ? fecha.ToString("yyyy-MM-dd") : "")
            : "",
        doc.TryGetProperty("nombreOrganizacion", out var institucionCurso) ? institucionCurso.GetString() ?? "" : ""
    });
    break;
         
                default:
                    valores.Add("Información no disponible");
                    break;
            }
            
            return valores;
        }
        catch (Exception ex)
        {
            return new List<string> { $"Error: {ex.Message}" };
        }
    }
    private string? ObtenerIdDocumento(JsonElement doc, string tipo)
{
    switch (tipo)
    {
        case "articulos":
            // Para artículos, el identificador es el DOI
            if (doc.TryGetProperty("doi", out var doiElement))
            {
                return doiElement.GetString();
            }
            break;
        
        default:
            // Para otros tipos de documentos, usar el campo "id"
            if (doc.TryGetProperty("id", out var idElement))
            {
                // Si el id es un número, conviértelo a string
                if (idElement.ValueKind == JsonValueKind.Number)
                    return idElement.GetInt32().ToString();
                if (idElement.ValueKind == JsonValueKind.String)
                    return idElement.GetString();
            }
            break;
    }
    return null;
}

    // Clases auxiliares
    public class DocumentConfig
    {
        public string Titulo { get; set; } = "";
        public List<string> Columnas { get; set; } = new();
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}