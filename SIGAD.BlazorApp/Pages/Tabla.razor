            "cursos" => doc.TryGetProperty("certificadoRuta", out var rutaCurso) ? rutaCurso.GetString() : null,
            "evaluaciones" => doc.TryGetProperty("informeRuta", out var rutaEval) ? rutaEval.GetString() : null, 
            _ => null
