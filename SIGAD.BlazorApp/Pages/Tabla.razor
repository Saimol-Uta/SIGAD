@page "/tabla-articulos"
@using SIGAD.BlazorApp.Layout
@attribute [Layout(typeof(EmptyLayout))]
@using SIGAD.BlazorApp.Components
@using SIGAD.BlazorApp.Models
@using SIGAD.BlazorApp.Services
@inject ISolicitudesService SolicitudesService
@inject NavigationManager Navigation

<div class="page-wrapper">
    <Encabezado />

    <div class="admin-dashboard">

        <!-- CONTENIDO PRINCIPAL -->
        <div class="main-content">


            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                <div class="flex bloque-izquierdo">
                    <h2>Artículos</h2>
                    <select class="select-documento">
                        <option value="articulos">Artículos</option>
                        <option value="investigaciones">Investigaciones</option>
                        <option value="experiencia">Experiencia</option>
                        <option value="cursos">Cursos</option>
                        <option value="evaluaciones">Evaluaciones</option>
                    </select>
                </div>
                <a class="flex btn-añadir" href="#">
                    <p>Añadir</p>
                    <p class="txt-mas">+</p>
                </a>
            </div>

            <!-- TABLA DE SOLICITUDES -->
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
                    <strong>Error:</strong> @mensajeError
                    <button @onclick="CargarSolicitudes" style="margin-left: 10px; padding: 5px 10px; background-color: #0a1d44; color: white; border: none; border-radius: 3px; cursor: pointer;">
                        Reintentar
                    </button>
                </div>
            }

            @if (cargando)
            {
                <div style="text-align: center; padding: 40px; color: #666;">
                    <div style="margin-bottom: 15px;">Cargando solicitudes...</div>
                    <div style="width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #0a1d44; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                </div>
            }
            else
            {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; border-radius: 0.2rem; overflow: hidden; background-color: white; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
                    <thead style="background-color: #0a1d44; color: white;">
                        <tr style="text-align: left;">
                            <th style="padding: 12px 20px;">DOI</th>
                            <th style="padding: 12px 20px;">Título</th>
                            <th style="padding: 12px 20px;">Revista</th>
                            <th style="padding: 12px 20px;">Año</th>
                            <th style="padding: 12px 20px;">Opciones</th>
                            <th style="padding: 12px 20px;">Seleccionar</th>
                        </tr>
                    </thead>
                    <tbody>
                            <!-- FILA DE DATOS ESTÁTICOS PARA PRUEBA -->
                            <tr style="border-bottom: 1px solid #eee; text-align: left;">
                                <td style="padding: 10px 20px;">10.1234/abcd</td>
                                <td style="padding: 10px 20px;">Ejemplo de Título de Artículo</td>
                                <td style="padding: 10px 20px;">Revista Científica X</td>
                                <td style="padding: 10px 20px;">2023</td>
                                <td style="padding: 10px 0px; display: flex; align-items: center; justify-content: space-evenly;">
                                    <a href="#" class="contenedor-img-documento">
                                        <img src="/images/pdf.png" alt="pdf" title="Descargar PDF" class="img-documento" />
                                    </a>
                                    <a href="#" class="contenedor-img-documento">
                                        <img src="/images/editar.png" alt="modificar" title="Modificar" class="img-documento" />
                                    </a>
                                    <a href="#" class="contenedor-img-documento">
                                        <img src="/images/borrar.png" alt="Retirar" title="Retirar" class="img-documento" />
                                    </a>
                                </td>
                                <td style="padding: 10px 0px;">
                                    <div class="flex-center">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" />
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                </td>
                            </tr>


                        @if (Filtradas.Any())
                        {                            foreach (var solicitud in Filtradas)
                            {
                                    <tr style="border-bottom: 1px solid #eee; text-align: left;">
                                        <td style="padding: 10px 20px;">@solicitud.Id</td>
                                        <td style="padding: 10px 20px;">@solicitud.DocenteNombreCompleto</td>
                                        <td style="padding: 10px 20px;">@solicitud.RangoSolicitadoNombre</td>
                                        <td style="padding: 10px 20px;">@(solicitud.FechaEnvio?.ToString("yyyy"))</td>
                                        <td style="padding: 10px 0px; display: flex; align-items: center; justify-content: space-evenly;">
                                            <a href="#" class="contenedor-img-documento">
                                                <img src="/images/pdf.png" alt="pdf" title="Descargar PDF" class="img-documento" />
                                            </a>
                                            <a href="#" class="contenedor-img-documento">
                                                <img src="/images/editar.png" alt="modificar" title="Modificar" class="img-documento" />
                                            </a>
                                            <a href="#" class="contenedor-img-documento">
                                                <img src="/images/borrar.png" alt="Retirar" title="Retirar" class="img-documento" />
                                            </a>
                                        </td>
                                        <td style="padding: 10px 0px;">
                                            <div class="flex-center">
                                                <label class="custom-checkbox">
                                                    <input type="checkbox" />
                                                    <span class="checkmark"></span>
                                                </label>
                                            </div>
                                        </td>
                                    </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 20px;">No se encontraron resultados.</td>
                            </tr>
                        }
                    </tbody>
                </table>            </div>


            <div class="flex bloque-bajo">

            <!-- PAGINACIÓN -->
                <div style="display: flex; justify-content: center;">
                    @for (int i = 1; i <= PaginasTotales; i++)
                    {
                        <button @onclick="() => CambiarPagina(i)"
                                style="margin: 0 4px; padding: 6px 14px; border-radius: 6px; border: none; background: @(paginaActual == i ? "#0a1d44" : "#e0e0e0"); color: @(paginaActual == i ? "white" : "#333"); font-weight: bold; cursor: pointer;">
                            @i
                        </button>
                    }
                </div>
                <a href="#" class="btn-continuar flex"> 
                        <p>Continuar Proceso</p>
                </a>
            </div>
            }
        </div>
    </div>
</div>

<style>
    p {
        margin: 0;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background-color: #f9f9f9;
    }

    .admin-dashboard {
        display: flex;
        flex-grow: 1;
        min-height: calc(100vh - 90px); /* espacio para header */
    }

    .nav-item {
        padding: 15px 20px;
        color: white;
        text-decoration: none;
        cursor: pointer;
    }

