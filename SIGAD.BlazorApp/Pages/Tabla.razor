@using SIGAD.BlazorApp.Layout
@attribute [Layout(typeof(EmptyLayout))]
@using SIGAD.BlazorApp.Components
@using SIGAD.BlazorApp.Models
@using SIGAD.BlazorApp.Services
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<!-- Parámetros del componente -->
@{
    // Configuración dinámica según el tipo de documento
    var config = ObtenerConfiguracion(TipoDocumento);
}

<div class="page-wrapper">
    <div class="admin-dashboard">
        <!-- CONTENIDO PRINCIPAL -->
        <div class="main-content">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                <div class="flex bloque-izquierdo">
                    <h2>@config.Titulo</h2>
                    <button class="btn-cerrar" @onclick="CerrarTabla">✕ Cerrar</button>
                </div>
                <div style="display: flex; gap: 10px;">
                    <button class="btn btn-import" @onclick="@(() => ImportarDocumentos())" disabled="@operacionEnProceso">
                        📥 Importar
                    </button>
                    <button class="btn btn-añadir" @onclick="@(() => AgregarDocumento())">
                        <p>Añadir</p>
                        <p class="txt-mas">+</p>
                    </button>
                </div>
            </div>

            <!-- Mensajes de estado -->
            @if (!string.IsNullOrEmpty(mensajeOperacion))
            {
                <div class="alert @(operacionExitosa ? "alert-success" : "alert-danger")">
                    @mensajeOperacion
                </div>
            }

            @if (operacionEnProceso)
            {
                <div class="alert alert-info">
                    <strong>Procesando...</strong> @mensajeProceso
                </div>
            }

            <!-- TABLA DE DOCUMENTOS -->
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
                    <strong>Error:</strong> @mensajeError
                    <button @onclick="CargarDocumentos" style="margin-left: 10px; padding: 5px 10px; background-color: #0a1d44; color: white; border: none; border-radius: 3px; cursor: pointer;">
                        Reintentar
                    </button>
                </div>
            }

            @if (cargando)
            {
                <div style="text-align: center; padding: 40px; color: #666;">
                    <div style="margin-bottom: 15px;">Cargando @config.Titulo.ToLower()...</div>
                    <div style="width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #0a1d44; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; border-radius: 0.2rem; overflow: hidden; background-color: white; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
                        <thead style="background-color: #0a1d44; color: white;">
                            <tr style="text-align: left;">
                                @foreach (var columna in config.Columnas)
                                {
                                    <th style="padding: 12px 20px;">@columna</th>
                                }
                                <th style="padding: 12px 20px;">Opciones</th>
    
                            </tr>
                        </thead>
                        <tbody>
                            @if (documentos.Any())
                            {
                                @foreach (var doc in documentosPaginados)
                                {
                                    <tr style="border-bottom: 1px solid #eee; text-align: left;">
                                        @foreach (var valor in ObtenerValoresDocumento(doc, TipoDocumento))
                                        {
                                            <td style="padding: 10px 20px;">@valor</td>
                                        }
                                        <td style="padding: 10px 0px; display: flex; align-items: center; justify-content: space-evenly;">
                                            <button class="contenedor-img-documento" title="Ver PDF" @onclick="() => VerPdf(doc)">
    <img src="/images/pdf.png" alt="pdf" class="img-documento" />
</button>
<button class="contenedor-img-documento" title="Modificar" @onclick="() => EditarDocumento(doc)">
    <img src="/images/editar.png" alt="modificar" class="img-documento" />
</button>
<button class="contenedor-img-documento" title="Retirar" @onclick="() => EliminarDocumento(doc)">
    <img src="/images/borrar.png" alt="Retirar" class="img-documento" />
</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(config.Columnas.Count + 2)" style="text-align: center; padding: 20px;">
                                        No se encontraron @config.Titulo.ToLower().
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN -->
                <div class="flex bloque-bajo">
                    <div style="display: flex; justify-content: center;">
                        @for (int i = 1; i <= PaginasTotales; i++)
                        {
                            <button @onclick="() => CambiarPagina(i)"
                                    style="margin: 0 4px; padding: 6px 14px; border-radius: 6px; border: none; background: @(paginaActual == i ? "#0a1d44" : "#e0e0e0"); color: @(paginaActual == i ? "white" : "#333"); font-weight: bold; cursor: pointer;">
                                @i
                            </button>
                        }
                    </div>
                    <div style="color: #666; font-size: 14px;">
                        Total: @documentos.Count @config.Titulo.ToLower()
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
