    // Método para cargar todos los documentos ya usados en solicitudes pasadas
    private Task CargarDocumentosUsadosEnSolicitudesPasadas(string? solicitudActualId)
    {
        if (string.IsNullOrEmpty(solicitudActualId))
            return Task.CompletedTask;

        try
        {
            documentosUsadosEnSolicitudesPasadas.Clear();

            // Para cada documento disponible, verificar si ya fue usado
            foreach (var doc in documentos)
            {
                var docId = ObtenerIdDocumento(doc, TipoDocumento);
                if (!string.IsNullOrEmpty(docId))
                {
                    // Verificar directamente las asociaciones del documento
                    if (DocumentoTieneAsociacionesPrevias(doc, solicitudActualId))
                    {
                        documentosUsadosEnSolicitudesPasadas.Add(docId);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar documentos usados: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    // Método simplificado para verificar asociaciones previas
    private bool DocumentoTieneAsociacionesPrevias(JsonElement doc, string solicitudActualId)
    {
        try
        {
            // Normalizar el ID de la solicitud actual
            var solicitudActualNormalizada = solicitudActualId.Replace("-", "").ToUpperInvariant();

            // Verificar en el array de solicitudes
            if (doc.TryGetProperty("solicitudes", out var solicitudesElement) && 
                solicitudesElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var solicitud in solicitudesElement.EnumerateArray())
                {
                    string? solicitudId = null;

                    // Obtener el ID de la solicitud (puede ser string directo o objeto)
                    if (solicitud.ValueKind == JsonValueKind.String)
                    {
                        solicitudId = solicitud.GetString();
                    }
                    else if (solicitud.TryGetProperty("solicitudId", out var solicitudIdProp))
                    {
                        solicitudId = solicitudIdProp.GetString();
                    }
                    else if (solicitud.TryGetProperty("id", out var idProp))
                    {
                        solicitudId = idProp.GetString();
                    }

                    // Si encontramos una asociación diferente a la actual, ya fue usado
                    if (!string.IsNullOrEmpty(solicitudId))
                    {
                        var solicitudNormalizada = solicitudId.Replace("-", "").ToUpperInvariant();
                        if (solicitudNormalizada != solicitudActualNormalizada)
                        {
                            return true;
                        }
                    }
                }
            }

            // También verificar solicitudId directo
            if (doc.TryGetProperty("solicitudId", out var solicitudIdElement) && 
                solicitudIdElement.ValueKind == JsonValueKind.String)
            {
                var solicitudId = solicitudIdElement.GetString();
                if (!string.IsNullOrEmpty(solicitudId))
                {
                    var solicitudNormalizada = solicitudId.Replace("-", "").ToUpperInvariant();
                    if (solicitudNormalizada != solicitudActualNormalizada)
                    {
                        return true;
                    }
                }
            }

            return false;
        }
        catch (Exception)
        {
            return false; // En caso de error, permitir el uso
        }
    }
