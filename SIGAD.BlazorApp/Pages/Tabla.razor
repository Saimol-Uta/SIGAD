    private void CambiarFiltro(string nuevoFiltro)
    {
        if (filtroActual != nuevoFiltro)
        {
            filtroActual = nuevoFiltro;
            paginaActual = 1;
            documentosSeleccionados.Clear();
            StateHasChanged();
        }
    }

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= PaginasTotales)
        {
            paginaActual = nuevaPagina;
            StateHasChanged();
        }
    }

    private async Task AgregarDocumento()
    {
        if (OnAgregar.HasDelegate)
        {
            await OnAgregar.InvokeAsync(TipoDocumento);
            // Refrescar los datos después de agregar
            await Task.Delay(500); // Pequeña pausa para que se complete la operación
            await CargarDocumentos();
        }
    }

    private void ToggleSeleccionDocumento(string idDocumento, bool seleccionado)
    {
        if (string.IsNullOrEmpty(idDocumento)) return;

        // No permitir seleccionar documentos ya usados
        if (documentosUsadosEnSolicitudesPasadas.Contains(idDocumento))
        {
            return;
        }

        if (seleccionado)
        {
            documentosSeleccionados.Add(idDocumento);
        }
        else
        {
            documentosSeleccionados.Remove(idDocumento);
        }
        StateHasChanged();
    }

    private void SeleccionarTodos(ChangeEventArgs args)
    {
        var seleccionarTodos = (bool)args.Value!;
        
        if (seleccionarTodos)
        {
            foreach (var doc in documentosPaginados)
            {
                var id = ObtenerIdDocumento(doc, TipoDocumento);
                if (!string.IsNullOrEmpty(id))
                {
                    documentosSeleccionados.Add(id);
                }
            }
        }
        else
        {
            foreach (var doc in documentosPaginados)
            {
                var id = ObtenerIdDocumento(doc, TipoDocumento);
                if (!string.IsNullOrEmpty(id))
                {
                    documentosSeleccionados.Remove(id);
                }
            }
        }
        StateHasChanged();
    }

    private async Task AplicarDocumentosSeleccionados()
    {
        if (!documentosSeleccionados.Any() || aplicandoDocumentos) return;

        try
        {
            aplicandoDocumentos = true;
            mensajeOperacion = null;
            StateHasChanged();

            // Verificar solicitud activa
            var solicitudResponse = await Http.GetAsync("api/auth/verificar-solicitud-activa");
            if (!solicitudResponse.IsSuccessStatusCode)
            {
                mensajeOperacion = "❌ No hay una solicitud de ascenso activa.";
                operacionExitosa = false;
                return;
            }

            var solicitudJson = await solicitudResponse.Content.ReadAsStringAsync();
            var solicitudDoc = JsonDocument.Parse(solicitudJson);
            
            if (!solicitudDoc.RootElement.TryGetProperty("tieneSolicitudActiva", out var tieneSolicitud) || 
                !tieneSolicitud.GetBoolean())
            {
                mensajeOperacion = "❌ No hay una solicitud de ascenso activa.";
                operacionExitosa = false;
                return;
            }
            
            string? solicitudId = null;
            if (solicitudDoc.RootElement.TryGetProperty("solicitudId", out var solicitudIdElement))
            {
                solicitudId = solicitudIdElement.GetString();
            }

            if (string.IsNullOrEmpty(solicitudId))
            {
                mensajeOperacion = "❌ Error al obtener la solicitud activa.";
                operacionExitosa = false;
                return;
            }

            // Verificar que los documentos no hayan sido usados en solicitudes pasadas
            var documentosYaUsados = new List<string>();
            var documentosDisponibles = new List<string>();

            foreach (var docId in documentosSeleccionados.ToList())
            {
                if (documentosUsadosEnSolicitudesPasadas.Contains(docId))
                {
                    documentosYaUsados.Add(docId);
                }
                else
                {
                    documentosDisponibles.Add(docId);
                }
            }

            // Si hay documentos ya usados, mostrar advertencia
            if (documentosYaUsados.Any())
            {
                var tipoDocumento = TipoDocumento switch
                {
                    "articulos" => "artículos",
                    "cursos" => "cursos", 
                    "experiencias" => "experiencias laborales",
                    "evaluaciones" => "evaluaciones",
                    "investigaciones" => "investigaciones",
                    "tesis" => "tesis dirigidas",
                    _ => "documentos"
                };

                var mensaje = documentosYaUsados.Count == 1 
                    ? $"El {tipoDocumento.Substring(0, tipoDocumento.Length - 1)} seleccionado ya fue utilizado en una solicitud anterior y no puede ser reutilizado."
                    : $"{documentosYaUsados.Count} de los {tipoDocumento} seleccionados ya fueron utilizados en solicitudes anteriores y no pueden ser reutilizados.";

                if (documentosDisponibles.Any())
                {
                    mensaje += $" Se procesarán únicamente los {documentosDisponibles.Count} {tipoDocumento} disponibles.";
                }

                await MostrarSweetAlert("Documentos ya utilizados", mensaje, "warning");

                // Si no hay documentos disponibles, terminar
                if (!documentosDisponibles.Any())
                {
                    return;
                }
            }

            // Aplicar solo los documentos disponibles
            var aplicados = 0;
            var fallidos = 0;

            foreach (var docId in documentosDisponibles)
            {
                try
                {
                    var endpoint = TipoDocumento switch
                    {
                        "articulos" => "api/articulos/asociar-solicitud",
                        "cursos" => $"api/cursos/{docId}/asociar-solicitud",
                        "experiencias" => $"api/experienciaslaborales/{docId}/asociar-solicitud",
                        "evaluaciones" => "api/evaluaciones/asociar-solicitud",
                        "investigaciones" => $"api/investigaciones/{docId}/asociar-solicitud",
                        "tesis" => $"api/TesisDirigidas/{docId}/asociar-solicitud",
                        _ => ""
                    };

                    if (!string.IsNullOrEmpty(endpoint))
                    {
                        object requestData;
                        
                        if (TipoDocumento == "evaluaciones")
                        {
                            requestData = new { 
                                EvaluacionId = int.Parse(docId), 
                                SolicitudId = Guid.Parse(solicitudId) 
                            };
                            // Log temporal para debug
                            Console.WriteLine($"[FRONTEND] Asociando evaluación - ID: {docId}, SolicitudId: {solicitudId}, Endpoint: {endpoint}");
                        }
                        else if (TipoDocumento == "articulos")
                        {
                            requestData = new { 
                                ArticuloDOI = docId,
                                SolicitudId = Guid.Parse(solicitudId) 
                            };
                            // Log temporal para debug
                            Console.WriteLine($"[FRONTEND] Asociando artículo - DOI: '{docId}', SolicitudId: {solicitudId}, Endpoint: {endpoint}");
                        }
                        else if (TipoDocumento == "experiencias")
                        {
                            requestData = new { 
                                ExperienciaId = int.Parse(docId),
                                SolicitudId = Guid.Parse(solicitudId) 
                            };
                            // Log temporal para debug
                            Console.WriteLine($"[FRONTEND] Asociando experiencia - ID: {docId}, SolicitudId: {solicitudId}, Endpoint: {endpoint}");
                        }
                        else if (TipoDocumento == "investigaciones")
                        {
                            requestData = new { 
                                InvestigacionId = int.Parse(docId),
                                SolicitudId = Guid.Parse(solicitudId) 
                            };
                            // Log temporal para debug
                            Console.WriteLine($"[FRONTEND] Asociando investigación - ID: {docId}, SolicitudId: {solicitudId}, Endpoint: {endpoint}");
                        }
                        else
                        {
                            requestData = new { SolicitudId = Guid.Parse(solicitudId) };
                        }
                        
                        var response = await Http.PostAsJsonAsync(endpoint, requestData);
                        
                        // Log temporal para debug
                        if (TipoDocumento == "articulos" || TipoDocumento == "experiencias" || TipoDocumento == "investigaciones")
                        {
                            Console.WriteLine($"[FRONTEND] Respuesta {TipoDocumento} - StatusCode: {response.StatusCode}, IsSuccessStatusCode: {response.IsSuccessStatusCode}");
                            if (!response.IsSuccessStatusCode)
                            {
                                var errorContent = await response.Content.ReadAsStringAsync();
                                Console.WriteLine($"[FRONTEND] Error content: {errorContent}");
                            }
                        }

                        if (response.IsSuccessStatusCode)
                        {
                            aplicados++;
                            documentosSeleccionados.Remove(docId);
                        }
                        else
                        {
                            fallidos++;
                        }
                    }
                    else
                    {
                        fallidos++;
                    }
                }
                catch
                {
                    fallidos++;
                }
            }

            // Mostrar resultado con SweetAlert
            if (aplicados > 0 && fallidos == 0)
            {
                await MostrarSweetAlert(
                    "Asociación exitosa", 
                    $"Se asociaron {aplicados} {(aplicados == 1 ? "documento" : "documentos")} exitosamente.",
                    "success"
                );
                operacionExitosa = true;
            }
            else if (aplicados > 0 && fallidos > 0)
            {
                await MostrarSweetAlert(
                    "Asociación parcial", 
                    $"Se asociaron {aplicados} {(aplicados == 1 ? "documento" : "documentos")}, pero {fallidos} {(fallidos == 1 ? "falló" : "fallaron")}.",
                    "warning"
                );
                operacionExitosa = false;
            }
            else
            {
                await MostrarSweetAlert(
                    "Error en la asociación", 
                    "No se pudo asociar ningún documento.",
                    "error"
                );
                operacionExitosa = false;
            }

            // Recargar documentos para actualizar las listas
            await CargarDocumentos();
            
            // Notificar al componente padre para que actualice los requisitos
            if (OnDocumentosActualizados.HasDelegate)
            {
                await OnDocumentosActualizados.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            mensajeOperacion = $"❌ Error: {ex.Message}";
            operacionExitosa = false;
        }
        finally
        {
            aplicandoDocumentos = false;
            StateHasChanged();

            // Limpiar mensaje después de 5 segundos
            _ = Task.Delay(5000).ContinueWith(_ =>
            {
                mensajeOperacion = null;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task VerPdf(JsonElement doc)
    {
        try
        {
            // Log de depuración solo para tesis
            if (TipoDocumento == "tesis")
            {
                Console.WriteLine($"[DEBUG TESIS] Propiedades disponibles:");
                foreach (var prop in doc.EnumerateObject())
                {
                    var valor = prop.Value.ValueKind == JsonValueKind.String ? prop.Value.GetString() : prop.Value.ToString();
                    Console.WriteLine($"  {prop.Name}: {valor}");
                }
            }

            // Obtener las rutas del documento
            var pdfRuta = ObtenerRutaPdf(doc, TipoDocumento);
            var cloudinaryUrl = ObtenerUrlCloudinary(doc, TipoDocumento);
            
            // Log de depuración solo para tesis
            if (TipoDocumento == "tesis")
            {
                Console.WriteLine($"[DEBUG TESIS] PDF Ruta encontrada: '{pdfRuta}'");
                Console.WriteLine($"[DEBUG TESIS] Cloudinary URL encontrada: '{cloudinaryUrl}'");
            }
            
            string? urlParaUsar = null;
            
            // Usar la misma lógica que FileStorageService.ObtenerMejorUrl()
            // PRIORIDAD 1: Cloudinary URL (CDN rápido)
            if (!string.IsNullOrEmpty(cloudinaryUrl))
            {
                urlParaUsar = cloudinaryUrl;
            }
            // PRIORIDAD 2: URL local como fallback
            else if (!string.IsNullOrEmpty(pdfRuta))
            {
                // Usar la URL base configurada del HttpClient
                var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "https://localhost:7072";
                
                // Misma lógica que FileStorageService.ObtenerMejorUrl()
                var relativePath = pdfRuta.StartsWith("/uploads", StringComparison.OrdinalIgnoreCase)
                    ? pdfRuta
                    : $"/uploads/{pdfRuta.TrimStart('/')}";
                urlParaUsar = $"{baseUrl}{relativePath}";
            }
            
            if (!string.IsNullOrEmpty(urlParaUsar))
            {
                await JSRuntime.InvokeVoidAsync("window.open", urlParaUsar, "_blank");
            }
            else
            {
                mensajeOperacion = "No hay PDF disponible para este documento.";
                operacionExitosa = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            mensajeOperacion = $"Error al abrir PDF: {ex.Message}";
            operacionExitosa = false;
            StateHasChanged();
        }
    }

    private async Task EditarDocumento(JsonElement doc)
    {
        try
        {
            var id = ObtenerIdDocumento(doc, TipoDocumento);
            if (string.IsNullOrEmpty(id))
            {
                await MostrarSweetAlert("Error", "No se pudo obtener el identificador del documento", "error");
                return;
            }

            // Obtener nombre descriptivo para el mensaje
            var nombreDocumento = TipoDocumento switch
            {
                "investigaciones" => "investigación",
                "articulos" => "artículo",
                "experiencias" => "experiencia laboral",
                "evaluaciones" => "evaluación",
                "cursos" => "curso",
                "tesis" => "tesis",
                _ => "documento"
            };

            // Redirigir a la página de edición correspondiente según el tipo de documento
            string ruta = TipoDocumento switch
            {
                "investigaciones" => $"/editar-investigacion/{id}",
                "articulos" => $"/editar-articulo/{Uri.EscapeDataString(id)}",
                "experiencias" => $"/editar-experiencia/{id}",
                "evaluaciones" => $"/editar-evaluacion/{id}",
                "cursos" => $"/editar-curso/{id}",
                "tesis" => $"/editar-tesis/{id}",
                _ => ""
            };

            if (!string.IsNullOrEmpty(ruta))
            {
                // Mostrar mensaje de navegación
                await JSRuntime.InvokeVoidAsync("Swal.fire", new
                {
                    position = "center",
                    icon = "info",
                    title = $"Editando {nombreDocumento}",
                    text = "Redirigiendo al formulario de edición...",
                    showConfirmButton = false,
                    timer = 1000
                });
                
                // Esperar y redirigir
                await Task.Delay(1000);
                Navigation.NavigateTo(ruta);
            }
            else
            {
                await MostrarSweetAlert("Error", "Tipo de documento no soportado para edición", "error");
            }
        }
        catch (Exception ex)
        {
            await MostrarSweetAlert("Error", $"Error al editar documento: {ex.Message}", "error");
        }
    }

