        }
    }

    private string ObtenerAniosExperiencia(JsonElement doc)
    {
        try
        {
            // Si el API ya proporciona el valor calculado, usamos ese
            if (doc.TryGetProperty("aniosExperiencia", out var aniosElement) && 
                aniosElement.ValueKind != JsonValueKind.Null)
            {
                if (aniosElement.ValueKind == JsonValueKind.Number)
                {
                    decimal anios = aniosElement.GetDecimal();
                    return anios.ToString("0.#"); // Formato con un decimal si es necesario
                }
            }

            // Sino, calculamos basados en las fechas
            if (doc.TryGetProperty("fechaInicio", out var fechaInicioElement) && 
                fechaInicioElement.ValueKind != JsonValueKind.Null)
            {
                DateTime fechaInicio = fechaInicioElement.GetDateTime();
                DateTime fechaFin;
                
                // Si hay fecha fin la usamos, sino usamos la fecha actual
                if (doc.TryGetProperty("fechaFin", out var fechaFinElement) && 
                    fechaFinElement.ValueKind != JsonValueKind.Null)
                {
                    fechaFin = fechaFinElement.GetDateTime();
                }
                else
                {
                    fechaFin = DateTime.Today;
                }
                
                // Calcular la diferencia en años
                var diferencia = fechaFin - fechaInicio;
                var anios = diferencia.TotalDays / 365.25; // Considerando años bisiestos
                
                return Math.Round(anios, 1).ToString("0.#"); // Redondear a un decimal
            }
            
            return "N/A"; // Si no hay suficiente información para calcular
        }
        catch
        {
            return "N/A";
        }
    }

