@page "/agregar-investigacion"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "DOCENTE")]
@using SIGAD.BlazorApp.Layout
@using SIGAD.BlazorApp.Services
@attribute [Layout(typeof(EmptyLayout))]
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject ISolicitudService SolicitudService

<PageTitle>Agregar Investigación - SIGAD</PageTitle>



<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
        background-color: #fff;
        color: #86011c;
        height: 100%;
        overflow-x: hidden;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 1;
    }

    .branding {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header img.logo {
        height: 80px;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: #444;
    }

        .user-profile img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid #86011c;
            object-fit: cover;
        }

    .main-content {
        display: flex;
        justify-content: center;
        padding: 2rem;
        min-height: calc(100vh - 120px);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 4px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .btn-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }

    .alert {
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 1rem;
    }

    .alert-danger {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #721c24;
    }

    .alert-success {
        background-color: #d1e7dd;
        border: 1px solid #a3cfbb;
        color: #0f5132;
    }

    .triangle-bg {
        position: fixed;
        bottom: 0;
        right: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
        opacity: 0.1;
    }

    .required {
        color: #dc3545;
    }
</style>

<body>
    <div class="header">
        <div class="branding">
            <img src="/images/logoSIGAD.png" alt="Logo" class="logo" />
            <h1>SIGAD</h1>
        </div>
        <div class="user-profile">
            <a href="/gestion-documentos" class="back-btn">← Volver a Gestión</a>
            <span>@nombreUsuario</span>
            <img src="/images/IconoUser.png" alt="Usuario" />
            <button class="logout-btn" @onclick="Logout">Salir</button>
        </div>
    </div>

    <div class="main-content">
        <div class="form-container">
            <h1>🔬 Agregar Investigación</h1>
            <p class="subtitle">Complete los datos de su investigación para asociarla a su solicitud de ascenso</p>

            @if (isLoading)
            {
                <div class="loading">
                    <p>Cargando formulario...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }
            else
            {
                <EditForm Model="@investigacionModel" OnValidSubmit="@HandleSubmit" enctype="multipart/form-data">
                    <DataAnnotationsValidator />

                    <!-- Información básica -->
                    <div class="form-group">
                        <label class="form-label">Título de la Investigación *</label>
                        <input type="text" class="form-control" @bind="investigacionModel.Titulo" required />
                    </div>

                    <!-- Fechas -->
                    <div class="form-group-row">
                        <div class="form-group">
                            <label class="form-label">Fecha de Inicio *</label>
                            <input type="date" class="form-control" @bind="investigacionModel.FechaInicio" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Fecha de Finalización *</label>
                            <input type="date" class="form-control" @bind="investigacionModel.FechaFinalizacion" required />
                        </div>
                    </div>

                    <!-- Rol y Meses -->
                    <div class="form-group-row">
                        <div class="form-group">
                            <label class="form-label">Rol en la Investigación *</label>
                            <select class="form-control" @bind="investigacionModel.RolEnInvestigacion" required>
                                <option value="">-- Seleccione su rol --</option>
                                <option value="Investigador Principal">Investigador Principal</option>
                                <option value="Co-Investigador">Co-Investigador</option>
                                <option value="Asistente de Investigación">Asistente de Investigación</option>
                                <option value="Consultor">Consultor</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Meses de Investigación *</label>
                            <input type="number" min="1" max="120" class="form-control" @bind="investigacionModel.MesesDeInvestigacion" required />
                        </div>
                    </div>

                    <!-- Archivo del informe -->
                    <div class="form-group">
                        <label class="form-label">Informe de Investigación *</label>
                        <InputFile OnChange="@OnFileSelected" accept=".pdf,.doc,.docx" />
                        @if (!string.IsNullOrEmpty(archivoSeleccionado))
                        {
                            <p>Archivo: @archivoSeleccionado</p>
                        }
                    </div>

                    <!-- Investigación Internacional -->
                    <div class="form-group">
                        <label class="form-label">
                            <input type="checkbox" @bind="investigacionModel.EsInternacional" />
                            Investigación Internacional
                        </label>
                    </div>

                    @if (enviandoFormulario)
                    {
                        <div class="alert alert-info">
                            <strong>Enviando...</strong> Procesando la investigación y subiendo el archivo...
                        </div>
                    }

                    @if (investigacionCreada)
                    {
                        <div class="alert alert-success">
                            ¡Investigación agregada exitosamente! Será redirigido en unos segundos.
                        </div>
                    }

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/gestion-documentos"))" disabled="@enviandoFormulario">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary-agr" disabled="@(enviandoFormulario || archivoFormulario == null)">
                            @if (enviandoFormulario)
                            {
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>💾 Guardar Investigación</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>

    <img src="/images/triangulos.jpg" alt="Background Graphic" class="triangle-bg" />
</body>

@code {
    // Variables del usuario
    private string nombreUsuario = "";

    // Variables del formulario
    private InvestigacionModel investigacionModel = new();
    private IBrowserFile? archivoFormulario;
    private string archivoSeleccionado = "";

    // Variables de estado
    private bool isLoading = true;
    private bool enviandoFormulario = false;
    private bool investigacionCreada = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarInformacionUsuario();
        await VerificarSolicitudActiva();
        isLoading = false;
    }

    private async Task VerificarSolicitudActiva()
    {
        var solicitudId = await SolicitudService.GetSolicitudActualAsync();
        if (string.IsNullOrEmpty(solicitudId))
        {
            // No hay solicitud activa, redirigir al usuario a iniciar una nueva solicitud
            errorMessage = "No hay una solicitud de ascenso activa. Debe iniciar un proceso de ascenso primero.";
            await Task.Delay(3000);
            Navigation.NavigateTo("/iniciar-solicitud-ascenso");
        }
    }

    private async Task CargarInformacionUsuario()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var response = await Http.GetAsync("api/auth/verify");
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<VerifyTokenResponse>();
                    if (result?.Success == true && result.Data != null)
                    {
                        nombreUsuario = $"{result.Data.Nombre1} {result.Data.Apellido1}";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar información del usuario: " + ex.Message;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        archivoFormulario = e.File;
        archivoSeleccionado = e.File.Name;
        
        // Validar tamaño del archivo (25MB)
        if (archivoFormulario.Size > 25 * 1024 * 1024)
        {
            errorMessage = "El archivo es demasiado grande. Máximo permitido: 25MB";
            archivoFormulario = null;
            archivoSeleccionado = "";
            return;
        }

        // Validar extensión
        var extension = Path.GetExtension(archivoFormulario.Name).ToLower();
        var extensionesPermitidas = new[] { ".pdf", ".doc", ".docx" };
        
        if (!extensionesPermitidas.Contains(extension))
        {
            errorMessage = "Formato de archivo no permitido. Use: PDF, DOC o DOCX";
            archivoFormulario = null;
            archivoSeleccionado = "";
            return;
        }

        errorMessage = null;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (enviandoFormulario || archivoFormulario == null) return;

        enviandoFormulario = true;
        errorMessage = null;

        try
        {
            // Obtener cédula del usuario actual
            var cedula = await ObtenerCedulaUsuario();
            if (string.IsNullOrEmpty(cedula))
            {
                errorMessage = "No se pudo obtener la información del usuario";
                return;
            }

            // Obtener el ID real de la solicitud activa
            var solicitudIdString = await SolicitudService.GetSolicitudActualAsync();
            if (string.IsNullOrEmpty(solicitudIdString))
            {
                errorMessage = "No hay una solicitud de ascenso activa. Redirigiendo...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/iniciar-solicitud-ascenso");
                return;
            }

            // Crear el formulario multipart
            using var content = new MultipartFormDataContent();
            
            // Campos requeridos por CrearInvestigacionDto
            content.Add(new StringContent(investigacionModel.Titulo), "Titulo");
            content.Add(new StringContent(investigacionModel.FechaInicio.ToString("yyyy-MM-ddTHH:mm:ss")), "FechaInicio");
            content.Add(new StringContent(investigacionModel.FechaFinalizacion.ToString("yyyy-MM-ddTHH:mm:ss")), "FechaFinalizacion");
            content.Add(new StringContent(investigacionModel.RolEnInvestigacion), "RolEnInvestigacion");
            content.Add(new StringContent(investigacionModel.MesesDeInvestigacion.ToString()), "MesesDeInvestigacion");
            content.Add(new StringContent(cedula), "DocenteCedula");
            content.Add(new StringContent(solicitudIdString), "SolicitudId");
            content.Add(new StringContent(investigacionModel.EsInternacional.ToString()), "EsInternacional"); // Nuevo campo

            // Agregar el archivo
            var fileContent = new StreamContent(archivoFormulario.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(archivoFormulario.ContentType);
            content.Add(fileContent, "informe", archivoFormulario.Name);

            // Enviar la solicitud
            var response = await Http.PostAsync("api/investigaciones", content);

            if (response.IsSuccessStatusCode)
            {
                investigacionCreada = true;
                
                // Redirigir después de 3 segundos
                await Task.Delay(3000);
                Navigation.NavigateTo("/gestion-documentos");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al guardar la investigación: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            enviandoFormulario = false;
        }
    }

    private async Task<string?> ObtenerCedulaUsuario()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var response = await Http.GetAsync("api/auth/verify");
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<VerifyTokenResponse>();
                    return result?.Data?.Cedula;
                }
            }
        }
        catch
        {
            // Silenciar errores
        }
        return null;
    }

    private async Task Logout()
    {
        try
        {
            var response = await Http.PostAsync("api/auth/logout", null);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception)
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login", true);
        }
    }

    // Modelos
    public class InvestigacionModel
    {
        public string Titulo { get; set; } = "";
        public DateTime FechaInicio { get; set; } = DateTime.Today;
        public DateTime FechaFinalizacion { get; set; } = DateTime.Today.AddMonths(6);
        public string RolEnInvestigacion { get; set; } = "";
        public int MesesDeInvestigacion { get; set; } = 1;
        public bool EsInternacional { get; set; } = false; // Nuevo campo
    }

    public class VerifyTokenResponse
    {
        public bool Success { get; set; }
        public UserData? Data { get; set; }
    }

    public class UserData
    {
        public string? Nombre1 { get; set; }
        public string? Apellido1 { get; set; }
        public string? Cedula { get; set; }
    }
}