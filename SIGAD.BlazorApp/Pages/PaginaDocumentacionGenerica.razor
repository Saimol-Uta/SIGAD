@page "/ver-documentos/{Seccion}"
@inject NavigationManager Navigation
@code {
    [Parameter]
    public string Seccion { get; set; } = "";

    private string Titulo => Seccion.Replace("-", " ").ToUpperInvariant();
}

<h3>@Titulo</h3>

<!-- Lista de PDFs asociados a la sección (simulado) -->
<ul>
    <li>Documento_1.pdf</li>
    <li>Documento_2.pdf</li>
</ul>

<!-- Botón para ir a exportar -->
<button class="btn btn-primary" @onclick="IrAExportar">Exportar</button>

@code {
    void IrAExportar()
    {
        Navigation.NavigateTo($"/exportar-documento/{Seccion}");
    }
}
