    private async Task GenerarCertificado(string solicitudId)
    {
        try
        {
            generandoCertificado = true;
            StateHasChanged();

            var resultado = await SolicitudesService.DescargarCertificadoAsync(Guid.Parse(solicitudId));

            if (resultado.success)
            {
                // Crear nombre del archivo con timestamp
                var fileName = $"certificado_accion_personal_{DateTime.Now:yyyyMMddHHmmss}.pdf";

                // Convertir bytes a base64 para JavaScript
                var base64String = Convert.ToBase64String(resultado.pdfData);

                // Descargar el archivo usando JavaScript
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", fileName, base64String);

                MostrarNotificacionExito("Certificado generado y descargado exitosamente");
            }
            else
            {
                MostrarNotificacionError(resultado.message);
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacionError($"Error inesperado al generar certificado: {ex.Message}");
        }
        finally
        {
            generandoCertificado = false;
            StateHasChanged();
        }
    }

    // Métodos de utilidad para estados
    private string GetEstadoClass(string? estado)
    {
        if (string.IsNullOrEmpty(estado))
            return "estado-borrador";

        return estado.ToLower() switch
        {
            "borrador" => "estado-borrador",
            "enviada" => "estado-enviada",
            "en_revision" => "estado-en-revision",
            "aprobada" => "estado-aprobada",
            "rechazada" => "estado-rechazada",
            _ => "estado-borrador"
        };
    }

    private string GetEstadoDisplay(string? estado)
    {
        if (string.IsNullOrEmpty(estado))
            return "Desconocido";

        return estado switch
        {
            "Borrador" => "Borrador",
            "Enviada" => "Enviada",
            "En_Revision" => "En Revisión",
            "Aprobada" => "Aprobada",
            "Rechazada" => "Rechazada",
            _ => estado
        };
    }

    // Métodos de notificación
    private void MostrarNotificacionExito(string mensaje)
    {
        mensajeExito = mensaje;
        mensajeError = null;
        StateHasChanged();

        // Limpiar mensaje después de 5 segundos
        Task.Delay(5000).ContinueWith(_ =>
        {
            mensajeExito = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private void MostrarNotificacionError(string mensaje)
    {
        mensajeError = mensaje;
        mensajeExito = null;
        StateHasChanged();

        // Limpiar mensaje después de 8 segundos
        Task.Delay(8000).ContinueWith(_ =>
        {
            mensajeError = null;
            InvokeAsync(StateHasChanged);
        });
    }

    // DTO para el historial
    public class SolicitudHistorialDto
    {
        public string Id { get; set; } = "";
        public string RangoActual { get; set; } = "";
        public string RangoSolicitado { get; set; } = "";
        public string Estado { get; set; } = "";
        public DateTime? FechaEnvio { get; set; }
        public DateTime? FechaResolucion { get; set; }
    }
}

<script>
    window.downloadFileFromBytes = (fileName, base64Data) => {
        const byteCharacters = atob(base64Data);
        const byteNumbers = new Array(byteCharacters.length);
        for (let i = 0; i < byteCharacters.length; i++) {
            byteNumbers[i] = byteCharacters.charCodeAt(i);
        }
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        const link = document.createElement('a');
        link.href = url;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    };
</script>