@page "/admin-dashboard"
@using SIGAD.BlazorApp.Layout
@attribute [Layout(typeof(EmptyLayout))]
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMINISTRADOR")]

<h1>Panel de Administración</h1>

<div class="dashboard-container">
    <p>Bienvenido al panel de administrador.</p>

    <button class="btn btn-primary" @onclick="RedirigirAVerSolicitude">Ver Solicitudes</button>
</div>

@code {
    private void RedirigirAVerSolicitude()
    {
        NavigationManager.NavigateTo("/ver-solicitudes");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
