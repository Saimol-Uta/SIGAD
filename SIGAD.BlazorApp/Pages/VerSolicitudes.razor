@page "/ver-solicitudes"
@attribute [Layout(typeof(AdminLayout))]
@using SIGAD.BlazorApp.Models
@using SIGAD.BlazorApp.Services
@using SIGAD.BlazorApp.Components
@using System.IO
@inject SolicitudesService SolicitudesService
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    @* Fallback para errores críticos de renderizado o datos vacíos *@
    @if (!mostrarNotificacion && !cargando && string.IsNullOrEmpty(mensajeError) && !solicitudes.Any())
    {
        <div class="alert alert-warning">
            La página se cargó pero no se recibió ningún dato ni mensaje de error. Esto puede indicar un error crítico de Blazor, un problema de autenticación o un fallo de deserialización.
        </div>
    }

    <!-- SweetAlert para notificaciones -->
    @* Las notificaciones ahora se muestran con SweetAlert desde código *@

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            @if (!cargando && solicitudes.Any())
            {
                <div class="d-flex gap-3">
                    <small class="badge bg-primary text-white">
                        <i class="fas fa-list me-1"></i>
                        Total: @solicitudes.Count
                    </small>
                    <small class="badge bg-secondary text-white">
                        <i class="fas fa-hourglass-half me-1"></i>
                        Pendientes: @solicitudes.Count(s => s.Estado == "PendienteRevision")
                    </small>
                </div>
            }
        </div>
        <button class="btn btn-outline-primary" @onclick="CargarSolicitudes" disabled="@cargando">
            @if (cargando)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            else
            {
                <i class="fas fa-sync-alt me-1"></i>
            }
            Actualizar
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2"><em>Cargando solicitudes...</em></p>
        </div>
    }
    else if (mensajeError != null)
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }
    else if (!solicitudes.Any())
    {
        <div class="alert alert-info">
            No hay solicitudes registradas en el sistema.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <style>
  

    .bloque-izquierdo {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .bloque-izquierdo h2 {
        margin: 0;
        color: #0a1d44;
        font-size: 24px;
    }

    .btn, .btn-cerrar, .btn-import, .btn-añadir, .btn-aplicar, .btn-primary {
        background-color: #0a1d44;
        color: white;
        padding: 10px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: background-color 0.2s;
    }

    .btn:hover, .btn-cerrar:hover, .btn-import:hover, .btn-añadir:hover {
        background-color: #0f2554;
    }

    .btn-aplicar {
        background-color: #28a745;
    }

    .btn-aplicar:hover {
        background-color: #218838;
    }

    .btn:disabled {
        background-color: #6c757d;
        cursor: not-allowed;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 6px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .alert-info {
        background-color: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #0a1d44;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 20px auto;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .tabla-documentos {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .tabla-documentos thead {
        background-color: #0a1d44;
        color: white;
    }

    .tabla-documentos th, .tabla-documentos td {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid #eee;
    }

    .tabla-documentos tbody tr:hover {
        background-color: #f8f9fa;
    }

    .opciones-documento {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-opcion {
        width: 24px;
        height: 24px;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .btn-opcion:hover {
        transform: scale(1.1);
    }

    .paginacion {
        display: flex;
        justify-content: center;
        gap: 4px;
        margin: 20px 0;
    }

    .btn-pagina {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        background-color: white;
        color: #495057;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-pagina:hover {
        background-color: #e9ecef;
    }

    .btn-pagina.activa {
        background-color: #0a1d44;
        color: white;
        border-color: #0a1d44;
    }

    .info-paginacion {
        text-align: center;
        color: #6c757d;
        font-size: 14px;
        margin-top: 10px;
    }

    .sin-documentos {
        text-align: center;
        padding: 40px;
        color: #6c757d;
    }

    .sin-documentos h3 {
        margin-bottom: 10px;
        color: #495057;
    }
    .table-warning {
        background-color: white !important;
    }

    /* Estilos para filtros/pestañas */
    .filtros-container {
        display: flex;
        gap: 10px;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 10px;
    }

    .filtro-btn {
        background: #f8f9fa;
        border: 2px solid #dee2e6;
        border-radius: 8px 8px 0 0;
        padding: 12px 20px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        color: #6c757d;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: none;
        margin-bottom: -2px;
        position: relative;
    }

    .filtro-btn:hover {
        background: #e9ecef;
        color: #495057;
        transform: translateY(-2px);
    }

    .filtro-btn.activo {
        background: #0a1d44;
        color: white;
        border-color: #0a1d44;
        z-index: 1;
    }

    .filtro-btn.activo::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: #0a1d44;
    }

    .filtro-btn i {
        font-size: 16px;
    }

    /* Badge para documentos asociados */
    .badge-asociado {
        background: #28a745;
        color: white;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    /* Mejoras adicionales */
    .opciones-documento {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: center;
    }

    .btn-opcion {
        cursor: pointer;
        transition: transform 0.2s ease;
    }

    .btn-opcion:hover {
        transform: scale(1.1);
    }

    .btn-opcion:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    /* Estilo específico para el botón desasociar */
    .btn-desasociar {
        filter: hue-rotate(0deg) brightness(1);
        transition: filter 0.2s ease, transform 0.2s ease;
    }

    .btn-desasociar:hover {
        filter: hue-rotate(15deg) brightness(1.1);
        transform: scale(1.1);
    }

    /* Botón desasociar como elemento button */
    .btn-desasociar-documento {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 4px 8px;
        cursor: pointer;
        font-size: 12px;
        margin-left: 8px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s ease;
    }

    .btn-desasociar-documento:hover {
        background: #c82333;
        transform: scale(1.05);
    }

    .btn-desasociar-documento i {
        font-size: 10px;
    }

    /* Animación para cambio de filtros */
    .tabla-documentos {
        transition: opacity 0.3s ease;
    }

    /* Resaltar fila al hover */
    .tabla-documentos tbody tr:hover {
        background-color: #f8f9fa;
    }

    /* Mejorar visibilidad de checkbox */
    input[type="checkbox"] {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }
                    </style>
                    <table class="table tabla-sigad">
                        <thead>
                            <tr>
                                <th>Docente</th>
                                <th>Cédula</th>
                                <th>Rango Solicitado</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solicitud in solicitudes)
                            {
                                <tr class="@GetRowClass(solicitud)" style="vertical-align: middle;">
                                    <td>
                                        <strong>@solicitud.DocenteNombreCompleto</strong>
                                    </td>
                                    <td>
                                        <span>@solicitud.DocenteCedula</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @solicitud.RangoSolicitadoNombre
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @solicitud.FechaCreacion.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        @GetEstadoBadge(solicitud.Estado)
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            @if (solicitud.Estado == "Aprobada" && solicitud.ApelacionId != null)
                                            {
                                                <button class="btn btn-info btn-sm" @onclick="() => MostrarModalDetalleApelacion((int)solicitud.ApelacionId)">
                                                    <i class="fas fa-eye me-1"></i>
                                                    Ver Detalle
                                                </button>
                                            }
                                            else if (solicitud.TieneApelacion || solicitud.Estado == "EnApelacion")
                                            {
                                                <button class="btn btn-warning btn-sm" 
                                                        @onclick="() => ResolverApelacion(solicitud.Id)">
                                                    <i class="fas fa-gavel me-1"></i>
                                                    Resolver Apelación
                                                </button>
                                            }
                                            else if (solicitud.Estado == "PendienteRevision")
                                            {
                                                <button class="btn btn-success btn-sm" 
                                                        @onclick="() => AprobarSolicitud(solicitud.Id)">
                                                    <i class="fas fa-check me-1"></i>
                                                    Aprobar
                                                </button>
                                                <button class="btn btn-danger btn-sm" 
                                                        @onclick="() => RechazarSolicitud(solicitud.Id)">
                                                    <i class="fas fa-times me-1"></i>
                                                    Rechazar
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    Sin acciones disponibles
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal para resolver apelación o ver detalle -->
@if (mostrarModalApelacion || mostrarModalDetalle)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(mostrarModalDetalle
                            ? (MarkupString)"<i class='fas fa-eye me-2'></i> Detalle de Solicitud"
                            : (MarkupString)"<i class='fas fa-gavel me-2'></i> Resolver Apelación")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalApelacion"></button>
                </div>
                <div class="modal-body">
                    @if (cargandoApelacion)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando detalles de la solicitud...</p>
                        </div>
                    }
                    else if (apelacionDetalle != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Información del Docente</h6>
                                <p><strong>Nombre:</strong> @(apelacionDetalle?.DocenteNombre ?? "")</p>
                                <p><strong>Cédula:</strong> @(apelacionDetalle?.DocenteCedula ?? "")</p>
                                <p><strong>Rango Solicitado:</strong> @(apelacionDetalle?.RangoSolicitado ?? "")</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Información de la Solicitud</h6>
                                <p><strong>Fecha de Solicitud:</strong> @(apelacionDetalle != null ? apelacionDetalle.FechaSolicitud.ToString("dd/MM/yyyy") : "")</p>
                                <p><strong>Estado Actual:</strong> @(apelacionDetalle?.EstadoSolicitud ?? "")</p>
                                <p><strong>Fecha de Apelación:</strong> @(apelacionDetalle != null ? apelacionDetalle.FechaCreacion.ToString("dd/MM/yyyy") : "")</p>
                            </div>
                        </div>
                        <hr />
                        <h6>Justificación de la Apelación</h6>
                        <div class="card bg-light">
                            <div class="card-body">
                                <p>@(apelacionDetalle?.Justificacion ?? "")</p>
                            </div>
