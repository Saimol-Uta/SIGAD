@code {
    private List<SolicitudConApelacionDto> solicitudes = new();
    private bool cargando = true;
    private string? mensajeError = null;
    private string? mensajeExito = null;
    private bool mostrarNotificacion = false;
    
    // Variables para el modal de apelación
    private bool mostrarModalApelacion = false;
    private bool mostrarModalDetalle = false;
    private bool cargandoApelacion = false;
    private ApelacionDetalleDto? apelacionDetalle = null;
    private Guid solicitudSeleccionadaId = Guid.Empty;
    private bool apelacionAceptada = true;
    private string observacionesResolucion = "";
    private bool procesandoResolucion = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarSolicitudes();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error crítico al inicializar la página: {ex.Message}";
            mostrarNotificacion = true;
        }
    }

    private async Task CargarSolicitudes()
    {
        try
        {
            cargando = true;
            mensajeError = null;
            solicitudes = new List<SolicitudConApelacionDto>();
            try
            {
                solicitudes = await SolicitudesService.GetSolicitudesConApelacionesAsync();
                if (solicitudes == null || solicitudes.Count == 0)
                {
                    mensajeError = "No se encontraron solicitudes o la respuesta fue vacía.";
                }
            }
            catch (System.Net.Http.HttpRequestException httpEx)
            {
                mensajeError = $"Error de red o autenticación al cargar las solicitudes: {httpEx.Message}";
            }
            catch (System.Text.Json.JsonException jsonEx)
            {
                mensajeError = $"Error de formato de datos al procesar la respuesta del servidor: {jsonEx.Message}";
            }
            catch (Exception ex)
            {
                mensajeError = $"Error inesperado al cargar las solicitudes: {ex.Message}";
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarEstado(Guid solicitudId, string nuevoEstado)
    {
        try
        {
            (bool success, string message) resultado = (false, "Estado no soportado");

            switch (nuevoEstado)
            {
                case "Aprobada":
                    resultado = await SolicitudesService.AprobarSolicitudAsync(solicitudId, "Solicitud aprobada desde panel administrativo");
                    break;
                case "Rechazada":
                    resultado = await SolicitudesService.RechazarSolicitudAsync(solicitudId, "Solicitud rechazada desde panel administrativo");
                    break;
                default:
                    resultado = (false, $"Estado '{nuevoEstado}' no soportado para cambio directo");
                    break;
            }

            if (resultado.success)
            {
                MostrarNotificacionExito(resultado.message);
                await CargarSolicitudes(); // Recargar las solicitudes para mostrar cambios
            }
            else
            {
                MostrarNotificacionError(resultado.message);
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacionError($"Error al cambiar estado: {ex.Message}");
        }
    }

    private MarkupString GetEstadoBadge(string estado)
    {
        var badgeClass = estado switch
        {
            "PendienteRevision" => "bg-secondary",
            "Aprobada" => "bg-success",
            "Rechazada" => "bg-danger",
            "EnApelacion" => "bg-warning text-dark",
            "Finalizada" => "bg-primary",
            _ => "bg-secondary"
        };

        var icon = estado switch
        {
            "PendienteRevision" => "fas fa-hourglass-half",
            "Aprobada" => "fas fa-check-circle",
            "Rechazada" => "fas fa-times-circle",
            "EnApelacion" => "fas fa-gavel",
            "Finalizada" => "fas fa-flag-checkered",
            _ => "fas fa-question-circle"
        };

        return new MarkupString($"<span class=\"badge {badgeClass}\"><i class=\"{icon} me-1\"></i>{estado}</span>");
    }

    private string GetRowClass(SolicitudConApelacionDto solicitud)
    {
        if (solicitud.TieneApelacion && solicitud.Estado == "EnApelacion")
        {
            return "table-warning";
        }
        return "";
    }

    private async Task ResolverApelacion(Guid solicitudId)
    {
        await MostrarModalResolverApelacion(solicitudId, false);
    }


    private async Task MostrarModalDetalleApelacion(int apelacionId)
    {
        try
        {
            mostrarModalDetalle = true;
            mostrarModalApelacion = false;
            cargandoApelacion = true;
            apelacionDetalle = null;
            apelacionAceptada = true;
            observacionesResolucion = "";

            apelacionDetalle = await SolicitudesService.GetApelacionDetalleByApelacionIdAsync(apelacionId);

            if (apelacionDetalle == null)
            {
                throw new Exception("RESTRINGIDO ya fue Resolvido");
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacionError($"Error al cargar detalles de la apelación: {ex.Message}");
            CerrarModalApelacion();
        }
        finally
        {
            cargandoApelacion = false;
        }
    }

    private async Task MostrarModalResolverApelacion(Guid solicitudId, bool soloDetalle)
    {
        try
        {
            solicitudSeleccionadaId = solicitudId;
            mostrarModalApelacion = !soloDetalle;
            mostrarModalDetalle = soloDetalle;
            cargandoApelacion = true;
            apelacionDetalle = null;
            apelacionAceptada = true;
            observacionesResolucion = "";

            // Cargar detalles de la apelación/solicitud
            apelacionDetalle = await SolicitudesService.GetApelacionDetalleAsync(solicitudId);

            if (apelacionDetalle == null)
            {
                throw new Exception("No se pudieron obtener los detalles de la solicitud");
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacionError($"Error al cargar detalles de la solicitud: {ex.Message}");
            CerrarModalApelacion();
        }
        finally
        {
            cargandoApelacion = false;
        }
    }

    private void CerrarModalApelacion()
    {
        mostrarModalApelacion = false;
        mostrarModalDetalle = false;
        cargandoApelacion = false;
        apelacionDetalle = null;
        solicitudSeleccionadaId = Guid.Empty;
        observacionesResolucion = "";
        procesandoResolucion = false;
    }

    private async Task ProcesarResolucionApelacion()
    {
        if (apelacionDetalle is null) 
        {
            MostrarNotificacionError("No se puede procesar la apelación: detalles no disponibles");
            return;
        }

        try
        {
            procesandoResolucion = true;
            
            Console.WriteLine($"Procesando resolución de apelación ID: {apelacionDetalle.Id}, Aceptada: {apelacionAceptada}, Observaciones: {observacionesResolucion}");
            
            var resultado = await SolicitudesService.ResolverApelacionAsync(
                apelacionDetalle.Id, // Ahora es int, se pasa directo
                apelacionAceptada, 
                observacionesResolucion);

            if (resultado.success)
            {
                MostrarNotificacionExito(resultado.message);
                CerrarModalApelacion();
                await CargarSolicitudes(); // Recargar la lista
            }
            else
            {
                MostrarNotificacionError(resultado.message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al resolver apelación: {ex}");
            MostrarNotificacionError($"Error al resolver apelación: {ex.Message}");
        }
        finally
        {
            procesandoResolucion = false;
        }
    }

    private async Task AprobarSolicitud(Guid solicitudId)
    {
        await CambiarEstado(solicitudId, "Aprobada");
    }

    private async Task RechazarSolicitud(Guid solicitudId)
    {
        await CambiarEstado(solicitudId, "Rechazada");
    }

    private void OcultarNotificacion()
    {
        mostrarNotificacion = false;
        mensajeError = null;
        mensajeExito = null;
    }

    // SweetAlert para notificaciones modernas
    private async void MostrarNotificacionExito(string mensaje)
    {
        await MostrarSweetAlert("¡Éxito!", mensaje, "success", true);
    }

    private async void MostrarNotificacionError(string mensaje)
    {
        await MostrarSweetAlert("Error", mensaje, "error");
    }

    // Función auxiliar para SweetAlert
    private async Task MostrarSweetAlert(string titulo, string mensaje, string icono, bool autoClose = false)
    {
        if (autoClose)
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", new
            {
                position = "center",
                icon = icono,
                title = titulo,
                text = mensaje,
                showConfirmButton = false,
                timer = 1500
            });
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire",
                new { title = titulo, text = mensaje, icon = icono, confirmButtonColor = "#0a1d44" });
        }
    }
}
