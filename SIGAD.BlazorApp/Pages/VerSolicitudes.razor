@page "/ver-solicitudes"
@layout AdminLayout
@using SIGAD.BlazorApp.Models
@using SIGAD.BlazorApp.Services
@using System.IO
@inject ISolicitudesService SolicitudesService
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    @* Fallback para errores críticos de renderizado o datos vacíos *@
    @if (!mostrarNotificacion && !cargando && string.IsNullOrEmpty(mensajeError) && !solicitudes.Any())
    {
        <div class="alert alert-warning">
            La página se cargó pero no se recibió ningún dato ni mensaje de error. Esto puede indicar un error crítico de Blazor, un problema de autenticación o un fallo de deserialización.
        </div>
    }

    <!-- Zona de notificaciones -->
    @if (mostrarNotificacion && !string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@mensajeExito
            <button type="button" class="btn-close" @onclick="() => OcultarNotificacion()"></button>
        </div>
    }
    @if (mostrarNotificacion && !string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@mensajeError
            <button type="button" class="btn-close" @onclick="() => OcultarNotificacion()"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary mb-1">
                <i class="fas fa-clipboard-list me-2"></i>
                Gestión de Solicitudes de Ascenso
            </h3>
            @if (!cargando && solicitudes.Any())
            {
                <div class="d-flex gap-3">
                    <small class="badge bg-light text-dark">
                        <i class="fas fa-list me-1"></i>
                        Total: @solicitudes.Count
                    </small>
                    <small class="badge bg-warning text-dark">
                        <i class="fas fa-gavel me-1"></i>
                        Con Apelaciones: @solicitudes.Count(s => s.TieneApelacion)
                    </small>
                    <small class="badge bg-secondary">
                        <i class="fas fa-hourglass-half me-1"></i>
                        Pendientes: @solicitudes.Count(s => s.Estado == "PendienteRevision")
                    </small>
                </div>
            }
        </div>
        <button class="btn btn-outline-primary" @onclick="CargarSolicitudes" disabled="@cargando">
            @if (cargando)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            else
            {
                <i class="fas fa-sync-alt me-1"></i>
            }
            Actualizar
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2"><em>Cargando solicitudes...</em></p>
        </div>
    }
    else if (mensajeError != null)
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }
    else if (!solicitudes.Any())
    {
        <div class="alert alert-info">
            No hay solicitudes registradas en el sistema.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Docente</th>
                                <th>Rango Solicitado</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Apelación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solicitud in solicitudes)
                            {
                                <tr class="@GetRowClass(solicitud)">
                                    <td>
                                        <strong>@solicitud.DocenteNombreCompleto</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @solicitud.RangoSolicitadoNombre
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @solicitud.FechaCreacion.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        @GetEstadoBadge(solicitud.Estado)
                                    </td>
                                    <td>
                                        @if (solicitud.TieneApelacion)
                                        {
                                            <div class="d-flex flex-column">
                                                <span class="badge bg-warning text-dark mb-1">
                                                    <i class="fas fa-gavel me-1"></i>
                                                    En Apelación
                                                </span>
                                                @if (solicitud.FechaApelacion.HasValue)
                                                {
                                                    <small class="text-muted">
                                                        @solicitud.FechaApelacion.Value.ToString("dd/MM/yyyy")
                                                    </small>
                                                }
                                            </div>
                                        }
                                        else if (solicitud.Estado == "Rechazada" && solicitud.FechaLimiteApelacion.HasValue)
                                        {
                                            if (solicitud.ApelacionVencida)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-clock me-1"></i>
                                                    Plazo vencido
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-calendar-check me-1"></i>
                                                    @solicitud.DiasRestantesApelacion días restantes
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <!-- DEBUG: Información de depuración -->
                                            <div class="d-block mb-2">
                                                <small class="text-muted">
                                                    Estado: '@solicitud.Estado' | TieneApelacion: @solicitud.TieneApelacion
                                                </small>
                                            </div>
                                            
                                            @if (solicitud.TieneApelacion || solicitud.Estado == "EnApelacion")
                                            {
                                                <button class="btn btn-sm btn-warning" 
                                                        @onclick="() => ResolverApelacion(solicitud.Id)">
                                                    <i class="fas fa-gavel me-1"></i>
                                                    Resolver Apelación
                                                </button>
                                            }
                                            else if (solicitud.Estado == "PendienteRevision")
                                            {
                                                <button class="btn btn-sm btn-success" 
                                                        @onclick="() => AprobarSolicitud(solicitud.Id)">
                                                    <i class="fas fa-check me-1"></i>
                                                    Aprobar
                                                </button>
                                                <button class="btn btn-sm btn-danger" 
                                                        @onclick="() => RechazarSolicitud(solicitud.Id)">
                                                    <i class="fas fa-times me-1"></i>
                                                    Rechazar
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    Sin acciones disponibles
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal para resolver apelación -->
@if (mostrarModalApelacion)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-gavel me-2"></i>
                        Resolver Apelación
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalApelacion"></button>
                </div>
                <div class="modal-body">
                    @if (cargandoApelacion)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando detalles de la apelación...</p>
                        </div>
                    }
                    else if (apelacionDetalle != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Información del Docente</h6>
                                <p><strong>Nombre:</strong> @apelacionDetalle.DocenteNombre</p>
                                <p><strong>Email:</strong> @apelacionDetalle.DocenteEmail</p>
                                <p><strong>Rango Solicitado:</strong> @apelacionDetalle.RangoSolicitado</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Información de la Solicitud</h6>
                                <p><strong>Fecha de Solicitud:</strong> @apelacionDetalle.FechaSolicitud.ToString("dd/MM/yyyy")</p>
                                <p><strong>Estado Actual:</strong> @apelacionDetalle.EstadoSolicitud</p>
                                <p><strong>Fecha de Apelación:</strong> @apelacionDetalle.FechaCreacion.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                        
                        <hr />
                        
                        <h6>Justificación de la Apelación</h6>
                        <div class="card bg-light">
                            <div class="card-body">
                                <p>@apelacionDetalle.Justificacion</p>
                            </div>
                        </div>
                        
                        @if (apelacionDetalle.DocumentosAdjuntos.Any())
                        {
                            <h6 class="mt-3">Documentos Adjuntos</h6>
                            <ul class="list-group">
                                @foreach (var documento in apelacionDetalle.DocumentosAdjuntos)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        @Path.GetFileName(documento)
                                        <a href="@documento" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-download"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        
                        @if (!string.IsNullOrEmpty(apelacionDetalle.ObservacionesRechazo))
                        {
                            <h6 class="mt-3">Observaciones del Rechazo Original</h6>
                            <div class="card bg-warning bg-opacity-25">
                                <div class="card-body">
                                    <p>@apelacionDetalle.ObservacionesRechazo</p>
                                </div>
                            </div>
                        }
                        
                        <hr />
                        
                        <div class="mb-3">
                            <label class="form-label"><strong>Decisión sobre la Apelación</strong></label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="decision" id="aceptar" 
                                       @onchange="() => apelacionAceptada = true" checked="@apelacionAceptada">
                                <label class="form-check-label text-success" for="aceptar">
                                    <i class="fas fa-check me-1"></i>
                                    Aceptar Apelación (Aprobar solicitud automáticamente)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="decision" id="rechazar" 
                                       @onchange="() => apelacionAceptada = false" checked="@(!apelacionAceptada)">
                                <label class="form-check-label text-danger" for="rechazar">
                                    <i class="fas fa-times me-1"></i>
                                    Rechazar Apelación (Mantener solicitud rechazada)
                                </label>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="observacionesResolucion" class="form-label">
                                <strong>Observaciones de la Resolución</strong>
                            </label>
                            <textarea class="form-control" id="observacionesResolucion" rows="4"
                                      @bind="observacionesResolucion" 
                                      placeholder="Ingrese las observaciones sobre la resolución de la apelación..."></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            Error al cargar los detalles de la apelación. Por favor, intente nuevamente.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalApelacion">
                        Cancelar
                    </button>
                    @if (apelacionDetalle != null && !cargandoApelacion)
                    {
                        <button type="button" class="btn btn-primary" @onclick="ProcesarResolucionApelacion" disabled="@procesandoResolucion">
                            @if (procesandoResolucion)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="fas fa-gavel me-1"></i>
                            Resolver Apelación
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<SolicitudConApelacionDto> solicitudes = new();
    private bool cargando = true;
    private string? mensajeError = null;
    private string? mensajeExito = null;
    private bool mostrarNotificacion = false;
    
    // Variables para el modal de apelación
    private bool mostrarModalApelacion = false;
    private bool cargandoApelacion = false;
    private ApelacionDetalleDto? apelacionDetalle = null;
    private Guid solicitudSeleccionadaId = Guid.Empty;
    private bool apelacionAceptada = true;
    private string observacionesResolucion = "";
    private bool procesandoResolucion = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarSolicitudes();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error crítico al inicializar la página: {ex.Message}";
            mostrarNotificacion = true;
        }
    }

    private async Task CargarSolicitudes()
    {
        try
        {
            cargando = true;
            mensajeError = null;
            solicitudes = new List<SolicitudConApelacionDto>();
            try
            {
                solicitudes = await SolicitudesService.GetSolicitudesConApelacionesAsync();
                if (solicitudes == null || solicitudes.Count == 0)
                {
                    mensajeError = "No se encontraron solicitudes o la respuesta fue vacía.";
                }
            }
            catch (System.Net.Http.HttpRequestException httpEx)
            {
                mensajeError = $"Error de red o autenticación al cargar las solicitudes: {httpEx.Message}";
            }
            catch (System.Text.Json.JsonException jsonEx)
            {
                mensajeError = $"Error de formato de datos al procesar la respuesta del servidor: {jsonEx.Message}";
            }
            catch (Exception ex)
            {
                mensajeError = $"Error inesperado al cargar las solicitudes: {ex.Message}";
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarEstado(Guid solicitudId, string nuevoEstado)
    {
        try
        {
            (bool success, string message) resultado = (false, "Estado no soportado");

            switch (nuevoEstado)
            {
                case "Aprobada":
                    resultado = await SolicitudesService.AprobarSolicitudAsync(solicitudId, "Solicitud aprobada desde panel administrativo");
                    break;
                case "Rechazada":
                    resultado = await SolicitudesService.RechazarSolicitudAsync(solicitudId, "Solicitud rechazada desde panel administrativo");
                    break;
                default:
                    resultado = (false, $"Estado '{nuevoEstado}' no soportado para cambio directo");
                    break;
            }

            if (resultado.success)
            {
                MostrarNotificacionExito(resultado.message);
                await CargarSolicitudes(); // Recargar las solicitudes para mostrar cambios
            }
            else
            {
                MostrarNotificacionError(resultado.message);
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacionError($"Error al cambiar estado: {ex.Message}");
        }
    }

    private MarkupString GetEstadoBadge(string estado)
    {
        var badgeClass = estado switch
        {
            "PendienteRevision" => "bg-secondary",
            "Aprobada" => "bg-success",
            "Rechazada" => "bg-danger",
            "EnApelacion" => "bg-warning text-dark",
            "Finalizada" => "bg-primary",
            _ => "bg-secondary"
        };

        var icon = estado switch
        {
            "PendienteRevision" => "fas fa-hourglass-half",
            "Aprobada" => "fas fa-check-circle",
            "Rechazada" => "fas fa-times-circle",
            "EnApelacion" => "fas fa-gavel",
            "Finalizada" => "fas fa-flag-checkered",
            _ => "fas fa-question-circle"
        };

        return new MarkupString($"<span class=\"badge {badgeClass}\"><i class=\"{icon} me-1\"></i>{estado}</span>");
    }

    private string GetRowClass(SolicitudConApelacionDto solicitud)
    {
        if (solicitud.TieneApelacion && solicitud.Estado == "EnApelacion")
        {
            return "table-warning";
        }
        return "";
    }

    private async Task ResolverApelacion(Guid solicitudId)
    {
        await MostrarModalResolverApelacion(solicitudId);
    }

    private async Task MostrarModalResolverApelacion(Guid solicitudId)
    {
        try
        {
            solicitudSeleccionadaId = solicitudId;
            mostrarModalApelacion = true;
            cargandoApelacion = true;
            apelacionDetalle = null;
            apelacionAceptada = true;
            observacionesResolucion = "";
            
            // Cargar detalles de la apelación
            apelacionDetalle = await SolicitudesService.GetApelacionDetalleAsync(solicitudId);
            
            // Comprobar que se haya cargado correctamente
            if (apelacionDetalle == null)
            {
                throw new Exception("No se pudieron obtener los detalles de la apelación");
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacionError($"Error al cargar detalles de la apelación: {ex.Message}");
            CerrarModalApelacion();
        }
        finally
        {
            cargandoApelacion = false;
        }
    }

    private void CerrarModalApelacion()
    {
        mostrarModalApelacion = false;
        cargandoApelacion = false;
        apelacionDetalle = null;
        solicitudSeleccionadaId = Guid.Empty;
        observacionesResolucion = "";
        procesandoResolucion = false;
    }

    private async Task ProcesarResolucionApelacion()
    {
        if (apelacionDetalle is null) 
        {
            MostrarNotificacionError("No se puede procesar la apelación: detalles no disponibles");
            return;
        }

        try
        {
            procesandoResolucion = true;
            
            Console.WriteLine($"Procesando resolución de apelación ID: {apelacionDetalle.Id}, Aceptada: {apelacionAceptada}, Observaciones: {observacionesResolucion}");
            
            var resultado = await SolicitudesService.ResolverApelacionAsync(
                apelacionDetalle.Id, // Ahora es int, se pasa directo
                apelacionAceptada, 
                observacionesResolucion);

            if (resultado.success)
            {
                MostrarNotificacionExito(resultado.message);
                CerrarModalApelacion();
                await CargarSolicitudes(); // Recargar la lista
            }
            else
            {
                MostrarNotificacionError(resultado.message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al resolver apelación: {ex}");
            MostrarNotificacionError($"Error al resolver apelación: {ex.Message}");
        }
        finally
        {
            procesandoResolucion = false;
        }
    }

    private async Task AprobarSolicitud(Guid solicitudId)
    {
        await CambiarEstado(solicitudId, "Aprobada");
    }

    private async Task RechazarSolicitud(Guid solicitudId)
    {
        await CambiarEstado(solicitudId, "Rechazada");
    }

    private void OcultarNotificacion()
    {
        mostrarNotificacion = false;
        mensajeError = null;
        mensajeExito = null;
    }

    private void MostrarNotificacionExito(string mensaje)
    {
        mensajeExito = mensaje;
        mensajeError = null;
        mostrarNotificacion = true;
        
        // Auto-ocultar después de 5 segundos
        Task.Delay(5000).ContinueWith(_ => 
        {
            InvokeAsync(() => 
            {
                OcultarNotificacion();
                StateHasChanged();
            });
        });
    }

    private void MostrarNotificacionError(string mensaje)
    {
        mensajeError = mensaje;
        mensajeExito = null;
        mostrarNotificacion = true;
        
        // Auto-ocultar después de 8 segundos (más tiempo para errores)
        Task.Delay(8000).ContinueWith(_ => 
        {
            InvokeAsync(() => 
            {
                OcultarNotificacion();
                StateHasChanged();
            });
        });
    }
}
