@page "/ver-solicitudes"
@using SIGAD.BlazorApp.Models
@inject HttpClient Http

<h3>Solicitudes</h3>

@if (solicitudes == null)
{
    <p><em>Cargando...</em></p>
}
else if (!solicitudes.Any())
{
    <p>No hay solicitudes.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre del Docente</th>
                <th>Rango Actual</th>
                <th>Rango Solicitado</th>
                <th>Fecha de Creación</th>
                <th>Estado</th>
                <th>Cambiar Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in solicitudes)
            {
                <tr>
                    <td>@solicitud.NombreDocente</td>
                    <td>@solicitud.RangoActual</td>
                    <td>@solicitud.RangoSolicitado</td>
                    <td>@solicitud.FechaCreacion.ToShortDateString()</td>
                    <td>@solicitud.Estado</td>
                    <td>
                        <select class="form-select" @onchange="(e) => CambiarEstado(solicitud.Id, e.Value?.ToString() ?? solicitud.Estado)">
                            @foreach (var estado in estadosDisponibles)
                            {
                                <option value="@estado" selected="@(estado == solicitud.Estado)">
                                    @estado
                                </option>
                            }
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<VerSolicitudDTO>? solicitudes;

    private readonly List<string> estadosDisponibles = new()
    {
        "Aprobada", "Rechazada"
    };

    protected override async Task OnInitializedAsync()
    {
        // Simulación de datos de ejemplo
        await Task.Delay(500); // Simula una carga asíncrona
        solicitudes = new List<VerSolicitudDTO>
        {
            new VerSolicitudDTO
            {
                Id = Guid.NewGuid(),
                NombreDocente = "Ana Pérez",
                RangoActual = "Asistente",
                RangoSolicitado = "Asociado",
                Estado = "Aprobada",
                FechaCreacion = DateTime.Now.AddDays(-3)
            },
            new VerSolicitudDTO
            {
                Id = Guid.NewGuid(),
                NombreDocente = "Luis Gómez",
                RangoActual = "Asociado",
                RangoSolicitado = "Titular",
                Estado = "Rechazada",
                FechaCreacion = DateTime.Now.AddDays(-7)
            }
        };
    }

    private async Task CambiarEstado(Guid id, string nuevoEstado)
    {
        if (string.IsNullOrEmpty(nuevoEstado))
        {
            return; // No hacer nada si el nuevo estado es nulo o vacío
        }

        var solicitud = solicitudes?.FirstOrDefault(s => s.Id == id);
        if (solicitud != null && nuevoEstado != solicitud.Estado)
        {
            try
            {
                // Aquí deberías hacer una llamada a la API para actualizar el estado de la solicitud
                // Por ahora, solo actualizamos localmente
                solicitud.Estado = nuevoEstado;
                
                // Ejemplo de cómo podría ser la llamada a la API:
                // var response = await Http.PutAsJsonAsync($"api/solicitudes/{id}/estado", new { estado = nuevoEstado });
                // if (response.IsSuccessStatusCode)
                // {
                //    // Actualización exitosa
                // }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al cambiar el estado: {ex.Message}");
            }
        }
    }
}
