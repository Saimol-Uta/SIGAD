</style>

@code {
    [Parameter] public string TipoDocumento { get; set; } = "";
    [Parameter] public string Cedula { get; set; } = "";
    [Parameter] public EventCallback OnCerrar { get; set; }

    private bool cargando = true;
    private string? mensajeError = null;
    private List<JsonElement> documentos = new();
    private int paginaActual = 1;
    private int porPagina = 10;

    private ConfiguracionTabla config = new();
    private List<JsonElement> documentosPaginados => documentos
    .Skip((paginaActual - 1) * porPagina)
    .Take(porPagina)
    .ToList();
    private int totalPaginas => (int)Math.Ceiling((double)documentos.Count / porPagina);

    protected override async Task OnInitializedAsync()
    {
        config = ObtenerConfiguracion(TipoDocumento);
        await CargarDocumentos();
    }

    private async Task CargarDocumentos()
    {
        if (string.IsNullOrEmpty(Cedula) || string.IsNullOrEmpty(TipoDocumento))
            return;

        try
        {
            cargando = true;
            mensajeError = null;
            documentos.Clear();
            StateHasChanged();

            // Usar exactamente los mismos endpoints que Tabla.razor
            string endpoint = TipoDocumento switch
            {
                "investigaciones" => $"api/investigaciones/docente/{Cedula}",
                "articulos" => $"api/articulos/docente/{Cedula}",
                "tesis" => $"api/TesisDirigidas/docente/{Cedula}",
                "experiencias" => $"api/experienciaslaborales/docente/{Cedula}",
                "cursos" => $"api/cursos/docente/{Cedula}",
                "evaluaciones" => $"api/evaluaciones/docente/{Cedula}",
                _ => ""
            };

            if (!string.IsNullOrEmpty(endpoint))
            {
                var response = await Http.GetAsync(endpoint);
                if (response.IsSuccessStatusCode)
                {
                    var jsonString = await response.Content.ReadAsStringAsync();
                    var jsonDoc = JsonDocument.Parse(jsonString);

                    List<JsonElement> todosLosDocumentos = new();

                    // Manejar tanto respuestas directas como con wrapper "data"
                    if (jsonDoc.RootElement.ValueKind == JsonValueKind.Array)
                    {
                        todosLosDocumentos = jsonDoc.RootElement.EnumerateArray().ToList();
                    }
                    else if (jsonDoc.RootElement.TryGetProperty("data", out var dataElement) &&
                    dataElement.ValueKind == JsonValueKind.Array)
                    {
                        todosLosDocumentos = dataElement.EnumerateArray().ToList();
                    }

                    // En modo inventario, mostramos todos los documentos
                    documentos = todosLosDocumentos;
                }
                else
                {
                    mensajeError = $"Error al cargar {TipoDocumento}: {response.StatusCode}";
                    documentos = new();
                }
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar documentos: {ex.Message}";
            documentos = new();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CerrarTabla()
    {
        await OnCerrar.InvokeAsync();
    }

    private async Task VerDocumento(JsonElement documento)
    {
        try
        {
            // Obtener las rutas del documento
            var pdfRuta = ObtenerRutaPdf(documento, TipoDocumento);
            var cloudinaryUrl = ObtenerUrlCloudinary(documento, TipoDocumento);

            string? urlParaUsar = null;

            // Usar la misma lógica que Tabla.razor
            // PRIORIDAD 1: Cloudinary URL (CDN rápido)
            if (!string.IsNullOrEmpty(cloudinaryUrl))
            {
                urlParaUsar = cloudinaryUrl;
            }
            // PRIORIDAD 2: URL local como fallback
            else if (!string.IsNullOrEmpty(pdfRuta))
            {
                // Usar la URL base configurada del HttpClient
                var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "https://localhost:7072";

                var relativePath = pdfRuta.StartsWith("/uploads", StringComparison.OrdinalIgnoreCase)
                ? pdfRuta
                : $"/uploads/{pdfRuta.TrimStart('/')}";

                urlParaUsar = $"{baseUrl}{relativePath}";
            }

            if (!string.IsNullOrEmpty(urlParaUsar))
            {
                await JSRuntime.InvokeVoidAsync("window.open", urlParaUsar, "_blank");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "No hay PDF disponible para este documento.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al abrir PDF: {ex.Message}");
        }
    }

    private async Task EditarDocumento(JsonElement documento)
    {
        try
        {
            var id = ObtenerIdDocumento(documento, TipoDocumento);
            if (string.IsNullOrEmpty(id))
            {
                await JSRuntime.InvokeVoidAsync("alert", "No se pudo obtener el identificador del documento");
                return;
            }

            // Obtener nombre descriptivo para el mensaje
            var nombreDocumento = TipoDocumento switch
            {
                "investigaciones" => "investigación",
                "articulos" => "artículo",
                "experiencias" => "experiencia laboral",
                "evaluaciones" => "evaluación",
                "cursos" => "curso",
                "tesis" => "tesis",
                _ => "documento"
            };

            // Redirigir a la página de edición correspondiente según el tipo de documento
            string ruta = TipoDocumento switch
            {
                "investigaciones" => $"/editar-investigacion/{id}",
                "articulos" => $"/editar-articulo/{Uri.EscapeDataString(id)}",
                "experiencias" => $"/editar-experiencia/{id}",
                "evaluaciones" => $"/editar-evaluacion/{id}",
                "cursos" => $"/editar-curso/{id}",
                "tesis" => $"/editar-tesis/{id}",
                _ => ""
            };

            if (!string.IsNullOrEmpty(ruta))
            {
                // Mostrar mensaje de confirmación
                var confirmacion = await JSRuntime.InvokeAsync<bool>("confirm",
                $"¿Desea editar esta {nombreDocumento}? Será redirigido al formulario de edición.");

                if (confirmacion)
                {
                    Navigation.NavigateTo(ruta);
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Tipo de documento no soportado para edición");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al editar documento: {ex.Message}");
        }
    }

    private async Task EliminarDocumento(JsonElement documento)
    {
        var confirmacion = await JSRuntime.InvokeAsync<bool>("confirm",
        "¿Está seguro de que desea eliminar este documento? Esta acción no se puede deshacer.");

        if (!confirmacion) return;

        try
        {
            var id = ObtenerIdDocumento(documento, TipoDocumento);
            if (string.IsNullOrEmpty(id))
            {
                await JSRuntime.InvokeVoidAsync("alert", "No se pudo obtener el identificador del documento");
                return;
            }

            var endpoint = TipoDocumento switch
            {
                "investigaciones" => $"api/investigaciones/{id}",
                "articulos" => $"api/articulos/{Uri.EscapeDataString(id)}",
                "tesis" => $"api/TesisDirigidas/{id}",
                "experiencias" => $"api/experienciaslaborales/{id}",
                "cursos" => $"api/cursos/{id}",
                "evaluaciones" => $"api/evaluaciones/{id}",
                _ => ""
            };

            if (string.IsNullOrEmpty(endpoint))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Tipo de documento no válido para eliminación");
                return;
            }

            var response = await Http.DeleteAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Documento eliminado correctamente");
                await CargarDocumentos(); // Recargar la lista
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al eliminar el documento");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al eliminar documento: {ex.Message}");
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            StateHasChanged();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            StateHasChanged();
        }
    }

    private ConfiguracionTabla ObtenerConfiguracion(string tipoDocumento) => tipoDocumento.ToLower() switch
    {
        "investigaciones" => new ConfiguracionTabla
        {
            Titulo = "📊 Investigaciones",
            Columnas = new[] { "Título", "Descripción", "Fecha de Subida", "Archivo" },
            Campos = new[] { "Titulo", "Descripcion", "FechaSubida", "NombreArchivo" }
        },
        "articulos" => new ConfiguracionTabla
        {
            Titulo = "📄 Artículos",
            Columnas = new[] { "Título", "Revista", "Fecha de Subida", "Archivo" },
            Campos = new[] { "Titulo", "Revista", "FechaSubida", "NombreArchivo" }
        },
        "experiencias" => new ConfiguracionTabla
        {
            Titulo = "💼 Experiencia Laboral",
            Columnas = new[] { "Empresa", "Cargo", "Fecha Inicio", "Fecha Fin" },
            Campos = new[] { "Empresa", "Cargo", "FechaInicio", "FechaFin" }
        },
        "evaluaciones" => new ConfiguracionTabla
        {
            Titulo = "📈 Evaluaciones",
            Columnas = new[] { "Tipo", "Período", "Calificación", "Fecha" },
            Campos = new[] { "Tipo", "Periodo", "Calificacion", "Fecha" }
        },
        "cursos" => new ConfiguracionTabla
        {
            Titulo = "🎓 Cursos",
            Columnas = new[] { "Nombre", "Institución", "Fecha de Subida", "Archivo" },
            Campos = new[] { "Nombre", "Institucion", "FechaSubida", "NombreArchivo" }
        },
        "tesis" => new ConfiguracionTabla
        {
            Titulo = "📚 Tesis Dirigidas",
            Columnas = new[] { "Título", "Estudiante", "Nivel", "Estado", "Fecha" },
            Campos = new[] { "Titulo", "Estudiante", "Nivel", "Estado", "Fecha" }
        },
        _ => new ConfiguracionTabla
        {
            Titulo = "📋 Documentos",
            Columnas = new[] { "Nombre", "Tipo", "Fecha" },
            Campos = new[] { "Nombre", "Tipo", "Fecha" }
        }
    };

    private string? ObtenerIdDocumento(JsonElement doc, string tipo)
    {
        if (tipo == "articulos")
        {
            if (doc.TryGetProperty("doi", out var doiElement) && doiElement.ValueKind == JsonValueKind.String)
            {
                return doiElement.GetString();
            }
            return null;
        }

        if (doc.TryGetProperty("id", out var idElement))
        {
            if (idElement.ValueKind == JsonValueKind.Number)
                return idElement.GetInt32().ToString();
            if (idElement.ValueKind == JsonValueKind.String)
                return idElement.GetString();
        }
        return null;
    }

    private string? ObtenerRutaPdf(JsonElement doc, string tipo)
    {
        try
        {
            // Propiedades específicas por tipo de documento
            var propiedadesPorTipo = tipo switch
            {
                "cursos" => new[] { "certificadoRuta", "rutaPdf" },
                "experiencias" => new[] { "certificadoRuta", "rutaPdf" },
                "investigaciones" => new[] { "informeRuta", "rutaPdf" },
                "articulos" => new[] { "archivoRuta" },
                "evaluaciones" => new[] { "informeRuta", "rutaPdf" },
                "tesis" => new[] { "certificacionRuta", "CertificacionRuta", "certificadoRuta", "rutaPdf" },
                _ => new[] { "rutaPdf" }
            };

            // Buscar en las propiedades específicas del tipo
            foreach (var propiedad in propiedadesPorTipo)
            {
                if (doc.TryGetProperty(propiedad, out var rutaElement) &&
                rutaElement.ValueKind == JsonValueKind.String)
                {
                    var ruta = rutaElement.GetString();
                    if (!string.IsNullOrEmpty(ruta))
                    {
                        return ruta;
                    }
                }
            }

            // Búsqueda adicional en propiedades generales
            var propiedadesGenerales = new[] {
"rutaArchivo",
"archivoPdf",
"rutaDocumento",
"pdfPath",
"filePath"
};

            foreach (var propiedad in propiedadesGenerales)
            {
                if (doc.TryGetProperty(propiedad, out var rutaElement) &&
                rutaElement.ValueKind == JsonValueKind.String)
                {
                    var ruta = rutaElement.GetString();
                    if (!string.IsNullOrEmpty(ruta))
                    {
                        return ruta;
                    }
                }
            }

            return null;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private string? ObtenerUrlCloudinary(JsonElement doc, string tipo)
    {
        try
        {
            // Lista de propiedades posibles para buscar la URL de Cloudinary
            var propiedadesPosibles = new[] {
"urlCloudinary", // ✅ Propiedad estándar para todos los tipos
"UrlCloudinary", // Con U mayúscula (usado en TesisDirigidaDto)
"cloudinaryUrl",
"urlDocumento",
"cloudUrl",
"urlArchivo"
};

            // Buscar en todas las propiedades posibles
            foreach (var propiedad in propiedadesPosibles)
            {
                if (doc.TryGetProperty(propiedad, out var urlElement) &&
                urlElement.ValueKind == JsonValueKind.String)
                {
                    var url = urlElement.GetString();
                    if (!string.IsNullOrEmpty(url))
                    {
                        return url;
                    }
                }
            }

            return null;
        }
        catch (Exception)
        {
            return null;
        }
    }

    public class ConfiguracionTabla
    {
        public string Titulo { get; set; } = "";
        public string[] Columnas { get; set; } = Array.Empty<string>();
        public string[] Campos { get; set; } = Array.Empty<string>();
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public T? Data { get; set; }
    }
}

                                                                                                                                                                               