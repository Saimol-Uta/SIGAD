@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http

@code {
    [Parameter] public string Usuario { get; set; } = "";
    [Parameter] public string UrlFotoPerfil { get; set; } = "/images/IconoUser.png";

    private async Task Logout()
    {
        try
        {
            var response = await Http.PostAsync("api/auth/logout", null);
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
                Navigation.NavigateTo("/login", true);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
                Navigation.NavigateTo("/login", true);
            }
        }
        catch
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login", true);
        }
    }
}

<div class="header">
    <div class="branding">
        <img src="/images/logoSIGAD.png" alt="Logo" class="logo" />
        <h1>SIGAD</h1>
    </div>
    <div class="user-profile">
        <span>@Usuario</span>
        <img src="@UrlFotoPerfil" alt="Usuario" />
        <button class="logout-btn" @onclick="Logout">Salir</button>
    </div>
</div>

<style>
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        background-color:white;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 10;
    }

    .branding {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header img.logo {
        height: 80px;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: #444;
    }

        .user-profile img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid #0a1d44;
            object-fit: cover;
        }

    .logout-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        margin-left: 15px;
        transition: background-color 0.3s ease;
    }

        .logout-btn:hover {
            background-color: #c82333;
        }
</style>
